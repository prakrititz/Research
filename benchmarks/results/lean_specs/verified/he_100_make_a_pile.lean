def loop1 (n : Nat) (h_precond : makeAPile_precond n) (i : Nat) (acc : List Nat) (h1i : (acc.length = i ∧ i ≤ n ∧ ∀ k, k < i → acc[k]! = n + 2 * k)) : { ρ : List Nat // makeAPile_postcond n ρ h_precond } :=
  if h1g : (i < n) then
    match (⟨((i + 1, acc ++ [n + 2 * i])), by refine_auto⟩ : { ρ : Nat × (List Nat) // (fun (i : Nat) (acc : List Nat) => acc.length = i ∧ i ≤ n ∧ ∀ k, k < i → acc[k]! = n + 2 * k) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : List Nat) => n - i) (ρ).1 (ρ).2 < (n - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 n h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (n) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by n - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def makeAPile_derived (n : Nat) (h_precond : makeAPile_precond n) : { ρ : List Nat // makeAPile_postcond n ρ h_precond } :=
  (loop1 n h_precond (0) ([]) (by refine_auto))

def makeAPile (n : Nat) (h_precond : makeAPile_precond n) : List Nat := (makeAPile_derived n h_precond).val

theorem makeAPile_spec_satisfied (n : Nat) (h_precond : makeAPile_precond n) :
    makeAPile_postcond n (makeAPile n h_precond) h_precond := (makeAPile_derived n h_precond).property

#print axioms makeAPile_spec_satisfied


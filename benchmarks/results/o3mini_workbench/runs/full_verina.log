key : ℤ
lo hi : ℕ
h_precond : BinarySearch_precond a key
h1i :
  lo ≤ hi ∧
    hi ≤ a.size ∧
      ((a.take lo).all fun x => decide (x < key)) = true ∧ ((a.drop hi).all fun x => decide (x ≥ key)) = true
h1g : lo < hi
⊢ ∃ ρ,
    (ρ.1 ≤ ρ.2 ∧
        ρ.2 ≤ a.size ∧
          ((a.take ρ.1).all fun x => decide (x < key)) = true ∧ ((a.drop ρ.2).all fun x => decide (x ≥ key)) = true) ∧
      ρ.2 - ρ.1 < hi - lo


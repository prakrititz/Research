Task: fixSpaces
Given a string text, replace all spaces in it with underscores, and if a string has more than 2 consecutive spaces, then replace all consecutive spaces with a single '-'.

Definitions (Lean):
def spaceRun : List Char → Nat
  | ' ' :: t => spaceRun t + 1
  | _ => 0
def fixSpec : Nat → List Char → List Char
  | 0, _ => []
  | _ + 1, [] => []
  | fuel + 1, c :: t =>
    if c = ' ' then
      (if spaceRun (c :: t) ≥ 3 then ['-'] else List.replicate (spaceRun (c :: t)) '_') ++ fixSpec fuel ((c :: t).drop (spaceRun (c :: t)))
    else c :: fixSpec fuel t

@[reducible, simp]

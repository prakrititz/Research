def replaceChars_precond(s: str, oldChar: char, newChar: char): prop =
  true_prop

def replaceChars_postcond(s: str, oldChar: char, newChar: char, result: str, h_precond: replaceChars_precond(s, oldChar, newChar)) =
  let cs = list(s); let cs' = list(result); len(result) == len(s) and (forall i: i < len(cs) ==> (cs[i] == oldChar ==> cs'[i] == newChar) and (cs[i] != oldChar ==> cs'[i] == cs[i]))

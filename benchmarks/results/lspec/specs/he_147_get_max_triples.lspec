def seqA(i: nat): nat =
  ((i * i) - i) + 1

def getMaxTriples_precond(n: nat): prop =
  n >= 1

def getMaxTriples_postcond(n: nat, result: nat, h_precond: getMaxTriples_precond(n)) =
  result == sum(range(n).map(lambda i: sum(range(n).map(lambda j: len(range(n).filter(lambda k: (i < j) and ((j < k) and ((((seqA(i + 1) + seqA(j + 1)) + seqA(k + 1)) % 3) == 0))))))))

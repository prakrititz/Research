def hasChordIntersection_precond(N: nat, chords: list[list[nat]]): prop =
  (N >= 2) and ((len(chords) == N) and (chords.all(lambda chord: (len(chord) == 2) and ((chord[0] >= 1) and ((chord[0] <= (2 * N)) and ((chord[1] >= 1) and (chord[1] <= (2 * N)))))) and List.Nodup(chords.flat_map(id))))

def hasChordIntersection_postcond(N: nat, chords: list[list[nat]], result: bool_t, h_precond: hasChordIntersection_precond(N, chords)): prop =
  let sortedChords = chords.map(lambda chord: let a = chord[0]; let b = chord[1]; [b, a] if a > b else [a, b]); let rec hasIntersection((chord1: list[nat]), (chord2: list[nat])): bool_t = let a1 = chord1[0]; let b1 = chord1[1]; let a2 = chord2[0]; let b2 = chord2[1]; (((a1 < a2) && (a2 < b1)) && (b1 < b2)) || (((a2 < a1) && (a1 < b2)) && (b2 < b1)); let rec checkAllPairs((chords: list[list[nat]])): bool_t = match chords with | [] => False | x :: xs => True if xs.any(lambda y: hasIntersection(x, y)) else checkAllPairs(xs); (pairwise(lambda x, y: !hasIntersection(x, y), sortedChords) ==> (not result)) and (sortedChords.any(lambda x: sortedChords.any(lambda y: hasIntersection(x, y))) ==> result)

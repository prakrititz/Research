def isEven(n: int): bool =
  n % 2 == 0

def findEvenNumbers_precond(arr: array[int]): prop =
  true_prop

def findEvenNumbers_postcond(arr: array[int], result: array[int], h_precond: findEvenNumbers_precond(arr)) =
  result.all(lambda x: isEven(x) and x in list(arr) and list(result).count(x) == list(arr).count(x)) and arr.all(lambda x: isEven(x) ==> x in list(result)) and arr.all(lambda x: arr.all(lambda y: isEven(x) ==> isEven(y) ==> list(arr).index(x) <= list(arr).index(y) ==> list(result).index(x) <= list(result).index(y)))

def majorityElement_precond(nums: list[int]): prop =
  (len(nums) > 0) and nums.any(lambda x: nums.count(x) > (len(nums) / 2))

def majorityElement_postcond(nums: list[int], result: int, h_precond: majorityElement_precond(nums)): prop =
  let n = len(nums); (List.count(result, nums) > (n / 2)) and nums.all(lambda x: (x == result) or (List.count(x, nums) <= (n / 2)))

def howManyTimes_precond(string: str, substring: str): prop =
  true_prop

def howManyTimes_postcond(string: str, substring: str, result: nat, h_precond: howManyTimes_precond(`string`, substring)) =
  result == len(range(len(`string`)).filter(lambda i: list(substring).isPrefixOf(list(`string`)[i:])))

def below_zero_precond(operations: list[int]): prop =
  true_prop

def below_zero_postcond(operations: list[int], result: tuple[array[int], bool_t], h_precond: below_zero_precond(operations)) =
  let s = result.1; let result = result.2; (size(s) == (len(operations) + 1)) and ((s[0]? == some(0)) and (range(size(s) - 1).all(lambda i: s[i + 1]? == some(s[i] + operations[i])) and (((result == True) ==> range(len(operations)).any(lambda i: s[i + 1] < 0)) and ((result == False) ==> s.all(lambda _c1: _c1 >= 0)))))

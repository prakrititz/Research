def longestIncreasingSubsequence_precond(numbers: list[int]): prop =
  true_prop

def longestIncreasingSubsequence_postcond(numbers: list[int], result: nat, h_precond: longestIncreasingSubsequence_precond(numbers)): prop =
  let allSubseq = (numbers.foldl(lambda acc, x: acc ++ acc.map(lambda sub: x :: sub)))([[]]).map(List.reverse); let increasingSubseqLens = allSubseq.filter(lambda l: pairwise(lambda _c1, _c2: _c1 < _c2, l)).map(lambda _c1: len(_c1)); increasingSubseqLens.contains(result) and increasingSubseqLens.all(lambda _c1: _c1 <= result)

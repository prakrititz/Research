def longest_precond(strings: list[str]): prop =
  true_prop

def longest_postcond(strings: list[str], result: option[str], h_precond: longest_precond(strings)) =
  match result with | none => strings == [] | some(s) => exists i: i < len(strings) and strings[i] == s and (forall t in strings: len(t) <= len(s)) and (forall j: j < i ==> len(strings[j]) < len(s))

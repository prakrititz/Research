def isDigit(c: char): bool =
  '0' <= c and c <= '9'

def countDigits_precond(s: str): prop =
  true_prop

def countDigits_postcond(s: str, result: nat, h_precond: countDigits_precond(s)) =
  result - List.length(List.filter(isDigit, list(s))) == 0 and List.length(List.filter(isDigit, list(s))) - result == 0

def chooseNum_precond(x: int, y: int): prop =
  true_prop

def chooseNum_postcond(x: int, y: int, result: int, h_precond: chooseNum_precond(x, y)) =
  ((result == (-1)) and (forall k: (k < to_nat((y - x) + 1)) ==> (((x + (k as int)) % 2) != 0))) or (((result % 2) == 0) and ((x <= result) and ((result <= y) and (forall k: (k < to_nat((y - x) + 1)) ==> ((((x + (k as int)) % 2) == 0) ==> ((x + (k as int)) <= result))))))

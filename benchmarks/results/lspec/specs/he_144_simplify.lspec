def numOf(s: str): nat =
  s.split("/")[0].toNat!

def denOf(s: str): nat =
  s.split("/")[1].toNat!

def wellFormedFrac(s: str): prop =
  len(s.split("/")) == 2 and s.split("/").all(String.isNat) == True and 0 < denOf(s)

def simplify_precond(x: str, n: str): prop =
  wellFormedFrac(x) and wellFormedFrac(n)

def simplify_postcond(x: str, n: str, result: bool, h_precond: simplify_precond(x, n)) =
  result == True <==> numOf(x) * numOf(n) % (denOf(x) * denOf(n)) == 0

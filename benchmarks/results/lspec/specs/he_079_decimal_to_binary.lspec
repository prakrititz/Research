def isBinary(m: list[char], v: nat): prop =
  m.all(lambda c: c === '0' || c === '1') == True and m.foldl(lambda acc, c: 2 * acc + (1 if c === '1' else 0), 0) == v and (v == 0 ==> m == ['0']) and (v > 0 ==> m.head! == '1')

def decimalToBinary_precond(decimal: nat): prop =
  true_prop

def decimalToBinary_postcond(decimal: nat, result: str, h_precond: decimalToBinary_precond(decimal)) =
  let l = list(result); len(l) >= 5 and l[:2] == ['d', 'b'] and l[len(l) - 2:] == ['d', 'b'] and isBinary(l[2:][:len(l) - 4], decimal)

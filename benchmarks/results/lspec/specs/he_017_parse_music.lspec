def parseMusic_precond(music_string: str_t): prop =
  (music_string == "") or (forall n in music_string.splitOn(" "): (n == "o") or ((n == "o|") or (n == ".|")))

def parseMusic_postcond(music_string: str_t, result: list[nat], h_precond: parseMusic_precond(music_string)) =
  let notes = [] if music_string == "" else music_string.splitOn(" "); (len(result) == len(notes)) and (forall i: (i < len(notes)) ==> (result[i] == (4 if notes[i] == "o" else 2 if notes[i] == "o|" else 1)))

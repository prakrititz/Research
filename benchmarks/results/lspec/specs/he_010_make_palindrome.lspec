def isPal(l: list[char]): prop =
  l == reversed(l)

def makePalindrome_precond(string: str): prop =
  true_prop

def makePalindrome_postcond(string: str, result: str, h_precond: makePalindrome_precond(`string`)) =
  exists i: i <= len(`string`) and isPal(list(`string`)[i:]) and (forall j: j < i ==> (not isPal(list(`string`)[j:]))) and list(result) == list(`string`) ++ reversed(list(`string`)[:i])

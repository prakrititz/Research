def sumOfDigits_precond(n: nat): prop =
  true_prop

def sumOfDigits_postcond(n: nat, result: nat, h_precond: sumOfDigits_precond(n)) =
  ((result - List.sum(List.map(lambda c: Char.toNat(c) - Char.toNat('0'), String.toList(Nat.repr(n))))) == 0) and ((List.sum(List.map(lambda c: Char.toNat(c) - Char.toNat('0'), String.toList(Nat.repr(n)))) - result) == 0)

def shiftChar(c: char): char =
  Char.ofNat((to_nat(c) - 97 + 5) % 26 + 97)

def decodeShift_precond(s: str): prop =
  list(s).all(lambda c: c.islower) == True

def decodeShift_postcond(s: str, result: str, h_precond: decodeShift_precond(s)) =
  list(result).all(lambda c: c.islower) == True and list(result).map(shiftChar) == list(s)

def longestIncreasingStreak_precond(nums: list[int]): prop =
  true_prop

def longestIncreasingStreak_postcond(nums: list[int], result: nat, h_precond: longestIncreasingStreak_precond(nums)): prop =
  (nums == [] ==> result == 0) and (result > 0 ==> range(len(nums) - result + 1).any(lambda start: start + result <= len(nums) and range(result - 1).all(lambda i: nums[start + i] < nums[start + i + 1]) and (start == 0 or nums[start - 1] >= nums[start]) and (start + result == len(nums) or nums[start + result - 1] >= nums[start + result]))) and range(len(nums) - result).all(lambda start: range(result).any(lambda i: start + i + 1 >= len(nums) or nums[start + i] >= nums[start + i + 1]))

def firstDigit(n: nat): nat =
  to_nat(list(str(n)).head!) - 48

def specialFilter_precond(nums: list[int]): prop =
  true_prop

def specialFilter_postcond(nums: list[int], result: nat, h_precond: specialFilter_precond(nums)) =
  result == len(nums.filter(lambda x: (x > 10) and (((firstDigit(abs_nat(x)) % 2) == 1) and (((abs_nat(x) % 10) % 2) == 1))))

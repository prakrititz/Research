def generateIntegers_precond(a: nat, b: nat): prop =
  true_prop

def generateIntegers_postcond(a: nat, b: nat, result: list[nat], h_precond: generateIntegers_precond(a, b)) =
  (forall i: (i < (len(result) - 1)) ==> (result[i] < result[i + 1])) and ((forall d in result: ((d % 2) == 0) and ((min(a, b) <= d) and ((d <= max(a, b)) and (d < 10)))) and (forall d: (d < 10) ==> (((d % 2) == 0) ==> ((min(a, b) <= d) ==> ((d <= max(a, b)) ==> (d in result))))))

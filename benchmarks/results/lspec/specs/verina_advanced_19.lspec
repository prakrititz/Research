def isUpperAlpha(c: char): bool =
  'A' <= c and c <= 'Z'

def isLowerAlpha(c: char): bool =
  'a' <= c and c <= 'z'

def isAlpha(c: char): bool =
  isUpperAlpha(c) or isLowerAlpha(c)

def toLower(c: char): char =
  Char.ofNat(to_nat(c) + 32) if isUpperAlpha(c) else c

def normalizeChar(c: char): option[char] =
  some(toLower(c)) if isAlpha(c) else none

def normalizeString(s: str): list[char] =
  list(s).foldr(lambda c, acc: match normalizeChar(c) with | some(c') => c' :: acc | none => acc, [])

def isCleanPalindrome_precond(s: str): prop =
  true_prop

def isCleanPalindrome_postcond(s: str, result: bool, h_precond: isCleanPalindrome_precond(s)): prop =
  let norm = normalizeString(s); (result == True ==> norm == reversed(norm)) and (result == False ==> norm != reversed(norm))

def oddDigits(s: str): nat =
  len(list(s).filter(lambda c: (to_nat(c) - 48) % 2 == 1))

def oddMsg(n: nat): str =
  "the number of odd elements in the string i of the input.".replace("i", str(n))

def oddCount_precond(lst: list[str]): prop =
  forall s in lst: list(s).all(Char.isDigit) == True

def oddCount_postcond(lst: list[str], result: list[str], h_precond: oddCount_precond(lst)) =
  len(result) == len(lst) and (forall k: k < len(lst) ==> result[k] == oddMsg(oddDigits(lst[k])))

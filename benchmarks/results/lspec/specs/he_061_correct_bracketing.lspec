def correctBracketing_precond(brackets: str_t): prop =
  true_prop

def correctBracketing_postcond(brackets: str_t, result: bool_t, h_precond: correctBracketing_precond(brackets)) =
  (result == True) <==> ((forall k: (k <= len(brackets)) ==> (list(brackets)[:k].count('(') >= list(brackets)[:k].count(')'))) and (list(brackets).count('(') == list(brackets).count(')')))

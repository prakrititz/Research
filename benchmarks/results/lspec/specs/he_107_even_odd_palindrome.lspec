def isPal(l: list[char]): prop =
  l == reversed(l)

def evenOddPalindrome_precond(n: nat): prop =
  n >= 1

def evenOddPalindrome_postcond(n: nat, result: tuple[nat, nat], h_precond: evenOddPalindrome_precond(n)) =
  (result.1 == len(range(n + 1).filter(lambda i: (1 <= i) and (isPal(list(str(i))) and ((i % 2) == 0))))) and (result.2 == len(range(n + 1).filter(lambda i: (1 <= i) and (isPal(list(str(i))) and ((i % 2) == 1)))))

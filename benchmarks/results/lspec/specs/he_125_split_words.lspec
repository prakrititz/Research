def splitWhite(txt: str): list[str] =
  txt.map(lambda c: ' ' if c === '\n' || c === '\r' || c === '\t' else c).split(" ").filter(lambda w: w !== "")

def splitWords_precond(txt: str): prop =
  true_prop

def splitWords_postcond(txt: str, result: list[str] ⊕ nat, h_precond: splitWords_precond(txt)) =
  let hasWhite = list(txt).any(lambda c: c === ' ' || c === '\n' || c === '\r' || c === '\t'); result == (Sum.inl(splitWhite(txt)) if hasWhite else Sum.inl(txt.split(",")) if list(txt).contains(',') else Sum.inr(len(list(txt).filter(lambda c: c.islower && (to_nat(c) - 97) % 2 == 1))))

def longestIncreasingSubsequence_precond(nums: list[int]): prop =
  true_prop

def longestIncreasingSubsequence_postcond(nums: list[int], result: int, h_precond: longestIncreasingSubsequence_precond(nums)): prop =
  let allSubseq = (nums.foldl(lambda acc, x: acc ++ acc.map(lambda sub: x :: sub)))([[]]).map(List.reverse); let increasingSubseqLens = allSubseq.filter(lambda l: pairwise(lambda _c1, _c2: _c1 < _c2, l)).map(lambda _c1: len(_c1)); increasingSubseqLens.contains(result) and increasingSubseqLens.all(lambda _c1: _c1 <= result)

def tri_precond(n: nat): prop =
  true_prop

def tri_postcond(n: nat, result: list[nat], h_precond: tri_precond(n)) =
  (len(result) == (n + 1)) and ((result[0] == 1) and (((n >= 1) ==> (result[1] == 3)) and (forall i: (i < (n + 1)) ==> ((2 <= i) ==> (result[i] == (1 + (i / 2) if (i % 2) == 0 else (result[i - 1] + result[i - 2]) + (1 + ((i + 1) / 2))))))))

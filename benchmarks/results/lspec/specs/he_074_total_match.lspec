def totalMatch_precond(lst1: list[str_t], lst2: list[str_t]): prop =
  true_prop

def totalMatch_postcond(lst1: list[str_t], lst2: list[str_t], result: list[str_t], h_precond: totalMatch_precond(lst1, lst2)) =
  result == (lst1 if sum(lst1.map(String.length)) <= sum(lst2.map(String.length)) else lst2)

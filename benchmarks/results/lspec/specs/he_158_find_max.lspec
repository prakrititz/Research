def uniqChars(w: str): nat =
  len(list(w).eraseDups)

def findMax_precond(words: list[str]): prop =
  true_prop

def findMax_postcond(words: list[str], result: str, h_precond: findMax_precond(words)) =
  words == [] and result == "" or result in words and (forall w in words: uniqChars(w) <= uniqChars(result)) and (forall w in words: uniqChars(w) == uniqChars(result) ==> (not (w < result)))

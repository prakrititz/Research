def loop1 (n : Nat) (h_precond : startsOneEnds_precond n) (i : Nat) (acc : Nat) (h1i : ((i ≤ (10 ^ n)) ∧ (acc = ((List.range i).filter (fun m => ((10 ^ (n - 1)) ≤ m) ∧ (((m / (10 ^ (n - 1))) = 1) ∨ ((m % 10) = 1)))).length))) : { ρ : Nat // startsOneEnds_postcond n ρ h_precond } :=
  if h1g : (i < (10 ^ n)) then
    match (⟨((i + 1, if ((10 ^ (n - 1)) ≤ i) ∧ (((i / (10 ^ (n - 1))) = 1) ∨ ((i % 10) = 1)) then acc + 1 else acc)), by refine_auto⟩ : { ρ : Nat × Nat // (fun (i : Nat) (acc : Nat) => (i ≤ (10 ^ n)) ∧ (acc = ((List.range i).filter (fun m => ((10 ^ (n - 1)) ≤ m) ∧ (((m / (10 ^ (n - 1))) = 1) ∨ ((m % 10) = 1)))).length)) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : Nat) => (10 ^ n) - i) (ρ).1 (ρ).2 < ((10 ^ n) - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 n h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = ((10 ^ n)) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by (10 ^ n) - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def startsOneEnds_derived (n : Nat) (h_precond : startsOneEnds_precond n) : { ρ : Nat // startsOneEnds_postcond n ρ h_precond } :=
  (loop1 n h_precond (0) (0) (by refine_auto))

def startsOneEnds (n : Nat) (h_precond : startsOneEnds_precond n) : Nat := (startsOneEnds_derived n h_precond).val

theorem startsOneEnds_spec_satisfied (n : Nat) (h_precond : startsOneEnds_precond n) :
    startsOneEnds_postcond n (startsOneEnds n h_precond) h_precond := (startsOneEnds_derived n h_precond).property

#print axioms startsOneEnds_spec_satisfied


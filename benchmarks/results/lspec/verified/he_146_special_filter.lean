def loop1 (nums : List Int) (h_precond : specialFilter_precond nums) (i : Nat) (acc : Nat) (h1i : ((i ≤ nums.length) ∧ (acc = ((nums.take i).filter (fun x => (x > 10) ∧ ((((firstDigit x.natAbs) % 2) = 1) ∧ (((x.natAbs % 10) % 2) = 1)))).length))) : { ρ : Nat // specialFilter_postcond nums ρ h_precond } :=
  if h1g : (i < nums.length) then
    match (⟨((i + 1, if (nums[i]! > 10) ∧ ((((firstDigit nums[i]!.natAbs) % 2) = 1) ∧ (((nums[i]!.natAbs % 10) % 2) = 1)) then acc + 1 else acc)), by refine_auto⟩ : { ρ : Nat × Nat // (fun (i : Nat) (acc : Nat) => (i ≤ nums.length) ∧ (acc = ((nums.take i).filter (fun x => (x > 10) ∧ ((((firstDigit x.natAbs) % 2) = 1) ∧ (((x.natAbs % 10) % 2) = 1)))).length)) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : Nat) => nums.length - i) (ρ).1 (ρ).2 < (nums.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 nums h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (nums.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by nums.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def specialFilter_derived (nums : List Int) (h_precond : specialFilter_precond nums) : { ρ : Nat // specialFilter_postcond nums ρ h_precond } :=
  (loop1 nums h_precond (0) (0) (by refine_auto))

def specialFilter (nums : List Int) (h_precond : specialFilter_precond nums) : Nat := (specialFilter_derived nums h_precond).val

theorem specialFilter_spec_satisfied (nums : List Int) (h_precond : specialFilter_precond nums) :
    specialFilter_postcond nums (specialFilter nums h_precond) h_precond := (specialFilter_derived nums h_precond).property


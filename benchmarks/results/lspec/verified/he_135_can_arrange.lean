def loop1 (arr : List Int) (h_precond : canArrange_precond arr) (i : Nat) (h1i : ((i ≤ (arr.length - 1)) ∧ (∀ m, (m < arr.length) → ((i < m) → (arr[m - 1]! ≤ arr[m]!))))) : { ρ : Int // canArrange_postcond arr ρ h_precond } :=
  if h1g : ((1 ≤ i) ∧ (arr[i - 1]! ≤ arr[i]!)) then
    match (⟨(i - 1), by refine_auto⟩ : { ρ : Nat // (fun (i : Nat) => (i ≤ (arr.length - 1)) ∧ (∀ m, (m < arr.length) → ((i < m) → (arr[m - 1]! ≤ arr[m]!)))) (ρ) ∧ (fun (i : Nat) => i) (ρ) < (i) }) with
    | ⟨i', h1b⟩ => loop1 arr h_precond i' h1b.1
  else ⟨(if i = 0 then (-1 : Int) else (i : Int)), by refine_auto⟩
termination_by i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def canArrange_derived (arr : List Int) (h_precond : canArrange_precond arr) : { ρ : Int // canArrange_postcond arr ρ h_precond } :=
  (loop1 arr h_precond (arr.length - 1) (by refine_auto))

def canArrange (arr : List Int) (h_precond : canArrange_precond arr) : Int := (canArrange_derived arr h_precond).val

theorem canArrange_spec_satisfied (arr : List Int) (h_precond : canArrange_precond arr) :
    canArrange_postcond arr (canArrange arr h_precond) h_precond := (canArrange_derived arr h_precond).property


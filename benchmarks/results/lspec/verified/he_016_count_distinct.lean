set_option maxHeartbeats 1000000 in
def countDistinctCharacters_derived (s : String) (h_precond : countDistinctCharacters_precond s) : { ρ : Nat // countDistinctCharacters_postcond s ρ h_precond } :=
  ⟨(s.toLower.toList.eraseDups.length), by refine_auto⟩

def countDistinctCharacters (s : String) (h_precond : countDistinctCharacters_precond s) : Nat := (countDistinctCharacters_derived s h_precond).val

theorem countDistinctCharacters_spec_satisfied (s : String) (h_precond : countDistinctCharacters_precond s) :
    countDistinctCharacters_postcond s (countDistinctCharacters s h_precond) h_precond := (countDistinctCharacters_derived s h_precond).property

#print axioms countDistinctCharacters_spec_satisfied


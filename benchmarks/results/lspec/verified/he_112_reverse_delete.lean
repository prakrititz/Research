set_option maxHeartbeats 1000000 in
def reverseDelete_derived (s : String) (c : String) (h_precond : reverseDelete_precond s c) : { ρ : String × Bool // reverseDelete_postcond s c ρ h_precond } :=
  (match (⟨(s.toList.filter (fun ch => !(c.toList.contains ch))), by refine_auto⟩ : { t : List Char // t = (s.toList.filter (fun ch => !(c.toList.contains ch))) }) with | ⟨t, h1⟩ => ⟨((String.mk t, decide (t = t.reverse))), by refine_auto⟩)

def reverseDelete (s : String) (c : String) (h_precond : reverseDelete_precond s c) : String × Bool := (reverseDelete_derived s c h_precond).val

theorem reverseDelete_spec_satisfied (s : String) (c : String) (h_precond : reverseDelete_precond s c) :
    reverseDelete_postcond s c (reverseDelete s c h_precond) h_precond := (reverseDelete_derived s c h_precond).property

#print axioms reverseDelete_spec_satisfied


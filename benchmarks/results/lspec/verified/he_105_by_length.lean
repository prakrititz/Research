set_option maxHeartbeats 1000000 in
def byLength_derived (arr : List Int) (h_precond : byLength_precond arr) : { ρ : List String // byLength_postcond arr ρ h_precond } :=
  (match (⟨(arr.filter (fun x => (1 ≤ x) ∧ (x ≤ 9))), by refine_auto⟩ : { ds : List Int // ds = (arr.filter (fun x => (1 ≤ x) ∧ (x ≤ 9))) }) with | ⟨ds, h1⟩ => ⟨((ds.mergeSort (fun a b => a ≥ b)).map numName), by refine_auto⟩)

def byLength (arr : List Int) (h_precond : byLength_precond arr) : List String := (byLength_derived arr h_precond).val

theorem byLength_spec_satisfied (arr : List Int) (h_precond : byLength_precond arr) :
    byLength_postcond arr (byLength arr h_precond) h_precond := (byLength_derived arr h_precond).property

#print axioms byLength_spec_satisfied


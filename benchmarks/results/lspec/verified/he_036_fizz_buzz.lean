def loop1 (n : Nat) (h_precond : fizzBuzz_precond n) (i : Nat) (acc : Nat) (h1i : ((i ≤ n) ∧ (acc = (((List.range i).filter (fun j => ((j % 11) = 0) ∨ ((j % 13) = 0))).map (fun j => (toString j).toList.count '7')).sum))) : { ρ : Nat // fizzBuzz_postcond n ρ h_precond } :=
  if h1g : (i < n) then
    match (⟨((i + 1, if ((i % 11) = 0) ∨ ((i % 13) = 0) then acc + ((toString i).toList.count '7') else acc)), by refine_auto⟩ : { ρ : Nat × Nat // (fun (i : Nat) (acc : Nat) => (i ≤ n) ∧ (acc = (((List.range i).filter (fun j => ((j % 11) = 0) ∨ ((j % 13) = 0))).map (fun j => (toString j).toList.count '7')).sum)) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : Nat) => n - i) (ρ).1 (ρ).2 < (n - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 n h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (n) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by n - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def fizzBuzz_derived (n : Nat) (h_precond : fizzBuzz_precond n) : { ρ : Nat // fizzBuzz_postcond n ρ h_precond } :=
  (loop1 n h_precond (0) (0) (by refine_auto))

def fizzBuzz (n : Nat) (h_precond : fizzBuzz_precond n) : Nat := (fizzBuzz_derived n h_precond).val

theorem fizzBuzz_spec_satisfied (n : Nat) (h_precond : fizzBuzz_precond n) :
    fizzBuzz_postcond n (fizzBuzz n h_precond) h_precond := (fizzBuzz_derived n h_precond).property


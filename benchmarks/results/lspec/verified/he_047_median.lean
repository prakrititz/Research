set_option maxHeartbeats 1000000 in
def median_derived (l : List ℚ) (h_precond : median_precond l) : { ρ : ℚ // median_postcond l ρ h_precond } :=
  (match (⟨(l.mergeSort (fun a b => a ≤ b)), by refine_auto⟩ : { s : List Rat // s = (l.mergeSort (fun a b => a ≤ b)) }) with | ⟨s, h1⟩ => ⟨(if (s.length % 2) = 1 then s[s.length / 2]! else (s[(s.length / 2) - 1]! + s[s.length / 2]!) / 2), by refine_auto⟩)

def median (l : List ℚ) (h_precond : median_precond l) : ℚ := (median_derived l h_precond).val

theorem median_spec_satisfied (l : List ℚ) (h_precond : median_precond l) :
    median_postcond l (median l h_precond) h_precond := (median_derived l h_precond).property

#print axioms median_spec_satisfied


def add_derived (x : Int) (y : Int) (h_precond : add_precond x y) : { ρ : Int // add_postcond x y ρ h_precond } :=
  ⟨(x + y), by refine_auto⟩

def add (x : Int) (y : Int) (h_precond : add_precond x y) : Int := (add_derived x y h_precond).val

theorem add_spec_satisfied (x : Int) (y : Int) (h_precond : add_precond x y) :
    add_postcond x y (add x y h_precond) h_precond := (add_derived x y h_precond).property

#print axioms add_spec_satisfied


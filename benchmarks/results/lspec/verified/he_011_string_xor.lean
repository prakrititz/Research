def loop1 (a : String) (b : String) (h_precond : stringXor_precond a b) (i : Nat) (acc : List Char) (h1i : ((i ≤ a.length) ∧ (acc = ((List.range i).map (fun k => if a.toList[k]! = b.toList[k]! then '0' else '1'))))) : { ρ : String // stringXor_postcond a b ρ h_precond } :=
  if h1g : (i < a.length) then
    match (⟨((i + 1, acc ++ [if a.toList[i]! = b.toList[i]! then '0' else '1'])), by refine_auto⟩ : { ρ : Nat × (List Char) // (fun (i : Nat) (acc : List Char) => (i ≤ a.length) ∧ (acc = ((List.range i).map (fun k => if a.toList[k]! = b.toList[k]! then '0' else '1')))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : List Char) => a.length - i) (ρ).1 (ρ).2 < (a.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 a b h_precond i' acc' h1b.1
  else ⟨(String.mk acc), by first | (have hEq : i = (a.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by a.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def stringXor_derived (a : String) (b : String) (h_precond : stringXor_precond a b) : { ρ : String // stringXor_postcond a b ρ h_precond } :=
  (loop1 a b h_precond (0) ([]) (by refine_auto))

def stringXor (a : String) (b : String) (h_precond : stringXor_precond a b) : String := (stringXor_derived a b h_precond).val

theorem stringXor_spec_satisfied (a : String) (b : String) (h_precond : stringXor_precond a b) :
    stringXor_postcond a b (stringXor a b h_precond) h_precond := (stringXor_derived a b h_precond).property

#print axioms stringXor_spec_satisfied


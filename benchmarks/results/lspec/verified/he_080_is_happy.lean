def loop1 (s : String) (h_precond : isHappy_precond s) (i : Nat) (ok : Bool) (h1i : ((i ≤ (s.length - 2)) ∧ ((ok = true) ↔ (∀ k, (k < i) → ((s.toList[k]! ≠ s.toList[k + 1]!) ∧ ((s.toList[k]! ≠ s.toList[k + 2]!) ∧ (s.toList[k + 1]! ≠ s.toList[k + 2]!))))))) : { ρ : Bool // isHappy_postcond s ρ h_precond } :=
  if h1g : (i < (s.length - 2)) then
    match (⟨((i + 1, ok && (decide ((s.toList[i]! ≠ s.toList[i + 1]!) ∧ ((s.toList[i]! ≠ s.toList[i + 2]!) ∧ (s.toList[i + 1]! ≠ s.toList[i + 2]!)))))), by refine_auto⟩ : { ρ : Nat × Bool // (fun (i : Nat) (ok : Bool) => (i ≤ (s.length - 2)) ∧ ((ok = true) ↔ (∀ k, (k < i) → ((s.toList[k]! ≠ s.toList[k + 1]!) ∧ ((s.toList[k]! ≠ s.toList[k + 2]!) ∧ (s.toList[k + 1]! ≠ s.toList[k + 2]!)))))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (ok : Bool) => (s.length - 2) - i) (ρ).1 (ρ).2 < ((s.length - 2) - i) }) with
    | ⟨(i', ok'), h1b⟩ => loop1 s h_precond i' ok' h1b.1
  else ⟨((decide (s.length ≥ 3)) && ok), by first | (have hEq : i = ((s.length - 2)) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by (s.length - 2) - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def isHappy_derived (s : String) (h_precond : isHappy_precond s) : { ρ : Bool // isHappy_postcond s ρ h_precond } :=
  (loop1 s h_precond (0) (true) (by refine_auto))

def isHappy (s : String) (h_precond : isHappy_precond s) : Bool := (isHappy_derived s h_precond).val

theorem isHappy_spec_satisfied (s : String) (h_precond : isHappy_precond s) :
    isHappy_postcond s (isHappy s h_precond) h_precond := (isHappy_derived s h_precond).property

#print axioms isHappy_spec_satisfied


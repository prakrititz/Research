def getOddCollatz_derived (n : Nat) (h_precond : getOddCollatz_precond n) : { ρ : List Nat // getOddCollatz_postcond n ρ h_precond } :=
  ⟨(((collatzSeq 5000 n).filter (fun x => (x % 2) = 1)).mergeSort (fun a b => decide (a ≤ b))), by refine_auto⟩

def getOddCollatz (n : Nat) (h_precond : getOddCollatz_precond n) : List Nat := (getOddCollatz_derived n h_precond).val

theorem getOddCollatz_spec_satisfied (n : Nat) (h_precond : getOddCollatz_precond n) :
    getOddCollatz_postcond n (getOddCollatz n h_precond) h_precond := (getOddCollatz_derived n h_precond).property

#print axioms getOddCollatz_spec_satisfied


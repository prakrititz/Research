def loop3 (a : Array (Array Int)) (key : Int) (i : Nat) (mm : Int) (nn : Int) (h_precond : SlopeSearch_precond a key) (h1i : ((i ≤ a.size) ∧ (((0 ≤ mm) ∧ ((mm < a.size) ∧ ((0 ≤ nn) ∧ ((nn < a[0]!.size) ∧ ((get2d a mm nn) = key))))) ∨ ((mm = (-1)) ∧ ((nn = (-1)) ∧ (∀ k, (k < i) → (∀ j, (j < a[k]!.size) → ((a[k]!)[j]! ≠ key)))))))) (h1g : ((i < a.size) ∧ (mm = (-1)))) (j : Nat) (h3i : ((j ≤ a[i]!.size) ∧ (∀ j', (j' < j) → ((a[i]!)[j']! ≠ key)))) : { ρ : Int // (fun (jr : Int) => ((jr = (-1)) ∧ (∀ j, (j < a[i]!.size) → ((a[i]!)[j]! ≠ key))) ∨ ((0 ≤ jr) ∧ ((jr < a[0]!.size) ∧ ((a[i]!)[jr.toNat]! = key)))) ρ } :=
  if h3g : ((j < a[i]!.size) ∧ ((a[i]!)[j]! ≠ key)) then
    match (⟨(j + 1), by refine_auto⟩ : { ρ : Nat // (fun (j : Nat) => (j ≤ a[i]!.size) ∧ (∀ j', (j' < j) → ((a[i]!)[j']! ≠ key))) (ρ) ∧ (fun (j : Nat) => a[i]!.size - j) (ρ) < (a[i]!.size - j) }) with
    | ⟨j', h3b⟩ => loop3 a key i mm nn h_precond h1i h1g j' h3b.1
  else ⟨(if j < a[i]!.size then (j : Int) else -1), by refine_auto⟩
termination_by a[i]!.size - j
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h3b.2 | omega)

def loop1 (a : Array (Array Int)) (key : Int) (h_precond : SlopeSearch_precond a key) (i : Nat) (mm : Int) (nn : Int) (h1i : ((i ≤ a.size) ∧ (((0 ≤ mm) ∧ ((mm < a.size) ∧ ((0 ≤ nn) ∧ ((nn < a[0]!.size) ∧ ((get2d a mm nn) = key))))) ∨ ((mm = (-1)) ∧ ((nn = (-1)) ∧ (∀ k, (k < i) → (∀ j, (j < a[k]!.size) → ((a[k]!)[j]! ≠ key)))))))) : { ρ : (Int × Int) // SlopeSearch_postcond a key ρ h_precond } :=
  if h1g : ((i < a.size) ∧ (mm = (-1))) then
    match ((match ((loop3 a key i mm nn h_precond h1i h1g (0) (by refine_auto)) : { jr : Int // ((jr = (-1)) ∧ (∀ j, (j < a[i]!.size) → ((a[i]!)[j]! ≠ key))) ∨ ((0 ≤ jr) ∧ ((jr < a[0]!.size) ∧ ((a[i]!)[jr.toNat]! = key))) }) with | ⟨jr, h2⟩ => ⟨((i + 1, if jr = (-1) then -1 else (i : Int), jr)), by refine_auto⟩) : { ρ : Nat × Int × Int // (fun (i : Nat) (mm : Int) (nn : Int) => (i ≤ a.size) ∧ (((0 ≤ mm) ∧ ((mm < a.size) ∧ ((0 ≤ nn) ∧ ((nn < a[0]!.size) ∧ ((get2d a mm nn) = key))))) ∨ ((mm = (-1)) ∧ ((nn = (-1)) ∧ (∀ k, (k < i) → (∀ j, (j < a[k]!.size) → ((a[k]!)[j]! ≠ key))))))) (ρ).1 (ρ).2.1 (ρ).2.2 ∧ (fun (i : Nat) (mm : Int) (nn : Int) => a.size - i) (ρ).1 (ρ).2.1 (ρ).2.2 < (a.size - i) }) with
    | ⟨(i', mm', nn'), h1b⟩ => loop1 a key h_precond i' mm' nn' h1b.1
  else ⟨((mm, nn)), by refine_auto⟩
termination_by a.size - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def SlopeSearch_derived (a : Array (Array Int)) (key : Int) (h_precond : SlopeSearch_precond a key) : { ρ : (Int × Int) // SlopeSearch_postcond a key ρ h_precond } :=
  (loop1 a key h_precond (0) (-1) (-1) (by refine_auto))

def SlopeSearch (a : Array (Array Int)) (key : Int) (h_precond : SlopeSearch_precond a key) : (Int × Int) := (SlopeSearch_derived a key h_precond).val

theorem SlopeSearch_spec_satisfied (a : Array (Array Int)) (key : Int) (h_precond : SlopeSearch_precond a key) :
    SlopeSearch_postcond a key (SlopeSearch a key h_precond) h_precond := (SlopeSearch_derived a key h_precond).property


set_option maxHeartbeats 1000000 in
def chooseNum_derived (x : Int) (y : Int) (h_precond : chooseNum_precond x y) : { ρ : Int // chooseNum_postcond x y ρ h_precond } :=
  (if h1 : (y < x) then ⟨(-1), by refine_auto⟩ else (if h3 : ((y % 2) = 0) then ⟨(y), by refine_auto⟩ else (if h5 : (x ≤ (y - 1)) then ⟨(y - 1), by refine_auto⟩ else ⟨(-1), by refine_auto⟩)))

def chooseNum (x : Int) (y : Int) (h_precond : chooseNum_precond x y) : Int := (chooseNum_derived x y h_precond).val

theorem chooseNum_spec_satisfied (x : Int) (y : Int) (h_precond : chooseNum_precond x y) :
    chooseNum_postcond x y (chooseNum x y h_precond) h_precond := (chooseNum_derived x y h_precond).property

#print axioms chooseNum_spec_satisfied


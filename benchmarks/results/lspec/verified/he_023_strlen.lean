set_option maxHeartbeats 1000000 in
def strlen_derived (s : String) (h_precond : strlen_precond s) : { ρ : Nat // strlen_postcond s ρ h_precond } :=
  ⟨(s.length), by refine_auto⟩

def strlen (s : String) (h_precond : strlen_precond s) : Nat := (strlen_derived s h_precond).val

theorem strlen_spec_satisfied (s : String) (h_precond : strlen_precond s) :
    strlen_postcond s (strlen s h_precond) h_precond := (strlen_derived s h_precond).property

#print axioms strlen_spec_satisfied


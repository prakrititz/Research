def loop1 (s : String) (h_precond : digitSum_precond s) (i : Nat) (acc : Nat) (h1i : ((i ≤ s.length) ∧ (acc = (((s.toList.take i).filter Char.isUpper).map Char.toNat).sum))) : { ρ : Nat // digitSum_postcond s ρ h_precond } :=
  if h1g : (i < s.length) then
    match (⟨((i + 1, if s.toList[i]!.isUpper then acc + s.toList[i]!.toNat else acc)), by refine_auto⟩ : { ρ : Nat × Nat // (fun (i : Nat) (acc : Nat) => (i ≤ s.length) ∧ (acc = (((s.toList.take i).filter Char.isUpper).map Char.toNat).sum)) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : Nat) => s.length - i) (ρ).1 (ρ).2 < (s.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 s h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (s.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by s.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def digitSum_derived (s : String) (h_precond : digitSum_precond s) : { ρ : Nat // digitSum_postcond s ρ h_precond } :=
  (loop1 s h_precond (0) (0) (by refine_auto))

def digitSum (s : String) (h_precond : digitSum_precond s) : Nat := (digitSum_derived s h_precond).val

theorem digitSum_spec_satisfied (s : String) (h_precond : digitSum_precond s) :
    digitSum_postcond s (digitSum s h_precond) h_precond := (digitSum_derived s h_precond).property


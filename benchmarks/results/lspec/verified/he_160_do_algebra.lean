def doAlgebra_derived (operator : List String) (operand : List Int) (h_precond : doAlgebra_precond operator operand) : { ρ : Int // doAlgebra_postcond operator operand ρ h_precond } :=
  ⟨(evalOps operator.length operand operator), by refine_auto⟩

def doAlgebra (operator : List String) (operand : List Int) (h_precond : doAlgebra_precond operator operand) : Int := (doAlgebra_derived operator operand h_precond).val

theorem doAlgebra_spec_satisfied (operator : List String) (operand : List Int) (h_precond : doAlgebra_precond operator operand) :
    doAlgebra_postcond operator operand (doAlgebra operator operand h_precond) h_precond := (doAlgebra_derived operator operand h_precond).property


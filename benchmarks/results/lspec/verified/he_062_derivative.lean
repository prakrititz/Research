def loop1 (xs : List Int) (h_precond : derivative_precond xs) (k : Nat) (acc : List Int) (h1i : ((k ≤ (xs.length - 1)) ∧ ((acc.length = k) ∧ (∀ m, (m < k) → (acc[m]! = (xs[m + 1]! * (((m : Int)) + 1))))))) : { ρ : List Int // derivative_postcond xs ρ h_precond } :=
  if h1g : (k < (xs.length - 1)) then
    match (⟨((k + 1, acc ++ [xs[k + 1]! * (((k : Int)) + 1)])), by refine_auto⟩ : { ρ : Nat × (List Int) // (fun (k : Nat) (acc : List Int) => (k ≤ (xs.length - 1)) ∧ ((acc.length = k) ∧ (∀ m, (m < k) → (acc[m]! = (xs[m + 1]! * (((m : Int)) + 1)))))) (ρ).1 (ρ).2 ∧ (fun (k : Nat) (acc : List Int) => (xs.length - 1) - k) (ρ).1 (ρ).2 < ((xs.length - 1) - k) }) with
    | ⟨(k', acc'), h1b⟩ => loop1 xs h_precond k' acc' h1b.1
  else ⟨(acc), by first | (have hEq : k = ((xs.length - 1)) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by (xs.length - 1) - k
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def derivative_derived (xs : List Int) (h_precond : derivative_precond xs) : { ρ : List Int // derivative_postcond xs ρ h_precond } :=
  (loop1 xs h_precond (0) ([]) (by refine_auto))

def derivative (xs : List Int) (h_precond : derivative_precond xs) : List Int := (derivative_derived xs h_precond).val

theorem derivative_spec_satisfied (xs : List Int) (h_precond : derivative_precond xs) :
    derivative_postcond xs (derivative xs h_precond) h_precond := (derivative_derived xs h_precond).property


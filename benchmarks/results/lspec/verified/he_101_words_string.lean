set_option maxHeartbeats 1000000 in
def wordsString_derived (s : String) (h_precond : wordsString_precond s) : { ρ : List String // wordsString_postcond s ρ h_precond } :=
  ⟨(((s.map (fun c => if c == ',' then ' ' else c)).splitOn " ").filter (fun w => w != "")), by refine_auto⟩

def wordsString (s : String) (h_precond : wordsString_precond s) : List String := (wordsString_derived s h_precond).val

theorem wordsString_spec_satisfied (s : String) (h_precond : wordsString_precond s) :
    wordsString_postcond s (wordsString s h_precond) h_precond := (wordsString_derived s h_precond).property

#print axioms wordsString_spec_satisfied


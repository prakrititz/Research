def loop1 (a : String) (b : String) (h_precond : cycpatternCheck_precond a b) (i : Nat) (found : Bool) (h1i : ((i ≤ b.length) ∧ ((found = true) ↔ (∃ k, (k < i) ∧ (((b.toList.drop k) ++ (b.toList.take k)) <:+: a.toList))))) : { ρ : Bool // cycpatternCheck_postcond a b ρ h_precond } :=
  if h1g : (i < b.length) then
    match (⟨((i + 1, found || (decide (((b.toList.drop i) ++ (b.toList.take i)) <:+: a.toList)))), by refine_auto⟩ : { ρ : Nat × Bool // (fun (i : Nat) (found : Bool) => (i ≤ b.length) ∧ ((found = true) ↔ (∃ k, (k < i) ∧ (((b.toList.drop k) ++ (b.toList.take k)) <:+: a.toList)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (found : Bool) => b.length - i) (ρ).1 (ρ).2 < (b.length - i) }) with
    | ⟨(i', found'), h1b⟩ => loop1 a b h_precond i' found' h1b.1
  else ⟨((decide (b.length = 0)) || found), by first | (have hEq : i = (b.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by b.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def cycpatternCheck_derived (a : String) (b : String) (h_precond : cycpatternCheck_precond a b) : { ρ : Bool // cycpatternCheck_postcond a b ρ h_precond } :=
  (loop1 a b h_precond (0) (false) (by refine_auto))

def cycpatternCheck (a : String) (b : String) (h_precond : cycpatternCheck_precond a b) : Bool := (cycpatternCheck_derived a b h_precond).val

theorem cycpatternCheck_spec_satisfied (a : String) (b : String) (h_precond : cycpatternCheck_precond a b) :
    cycpatternCheck_postcond a b (cycpatternCheck a b h_precond) h_precond := (cycpatternCheck_derived a b h_precond).property


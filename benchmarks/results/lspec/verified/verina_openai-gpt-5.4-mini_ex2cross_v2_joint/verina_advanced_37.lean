def majorityElement_derived (nums : List Int) (h_precond : majorityElement_precond nums) : { ρ : Int // majorityElement_postcond nums ρ h_precond } :=
  (match ((match ((match ((if h6 : (nums.any (fun x => (nums.count x) > (nums.length / 2))) then ⟨((nums.find? (fun x => (nums.count x) > (nums.length / 2))).getD 0), by refine_auto⟩ else ⟨(0), by refine_auto⟩) : { m : Int // (nums.count m) > (nums.length / 2) }) with | ⟨m, h4⟩ => ⟨(m), by refine_auto⟩) : { m : Int // (nums.count m) > (nums.length / 2) }) with | ⟨m, h2⟩ => ⟨(m), by refine_auto⟩) : { m : Int // (nums.count m) > (nums.length / 2) }) with | ⟨m, h1⟩ => ⟨(m), by refine_auto⟩)

def majorityElement (nums : List Int) (h_precond : majorityElement_precond nums) : Int := (majorityElement_derived nums h_precond).val

theorem majorityElement_spec_satisfied (nums : List Int) (h_precond : majorityElement_precond nums) :
    majorityElement_postcond nums (majorityElement nums h_precond) h_precond := (majorityElement_derived nums h_precond).property


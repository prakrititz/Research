@[reducible, simp]
def maxOfList_precond (lst : List Nat) : Prop :=
  lst.length > 0

@[reducible, simp]
def maxOfList_postcond (lst : List Nat) (result: Nat) (h_precond : maxOfList_precond (lst)) : Prop :=
  result ∈ lst ∧ ∀ x ∈ lst, x ≤ result




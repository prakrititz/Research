def loop1 (arr : List Int) (h_precond : moveOneBall_precond arr) (i : Nat) (f : Bool) (h1i : ((i ≤ (arr.length + 1)) ∧ ((f = true) ↔ (∃ k, (k < i) ∧ (((arr.drop k) ++ (arr.take k)) = (arr.mergeSort (fun a b => a ≤ b))))))) : { ρ : Bool // moveOneBall_postcond arr ρ h_precond } :=
  if h1g : (i < (arr.length + 1)) then
    match (⟨((i + 1, f || (decide (((arr.drop i) ++ (arr.take i)) = (arr.mergeSort (fun a b => a ≤ b)))))), by refine_auto⟩ : { ρ : Nat × Bool // (fun (i : Nat) (f : Bool) => (i ≤ (arr.length + 1)) ∧ ((f = true) ↔ (∃ k, (k < i) ∧ (((arr.drop k) ++ (arr.take k)) = (arr.mergeSort (fun a b => a ≤ b)))))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (f : Bool) => (arr.length + 1) - i) (ρ).1 (ρ).2 < ((arr.length + 1) - i) }) with
    | ⟨(i', f'), h1b⟩ => loop1 arr h_precond i' f' h1b.1
  else ⟨(f), by first | (have hEq : i = ((arr.length + 1)) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by (arr.length + 1) - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def moveOneBall_derived (arr : List Int) (h_precond : moveOneBall_precond arr) : { ρ : Bool // moveOneBall_postcond arr ρ h_precond } :=
  (loop1 arr h_precond (0) (false) (by refine_auto))

def moveOneBall (arr : List Int) (h_precond : moveOneBall_precond arr) : Bool := (moveOneBall_derived arr h_precond).val

theorem moveOneBall_spec_satisfied (arr : List Int) (h_precond : moveOneBall_precond arr) :
    moveOneBall_postcond arr (moveOneBall arr h_precond) h_precond := (moveOneBall_derived arr h_precond).property

#print axioms moveOneBall_spec_satisfied


def loop1 (lst : List ℚ) (h_precond : sumSquaresCeil_precond lst) (i : Nat) (acc : Int) (h1i : ((i ≤ lst.length) ∧ (acc = ((lst.take i).map (fun x => ((⌈x⌉ : Int)) * ((⌈x⌉ : Int)))).sum))) : { ρ : Int // sumSquaresCeil_postcond lst ρ h_precond } :=
  if h1g : (i < lst.length) then
    match (⟨((i + 1, acc + (((⌈lst[i]!⌉ : Int)) * ((⌈lst[i]!⌉ : Int))))), by refine_auto⟩ : { ρ : Nat × Int // (fun (i : Nat) (acc : Int) => (i ≤ lst.length) ∧ (acc = ((lst.take i).map (fun x => ((⌈x⌉ : Int)) * ((⌈x⌉ : Int)))).sum)) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : Int) => lst.length - i) (ρ).1 (ρ).2 < (lst.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 lst h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (lst.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by lst.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)



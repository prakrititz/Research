def sumSquaresCeil_derived (lst : List ℚ) (h_precond : sumSquaresCeil_precond lst) : { ρ : Int // sumSquaresCeil_postcond lst ρ h_precond } :=
  (loop1 lst h_precond (0) (0) (by refine_auto))

def sumSquaresCeil (lst : List ℚ) (h_precond : sumSquaresCeil_precond lst) : Int := (sumSquaresCeil_derived lst h_precond).val

theorem sumSquaresCeil_spec_satisfied (lst : List ℚ) (h_precond : sumSquaresCeil_precond lst) :

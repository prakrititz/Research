@[reducible]
def isPowerOfTwo_precond (n : Int) : Prop :=
  True

def pow (base : Int) (exp : Nat) : Int :=
  match exp with
  | 0 => 1
  | n+1 => base * pow base n

@[reducible]
def isPowerOfTwo_postcond (n : Int) (result: Bool) (h_precond : isPowerOfTwo_precond (n)) : Prop :=
  if result then ∃ (x : Nat), (pow 2 x = n) ∧ (n > 0)
  else ¬ (∃ (x : Nat), (pow 2 x = n) ∧ (n > 0))

set_option maxHeartbeats 400000 in
theorem auto_libeq_pow_0 : ∀ (base : Int) (exp : Nat), _root_.pow base exp = base ^ exp := by
  intro base exp; induction exp with
  | zero => simp [_root_.pow]
  | succ n ih => simp only [_root_.pow, ih, pow_succ]; ring


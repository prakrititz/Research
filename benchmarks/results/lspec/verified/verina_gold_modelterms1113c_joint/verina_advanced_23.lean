def isPowerOfTwo_derived (n : Int) (h_precond : isPowerOfTwo_precond n) : { ρ : Bool // isPowerOfTwo_postcond n ρ h_precond } :=
  ⟨((List.range (n + 1).toNat).foldl (fun acc x => acc ∨ (((pow 2 x) = n) ∧ (n > 0))) false), by refine_auto⟩

def isPowerOfTwo (n : Int) (h_precond : isPowerOfTwo_precond n) : Bool := (isPowerOfTwo_derived n h_precond).val

theorem isPowerOfTwo_spec_satisfied (n : Int) (h_precond : isPowerOfTwo_precond n) :
    isPowerOfTwo_postcond n (isPowerOfTwo n h_precond) h_precond := (isPowerOfTwo_derived n h_precond).property

#print axioms isPowerOfTwo_spec_satisfied

set_option maxHeartbeats 2000000 in
#eval (((isPowerOfTwo (1) (by first | native_decide | trivial | (norm_num [isPowerOfTwo_precond]; done) | (simp [isPowerOfTwo_precond]; done) | decide | omega | (unfold isPowerOfTwo_precond; pre_wit_search)))) == (true))

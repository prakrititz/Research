set_option maxHeartbeats 1000000 in
def selectWords_derived (s : String) (n : Nat) (h_precond : selectWords_precond s n) : { ρ : List String // selectWords_postcond s n ρ h_precond } :=
  ⟨((s.splitOn " ").filter (fun w => (w != "") && ((w.toList.filter (fun ch => !(['a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'].contains ch))).length == n))), by refine_auto⟩

def selectWords (s : String) (n : Nat) (h_precond : selectWords_precond s n) : List String := (selectWords_derived s n h_precond).val

theorem selectWords_spec_satisfied (s : String) (n : Nat) (h_precond : selectWords_precond s n) :
    selectWords_postcond s n (selectWords s n h_precond) h_precond := (selectWords_derived s n h_precond).property

#print axioms selectWords_spec_satisfied


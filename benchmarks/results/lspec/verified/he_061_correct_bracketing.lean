def loop1 (brackets : String) (h_precond : correctBracketing_precond brackets) (i : Nat) (d : Int) (ok : Bool) (h1i : ((i ≤ brackets.length) ∧ ((d = ((((brackets.toList.take i).count '(' : Int)) - (((brackets.toList.take i).count ')' : Int)))) ∧ ((ok = true) ↔ (∀ k, (k ≤ i) → (((brackets.toList.take k).count '(') ≥ ((brackets.toList.take k).count ')'))))))) : { ρ : Bool // correctBracketing_postcond brackets ρ h_precond } :=
  if h1g : (i < brackets.length) then
    match (⟨((i + 1, d + (if brackets.toList[i]! = '(' then 1 else if brackets.toList[i]! = ')' then -1 else 0), ok && (decide ((d + (if brackets.toList[i]! = '(' then 1 else if brackets.toList[i]! = ')' then -1 else 0)) ≥ 0)))), by refine_auto⟩ : { ρ : Nat × Int × Bool // (fun (i : Nat) (d : Int) (ok : Bool) => (i ≤ brackets.length) ∧ ((d = ((((brackets.toList.take i).count '(' : Int)) - (((brackets.toList.take i).count ')' : Int)))) ∧ ((ok = true) ↔ (∀ k, (k ≤ i) → (((brackets.toList.take k).count '(') ≥ ((brackets.toList.take k).count ')')))))) (ρ).1 (ρ).2.1 (ρ).2.2 ∧ (fun (i : Nat) (d : Int) (ok : Bool) => brackets.length - i) (ρ).1 (ρ).2.1 (ρ).2.2 < (brackets.length - i) }) with
    | ⟨(i', d', ok'), h1b⟩ => loop1 brackets h_precond i' d' ok' h1b.1
  else ⟨(ok && (decide (d = 0))), by first | (have hEq : i = (brackets.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by brackets.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def correctBracketing_derived (brackets : String) (h_precond : correctBracketing_precond brackets) : { ρ : Bool // correctBracketing_postcond brackets ρ h_precond } :=
  (loop1 brackets h_precond (0) (0) (true) (by refine_auto))

def correctBracketing (brackets : String) (h_precond : correctBracketing_precond brackets) : Bool := (correctBracketing_derived brackets h_precond).val

theorem correctBracketing_spec_satisfied (brackets : String) (h_precond : correctBracketing_precond brackets) :
    correctBracketing_postcond brackets (correctBracketing brackets h_precond) h_precond := (correctBracketing_derived brackets h_precond).property


def loop1 (numbers : List Int) (h_precond : sumProduct_precond numbers) (i : Nat) (s : Int) (p : Int) (h1i : ((i ≤ numbers.length) ∧ ((s = (numbers.take i).sum) ∧ (p = (numbers.take i).prod)))) : { ρ : Int × Int // sumProduct_postcond numbers ρ h_precond } :=
  if h1g : (i < numbers.length) then
    match (⟨((i + 1, s + numbers[i]!, p * numbers[i]!)), by refine_auto⟩ : { ρ : Nat × Int × Int // (fun (i : Nat) (s : Int) (p : Int) => (i ≤ numbers.length) ∧ ((s = (numbers.take i).sum) ∧ (p = (numbers.take i).prod))) (ρ).1 (ρ).2.1 (ρ).2.2 ∧ (fun (i : Nat) (s : Int) (p : Int) => numbers.length - i) (ρ).1 (ρ).2.1 (ρ).2.2 < (numbers.length - i) }) with
    | ⟨(i', s', p'), h1b⟩ => loop1 numbers h_precond i' s' p' h1b.1
  else ⟨((s, p)), by first | (have hEq : i = (numbers.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by numbers.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def sumProduct_derived (numbers : List Int) (h_precond : sumProduct_precond numbers) : { ρ : Int × Int // sumProduct_postcond numbers ρ h_precond } :=
  (loop1 numbers h_precond (0) (0) (1) (by refine_auto))

def sumProduct (numbers : List Int) (h_precond : sumProduct_precond numbers) : Int × Int := (sumProduct_derived numbers h_precond).val

theorem sumProduct_spec_satisfied (numbers : List Int) (h_precond : sumProduct_precond numbers) :
    sumProduct_postcond numbers (sumProduct numbers h_precond) h_precond := (sumProduct_derived numbers h_precond).property


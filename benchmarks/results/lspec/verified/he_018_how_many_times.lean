def loop1 (string : String) (substring : String) (h_precond : howManyTimes_precond string substring) (i : Nat) (acc : Nat) (h1i : ((i ≤ string.length) ∧ (acc = ((List.range i).filter (fun j => substring.toList.isPrefixOf (string.toList.drop j))).length))) : { ρ : Nat // howManyTimes_postcond string substring ρ h_precond } :=
  if h1g : (i < string.length) then
    match (⟨((i + 1, if substring.toList.isPrefixOf (string.toList.drop i) then acc + 1 else acc)), by refine_auto⟩ : { ρ : Nat × Nat // (fun (i : Nat) (acc : Nat) => (i ≤ string.length) ∧ (acc = ((List.range i).filter (fun j => substring.toList.isPrefixOf (string.toList.drop j))).length)) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : Nat) => string.length - i) (ρ).1 (ρ).2 < (string.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 string substring h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (string.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by string.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def howManyTimes_derived (string : String) (substring : String) (h_precond : howManyTimes_precond string substring) : { ρ : Nat // howManyTimes_postcond string substring ρ h_precond } :=
  (loop1 string substring h_precond (0) (0) (by refine_auto))

def howManyTimes (string : String) (substring : String) (h_precond : howManyTimes_precond string substring) : Nat := (howManyTimes_derived string substring h_precond).val

theorem howManyTimes_spec_satisfied (string : String) (substring : String) (h_precond : howManyTimes_precond string substring) :
    howManyTimes_postcond string substring (howManyTimes string substring h_precond) h_precond := (howManyTimes_derived string substring h_precond).property


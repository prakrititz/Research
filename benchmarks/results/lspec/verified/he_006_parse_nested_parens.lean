def loop3 (paren_string : String) (groups : List String) (h_precond : parseNestedParens_precond paren_string) (h1 : (groups = ((paren_string.splitOn " ").filter (fun g => g != "")))) (i : Nat) (acc : List Nat) (h3i : ((i ≤ groups.length) ∧ (acc = ((groups.take i).map (fun g => maxDepth g.toList))))) : { ρ : List Nat // parseNestedParens_postcond paren_string ρ h_precond } :=
  if h3g : (i < groups.length) then
    match (⟨((i + 1, acc ++ [maxDepth groups[i]!.toList])), by refine_auto⟩ : { ρ : Nat × (List Nat) // (fun (i : Nat) (acc : List Nat) => (i ≤ groups.length) ∧ (acc = ((groups.take i).map (fun g => maxDepth g.toList)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : List Nat) => groups.length - i) (ρ).1 (ρ).2 < (groups.length - i) }) with
    | ⟨(i', acc'), h3b⟩ => loop3 paren_string groups h_precond h1 i' acc' h3b.1
  else ⟨(acc), by first | (have hEq : i = (groups.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by groups.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h3b.2 | omega)


set_option maxHeartbeats 1000000 in
def parseNestedParens_derived (paren_string : String) (h_precond : parseNestedParens_precond paren_string) : { ρ : List Nat // parseNestedParens_postcond paren_string ρ h_precond } :=
  (match (⟨((paren_string.splitOn " ").filter (fun g => g != "")), by refine_auto⟩ : { groups : List String // groups = ((paren_string.splitOn " ").filter (fun g => g != "")) }) with | ⟨groups, h1⟩ => (loop3 paren_string groups h_precond h1 (0) ([]) (by refine_auto)))

def parseNestedParens (paren_string : String) (h_precond : parseNestedParens_precond paren_string) : List Nat := (parseNestedParens_derived paren_string h_precond).val

theorem parseNestedParens_spec_satisfied (paren_string : String) (h_precond : parseNestedParens_precond paren_string) :
    parseNestedParens_postcond paren_string (parseNestedParens paren_string h_precond) h_precond := (parseNestedParens_derived paren_string h_precond).property


def tri_derived (n : Nat) (h_precond : tri_precond n) : { ρ : List Nat // tri_postcond n ρ h_precond } :=
  (loop1 n h_precond (0) ([]) (by refine_auto))

def tri (n : Nat) (h_precond : tri_precond n) : List Nat := (tri_derived n h_precond).val

theorem tri_spec_satisfied (n : Nat) (h_precond : tri_precond n) :
    tri_postcond n (tri n h_precond) h_precond := (tri_derived n h_precond).property

#print axioms tri_spec_satisfied


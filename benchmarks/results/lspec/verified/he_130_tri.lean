def loop1 (n : Nat) (h_precond : tri_precond n) (i : Nat) (acc : List Nat) (h1i : ((i ≤ (n + 1)) ∧ ((acc.length = i) ∧ (((0 < i) → (acc[0]! = 1)) ∧ (((1 < i) → (acc[1]! = 3)) ∧ (∀ k, (k < i) → ((2 ≤ k) → (acc[k]! = (if (k % 2) = 0 then 1 + (k / 2) else (acc[k - 1]! + acc[k - 2]!) + (1 + ((k + 1) / 2))))))))))) : { ρ : List Nat // tri_postcond n ρ h_precond } :=
  if h1g : (i < (n + 1)) then
    match (⟨((i + 1, acc ++ [if i = 0 then 1 else if i = 1 then 3 else if (i % 2) = 0 then 1 + (i / 2) else (acc[i - 1]! + acc[i - 2]!) + (1 + ((i + 1) / 2))])), by refine_auto⟩ : { ρ : Nat × (List Nat) // (fun (i : Nat) (acc : List Nat) => (i ≤ (n + 1)) ∧ ((acc.length = i) ∧ (((0 < i) → (acc[0]! = 1)) ∧ (((1 < i) → (acc[1]! = 3)) ∧ (∀ k, (k < i) → ((2 ≤ k) → (acc[k]! = (if (k % 2) = 0 then 1 + (k / 2) else (acc[k - 1]! + acc[k - 2]!) + (1 + ((k + 1) / 2)))))))))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : List Nat) => (n + 1) - i) (ρ).1 (ρ).2 < ((n + 1) - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 n h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = ((n + 1)) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by (n + 1) - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)



def loop1 (n : Nat) (h_precond : sumToN_precond n) (i : Nat) (s : Nat) (h1i : (((s * 2) = (i * (i + 1))) ∧ (i ≤ n))) : { ρ : Nat // sumToN_postcond n ρ h_precond } :=
  if h1g : (i < n) then
    match (⟨((i + 1, s + (i + 1))), by refine_auto⟩ : { ρ : Nat × Nat // (fun (i : Nat) (s : Nat) => ((s * 2) = (i * (i + 1))) ∧ (i ≤ n)) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (s : Nat) => n - i) (ρ).1 (ρ).2 < (n - i) }) with
    | ⟨(i', s'), h1b⟩ => loop1 n h_precond i' s' h1b.1
  else ⟨(s), by first | (have hEq : i = (n) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by n - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def sumToN_derived (n : Nat) (h_precond : sumToN_precond n) : { ρ : Nat // sumToN_postcond n ρ h_precond } :=
  (loop1 n h_precond (0) (0) (by refine_auto))

def sumToN (n : Nat) (h_precond : sumToN_precond n) : Nat := (sumToN_derived n h_precond).val

theorem sumToN_spec_satisfied (n : Nat) (h_precond : sumToN_precond n) :
    sumToN_postcond n (sumToN n h_precond) h_precond := (sumToN_derived n h_precond).property


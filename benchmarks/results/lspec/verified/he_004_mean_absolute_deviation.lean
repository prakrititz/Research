def loop2 (numbers : List ℚ) (h_precond : meanAbsoluteDeviation_precond numbers) (i : Nat) (s : Rat) (h2i : ((i ≤ numbers.length) ∧ (s = (numbers.take i).sum))) : { ρ : Rat // (fun (m : Rat) => m = (numbers.sum / ((numbers.length : Rat)))) ρ } :=
  if h2g : (i < numbers.length) then
    match (⟨((i + 1, s + numbers[i]!)), by refine_auto⟩ : { ρ : Nat × Rat // (fun (i : Nat) (s : Rat) => (i ≤ numbers.length) ∧ (s = (numbers.take i).sum)) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (s : Rat) => numbers.length - i) (ρ).1 (ρ).2 < (numbers.length - i) }) with
    | ⟨(i', s'), h2b⟩ => loop2 numbers h_precond i' s' h2b.1
  else ⟨(s / ((numbers.length : Rat))), by first | (have hEq : i = (numbers.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by numbers.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h2b.2 | omega)

def loop3 (numbers : List ℚ) (m : Rat) (h_precond : meanAbsoluteDeviation_precond numbers) (h1 : (m = (numbers.sum / ((numbers.length : Rat))))) (i : Nat) (d : Rat) (h3i : ((i ≤ numbers.length) ∧ (d = ((numbers.take i).map (fun x => |x - m|)).sum))) : { ρ : ℚ // meanAbsoluteDeviation_postcond numbers ρ h_precond } :=
  if h3g : (i < numbers.length) then
    match (⟨((i + 1, d + |numbers[i]! - m|)), by refine_auto⟩ : { ρ : Nat × Rat // (fun (i : Nat) (d : Rat) => (i ≤ numbers.length) ∧ (d = ((numbers.take i).map (fun x => |x - m|)).sum)) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (d : Rat) => numbers.length - i) (ρ).1 (ρ).2 < (numbers.length - i) }) with
    | ⟨(i', d'), h3b⟩ => loop3 numbers m h_precond h1 i' d' h3b.1
  else ⟨(d / ((numbers.length : Rat))), by first | (have hEq : i = (numbers.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by numbers.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h3b.2 | omega)


set_option maxHeartbeats 1000000 in
def meanAbsoluteDeviation_derived (numbers : List ℚ) (h_precond : meanAbsoluteDeviation_precond numbers) : { ρ : ℚ // meanAbsoluteDeviation_postcond numbers ρ h_precond } :=
  (match ((loop2 numbers h_precond (0) (0) (by refine_auto)) : { m : Rat // m = (numbers.sum / ((numbers.length : Rat))) }) with | ⟨m, h1⟩ => (loop3 numbers m h_precond h1 (0) (0) (by refine_auto)))

def meanAbsoluteDeviation (numbers : List ℚ) (h_precond : meanAbsoluteDeviation_precond numbers) : ℚ := (meanAbsoluteDeviation_derived numbers h_precond).val

theorem meanAbsoluteDeviation_spec_satisfied (numbers : List ℚ) (h_precond : meanAbsoluteDeviation_precond numbers) :
    meanAbsoluteDeviation_postcond numbers (meanAbsoluteDeviation numbers h_precond) h_precond := (meanAbsoluteDeviation_derived numbers h_precond).property


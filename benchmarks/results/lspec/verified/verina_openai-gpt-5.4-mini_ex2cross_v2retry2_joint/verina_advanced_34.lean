def longestIncreasingSubsequence_derived (nums : List Int) (h_precond : longestIncreasingSubsequence_precond nums) : { ρ : Int // longestIncreasingSubsequence_postcond nums ρ h_precond } :=
  ⟨((((((nums.foldl (fun acc x => acc ++ (acc.map (fun sub => x :: sub)))) [[]]).map List.reverse).filter (fun l => List.Pairwise (fun _c1 _c2 => _c1 < _c2) l)).map (fun _c1 => _c1.length)).max?.get!), by refine_auto⟩

def longestIncreasingSubsequence (nums : List Int) (h_precond : longestIncreasingSubsequence_precond nums) : Int := (longestIncreasingSubsequence_derived nums h_precond).val

theorem longestIncreasingSubsequence_spec_satisfied (nums : List Int) (h_precond : longestIncreasingSubsequence_precond nums) :
    longestIncreasingSubsequence_postcond nums (longestIncreasingSubsequence nums h_precond) h_precond := (longestIncreasingSubsequence_derived nums h_precond).property


set_option maxHeartbeats 1000000 in
def triangleArea_derived (a : ℚ) (h : ℚ) (h_precond : triangleArea_precond a h) : { ρ : ℚ // triangleArea_postcond a h ρ h_precond } :=
  ⟨((a * h) / 2), by refine_auto⟩

def triangleArea (a : ℚ) (h : ℚ) (h_precond : triangleArea_precond a h) : ℚ := (triangleArea_derived a h h_precond).val

theorem triangleArea_spec_satisfied (a : ℚ) (h : ℚ) (h_precond : triangleArea_precond a h) :
    triangleArea_postcond a h (triangleArea a h h_precond) h_precond := (triangleArea_derived a h h_precond).property

#print axioms triangleArea_spec_satisfied


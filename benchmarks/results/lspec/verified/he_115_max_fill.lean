def loop1 (grid : List (List Nat)) (capacity : Nat) (h_precond : maxFill_precond grid capacity) (i : Nat) (acc : Nat) (h1i : ((i ≤ grid.length) ∧ (acc = ((grid.take i).map (fun row => ((row.sum + capacity) - 1) / capacity)).sum))) : { ρ : Nat // maxFill_postcond grid capacity ρ h_precond } :=
  if h1g : (i < grid.length) then
    match (⟨((i + 1, acc + (((grid[i]!.sum + capacity) - 1) / capacity))), by refine_auto⟩ : { ρ : Nat × Nat // (fun (i : Nat) (acc : Nat) => (i ≤ grid.length) ∧ (acc = ((grid.take i).map (fun row => ((row.sum + capacity) - 1) / capacity)).sum)) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : Nat) => grid.length - i) (ρ).1 (ρ).2 < (grid.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 grid capacity h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (grid.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by grid.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def maxFill_derived (grid : List (List Nat)) (capacity : Nat) (h_precond : maxFill_precond grid capacity) : { ρ : Nat // maxFill_postcond grid capacity ρ h_precond } :=
  (loop1 grid capacity h_precond (0) (0) (by refine_auto))

def maxFill (grid : List (List Nat)) (capacity : Nat) (h_precond : maxFill_precond grid capacity) : Nat := (maxFill_derived grid capacity h_precond).val

theorem maxFill_spec_satisfied (grid : List (List Nat)) (capacity : Nat) (h_precond : maxFill_precond grid capacity) :
    maxFill_postcond grid capacity (maxFill grid capacity h_precond) h_precond := (maxFill_derived grid capacity h_precond).property


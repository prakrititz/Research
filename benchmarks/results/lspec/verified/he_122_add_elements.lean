set_option maxHeartbeats 1000000 in
def addElements_derived (arr : List Int) (k : Nat) (h_precond : addElements_precond arr k) : { ρ : Int // addElements_postcond arr k ρ h_precond } :=
  ⟨(((arr.take k).filter (fun x => x.natAbs < 100)).sum), by refine_auto⟩

def addElements (arr : List Int) (k : Nat) (h_precond : addElements_precond arr k) : Int := (addElements_derived arr k h_precond).val

theorem addElements_spec_satisfied (arr : List Int) (k : Nat) (h_precond : addElements_precond arr k) :
    addElements_postcond arr k (addElements arr k h_precond) h_precond := (addElements_derived arr k h_precond).property

#print axioms addElements_spec_satisfied


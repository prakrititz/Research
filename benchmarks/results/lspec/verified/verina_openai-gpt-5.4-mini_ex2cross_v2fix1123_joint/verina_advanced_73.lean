def loop1 (l : List Nat) (h_precond : smallestMissing_precond l) (i : Nat) (h1i : (∀ candidate < i, candidate ∈ l)) : { ρ : Nat // smallestMissing_postcond l ρ h_precond } :=
  if h1g : (i ∈ l) then
    match (⟨(i + 1), by refine_auto⟩ : { ρ : Nat // (fun (i : Nat) => ∀ candidate < i, candidate ∈ l) (ρ) ∧ (fun (i : Nat) => l.length - i) (ρ) < (l.length - i) }) with
    | ⟨i', h1b⟩ => loop1 l h_precond i' h1b.1
  else ⟨(i), by refine_auto⟩
termination_by l.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)



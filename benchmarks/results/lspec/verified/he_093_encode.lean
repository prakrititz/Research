def loop1 (message : String) (h_precond : encode93_precond message) (i : Nat) (acc : List Char) (h1i : ((i ≤ message.length) ∧ (acc = ((List.range i).map (fun k => encChar message.toList[k]!))))) : { ρ : String // encode93_postcond message ρ h_precond } :=
  if h1g : (i < message.length) then
    match (⟨((i + 1, acc ++ [encChar message.toList[i]!])), by refine_auto⟩ : { ρ : Nat × (List Char) // (fun (i : Nat) (acc : List Char) => (i ≤ message.length) ∧ (acc = ((List.range i).map (fun k => encChar message.toList[k]!)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : List Char) => message.length - i) (ρ).1 (ρ).2 < (message.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 message h_precond i' acc' h1b.1
  else ⟨(String.mk acc), by first | (have hEq : i = (message.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by message.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def encode93_derived (message : String) (h_precond : encode93_precond message) : { ρ : String // encode93_postcond message ρ h_precond } :=
  (loop1 message h_precond (0) ([]) (by refine_auto))

def encode93 (message : String) (h_precond : encode93_precond message) : String := (encode93_derived message h_precond).val

theorem encode93_spec_satisfied (message : String) (h_precond : encode93_precond message) :
    encode93_postcond message (encode93 message h_precond) h_precond := (encode93_derived message h_precond).property

#print axioms encode93_spec_satisfied


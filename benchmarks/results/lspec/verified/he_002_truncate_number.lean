set_option maxHeartbeats 1000000 in
def truncateNumber_derived (number : ℚ) (h_precond : truncateNumber_precond number) : { ρ : ℚ // truncateNumber_postcond number ρ h_precond } :=
  ⟨(number - ((⌊number⌋ : Rat))), by refine_auto⟩

def truncateNumber (number : ℚ) (h_precond : truncateNumber_precond number) : ℚ := (truncateNumber_derived number h_precond).val

theorem truncateNumber_spec_satisfied (number : ℚ) (h_precond : truncateNumber_precond number) :
    truncateNumber_postcond number (truncateNumber number h_precond) h_precond := (truncateNumber_derived number h_precond).property

#print axioms truncateNumber_spec_satisfied


def loop3 (music_string : String) (notes : List String) (h_precond : parseMusic_precond music_string) (h1 : (notes = (if music_string = "" then [] else music_string.splitOn " "))) (i : Nat) (acc : List Nat) (h3i : ((i ≤ notes.length) ∧ (acc = ((notes.take i).map (fun n => if n = "o" then 4 else if n = "o|" then 2 else 1))))) : { ρ : List Nat // parseMusic_postcond music_string ρ h_precond } :=
  if h3g : (i < notes.length) then
    match (⟨((i + 1, acc ++ [if notes[i]! = "o" then 4 else if notes[i]! = "o|" then 2 else 1])), by refine_auto⟩ : { ρ : Nat × (List Nat) // (fun (i : Nat) (acc : List Nat) => (i ≤ notes.length) ∧ (acc = ((notes.take i).map (fun n => if n = "o" then 4 else if n = "o|" then 2 else 1)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : List Nat) => notes.length - i) (ρ).1 (ρ).2 < (notes.length - i) }) with
    | ⟨(i', acc'), h3b⟩ => loop3 music_string notes h_precond h1 i' acc' h3b.1
  else ⟨(acc), by first | (have hEq : i = (notes.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by notes.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h3b.2 | omega)


set_option maxHeartbeats 1000000 in
def parseMusic_derived (music_string : String) (h_precond : parseMusic_precond music_string) : { ρ : List Nat // parseMusic_postcond music_string ρ h_precond } :=
  (match (⟨(if music_string = "" then [] else music_string.splitOn " "), by refine_auto⟩ : { notes : List String // notes = (if music_string = "" then [] else music_string.splitOn " ") }) with | ⟨notes, h1⟩ => (loop3 music_string notes h_precond h1 (0) ([]) (by refine_auto)))

def parseMusic (music_string : String) (h_precond : parseMusic_precond music_string) : List Nat := (parseMusic_derived music_string h_precond).val

theorem parseMusic_spec_satisfied (music_string : String) (h_precond : parseMusic_precond music_string) :
    parseMusic_postcond music_string (parseMusic music_string h_precond) h_precond := (parseMusic_derived music_string h_precond).property


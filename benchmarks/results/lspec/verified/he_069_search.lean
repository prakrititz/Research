def loop1 (lst : List Nat) (h_precond : search_precond lst) (i : Nat) (best : Int) (h1i : ((i ≤ lst.length) ∧ (((best = (-1)) ∧ (∀ k, (k < i) → ((lst.count lst[k]!) < lst[k]!))) ∨ ((best > 0) ∧ ((best.toNat ∈ lst) ∧ (((lst.count best.toNat) ≥ best.toNat) ∧ (∀ k, (k < i) → (((lst.count lst[k]!) ≥ lst[k]!) → (lst[k]! ≤ best.toNat))))))))) : { ρ : Int // search_postcond lst ρ h_precond } :=
  if h1g : (i < lst.length) then
    match (⟨((i + 1, if ((lst.count lst[i]!) ≥ lst[i]!) ∧ ((best = (-1)) ∨ (best < ((lst[i]! : Int)))) then (lst[i]! : Int) else best)), by refine_auto⟩ : { ρ : Nat × Int // (fun (i : Nat) (best : Int) => (i ≤ lst.length) ∧ (((best = (-1)) ∧ (∀ k, (k < i) → ((lst.count lst[k]!) < lst[k]!))) ∨ ((best > 0) ∧ ((best.toNat ∈ lst) ∧ (((lst.count best.toNat) ≥ best.toNat) ∧ (∀ k, (k < i) → (((lst.count lst[k]!) ≥ lst[k]!) → (lst[k]! ≤ best.toNat)))))))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (best : Int) => lst.length - i) (ρ).1 (ρ).2 < (lst.length - i) }) with
    | ⟨(i', best'), h1b⟩ => loop1 lst h_precond i' best' h1b.1
  else ⟨(best), by first | (have hEq : i = (lst.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by lst.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def search_derived (lst : List Nat) (h_precond : search_precond lst) : { ρ : Int // search_postcond lst ρ h_precond } :=
  (loop1 lst h_precond (0) (-1) (by refine_auto))

def search (lst : List Nat) (h_precond : search_precond lst) : Int := (search_derived lst h_precond).val

theorem search_spec_satisfied (lst : List Nat) (h_precond : search_precond lst) :
    search_postcond lst (search lst h_precond) h_precond := (search_derived lst h_precond).property


def loop1 (n : Nat) (h_precond : specialFactorial_precond n) (i : Nat) (fact : Nat) (total : Nat) (h1i : ((i ≤ n) ∧ ((fact = (factSpec i)) ∧ (total = ((List.range i).map (fun j => factSpec (j + 1))).prod)))) : { ρ : Nat // specialFactorial_postcond n ρ h_precond } :=
  if h1g : (i < n) then
    match (⟨((i + 1, fact * (i + 1), total * (fact * (i + 1)))), by refine_auto⟩ : { ρ : Nat × Nat × Nat // (fun (i : Nat) (fact : Nat) (total : Nat) => (i ≤ n) ∧ ((fact = (factSpec i)) ∧ (total = ((List.range i).map (fun j => factSpec (j + 1))).prod))) (ρ).1 (ρ).2.1 (ρ).2.2 ∧ (fun (i : Nat) (fact : Nat) (total : Nat) => n - i) (ρ).1 (ρ).2.1 (ρ).2.2 < (n - i) }) with
    | ⟨(i', fact', total'), h1b⟩ => loop1 n h_precond i' fact' total' h1b.1
  else ⟨(total), by first | (have hEq : i = (n) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by n - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def specialFactorial_derived (n : Nat) (h_precond : specialFactorial_precond n) : { ρ : Nat // specialFactorial_postcond n ρ h_precond } :=
  (loop1 n h_precond (0) (1) (1) (by refine_auto))

def specialFactorial (n : Nat) (h_precond : specialFactorial_precond n) : Nat := (specialFactorial_derived n h_precond).val

theorem specialFactorial_spec_satisfied (n : Nat) (h_precond : specialFactorial_precond n) :
    specialFactorial_postcond n (specialFactorial n h_precond) h_precond := (specialFactorial_derived n h_precond).property


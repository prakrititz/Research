set_option maxHeartbeats 1000000 in
def uniqueDigits_derived (x : List Nat) (h_precond : uniqueDigits_precond x) : { ρ : List Nat // uniqueDigits_postcond x ρ h_precond } :=
  ⟨((x.filter noEvenDigit).mergeSort (fun a b => decide (a ≤ b))), by refine_auto⟩

def uniqueDigits (x : List Nat) (h_precond : uniqueDigits_precond x) : List Nat := (uniqueDigits_derived x h_precond).val

theorem uniqueDigits_spec_satisfied (x : List Nat) (h_precond : uniqueDigits_precond x) :
    uniqueDigits_postcond x (uniqueDigits x h_precond) h_precond := (uniqueDigits_derived x h_precond).property

#print axioms uniqueDigits_spec_satisfied


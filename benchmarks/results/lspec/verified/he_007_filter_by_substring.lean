def loop1 (strings : List String) (substring : String) (h_precond : filterBySubstring_precond strings substring) (i : Nat) (acc : List String) (h1i : ((i ≤ strings.length) ∧ (acc = ((strings.take i).filter (fun s => decide (hasSub s substring)))))) : { ρ : List String // filterBySubstring_postcond strings substring ρ h_precond } :=
  if h1g : (i < strings.length) then
    match (⟨((i + 1, if decide (hasSub strings[i]! substring) then acc ++ [strings[i]!] else acc)), by refine_auto⟩ : { ρ : Nat × (List String) // (fun (i : Nat) (acc : List String) => (i ≤ strings.length) ∧ (acc = ((strings.take i).filter (fun s => decide (hasSub s substring))))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : List String) => strings.length - i) (ρ).1 (ρ).2 < (strings.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 strings substring h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (strings.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by strings.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def filterBySubstring_derived (strings : List String) (substring : String) (h_precond : filterBySubstring_precond strings substring) : { ρ : List String // filterBySubstring_postcond strings substring ρ h_precond } :=
  (loop1 strings substring h_precond (0) ([]) (by refine_auto))

def filterBySubstring (strings : List String) (substring : String) (h_precond : filterBySubstring_precond strings substring) : List String := (filterBySubstring_derived strings substring h_precond).val

theorem filterBySubstring_spec_satisfied (strings : List String) (substring : String) (h_precond : filterBySubstring_precond strings substring) :
    filterBySubstring_postcond strings substring (filterBySubstring strings substring h_precond) h_precond := (filterBySubstring_derived strings substring h_precond).property


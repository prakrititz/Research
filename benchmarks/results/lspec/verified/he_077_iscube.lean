def loop1 (a : Int) (h_precond : iscube_precond a) (i : Nat) (f : Bool) (h1i : ((i ≤ (a.natAbs + 2)) ∧ ((f = true) ↔ (∃ k, (k < i) ∧ ((k ^ 3) = a.natAbs))))) : { ρ : Bool // iscube_postcond a ρ h_precond } :=
  if h1g : (i < (a.natAbs + 2)) then
    match (⟨((i + 1, f || (decide ((i ^ 3) = a.natAbs)))), by refine_auto⟩ : { ρ : Nat × Bool // (fun (i : Nat) (f : Bool) => (i ≤ (a.natAbs + 2)) ∧ ((f = true) ↔ (∃ k, (k < i) ∧ ((k ^ 3) = a.natAbs)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (f : Bool) => (a.natAbs + 2) - i) (ρ).1 (ρ).2 < ((a.natAbs + 2) - i) }) with
    | ⟨(i', f'), h1b⟩ => loop1 a h_precond i' f' h1b.1
  else ⟨(f), by first | (have hEq : i = ((a.natAbs + 2)) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by (a.natAbs + 2) - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def iscube_derived (a : Int) (h_precond : iscube_precond a) : { ρ : Bool // iscube_postcond a ρ h_precond } :=
  (loop1 a h_precond (0) (false) (by refine_auto))

def iscube (a : Int) (h_precond : iscube_precond a) : Bool := (iscube_derived a h_precond).val

theorem iscube_spec_satisfied (a : Int) (h_precond : iscube_precond a) :
    iscube_postcond a (iscube a h_precond) h_precond := (iscube_derived a h_precond).property

#print axioms iscube_spec_satisfied


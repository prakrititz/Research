set_option maxHeartbeats 1000000 in
def primeLength_derived (string : String) (h_precond : primeLength_precond string) : { ρ : Bool // primeLength_postcond string ρ h_precond } :=
  ⟨(decide (Nat.Prime string.length)), by refine_auto⟩

def primeLength (string : String) (h_precond : primeLength_precond string) : Bool := (primeLength_derived string h_precond).val

theorem primeLength_spec_satisfied (string : String) (h_precond : primeLength_precond string) :
    primeLength_postcond string (primeLength string h_precond) h_precond := (primeLength_derived string h_precond).property

#print axioms primeLength_spec_satisfied


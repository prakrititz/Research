def loop1 (string : String) (h_precond : allPrefixes_precond string) (i : Nat) (acc : List String) (h1i : ((i ≤ string.length) ∧ ((acc.length = i) ∧ (∀ k, (k < i) → (acc[k]! = (String.mk (string.toList.take (k + 1)))))))) : { ρ : List String // allPrefixes_postcond string ρ h_precond } :=
  if h1g : (i < string.length) then
    match (⟨((i + 1, acc ++ [String.mk (string.toList.take (i + 1))])), by refine_auto⟩ : { ρ : Nat × (List String) // (fun (i : Nat) (acc : List String) => (i ≤ string.length) ∧ ((acc.length = i) ∧ (∀ k, (k < i) → (acc[k]! = (String.mk (string.toList.take (k + 1))))))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : List String) => string.length - i) (ρ).1 (ρ).2 < (string.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 string h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (string.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by string.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def allPrefixes_derived (string : String) (h_precond : allPrefixes_precond string) : { ρ : List String // allPrefixes_postcond string ρ h_precond } :=
  (loop1 string h_precond (0) ([]) (by refine_auto))

def allPrefixes (string : String) (h_precond : allPrefixes_precond string) : List String := (allPrefixes_derived string h_precond).val

theorem allPrefixes_spec_satisfied (string : String) (h_precond : allPrefixes_precond string) :
    allPrefixes_postcond string (allPrefixes string h_precond) h_precond := (allPrefixes_derived string h_precond).property

#print axioms allPrefixes_spec_satisfied


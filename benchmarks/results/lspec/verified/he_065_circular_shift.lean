set_option maxHeartbeats 1000000 in
def circularShift_derived (x : Nat) (shift : Nat) (h_precond : circularShift_precond x shift) : { ρ : String // circularShift_postcond x shift ρ h_precond } :=
  (match (⟨((toString x).toList), by refine_auto⟩ : { d : List Char // d = (toString x).toList }) with | ⟨d, h1⟩ => ⟨(String.mk (if shift > d.length then d.reverse else (d.drop (d.length - (shift % d.length))) ++ (d.take (d.length - (shift % d.length))))), by refine_auto⟩)

def circularShift (x : Nat) (shift : Nat) (h_precond : circularShift_precond x shift) : String := (circularShift_derived x shift h_precond).val

theorem circularShift_spec_satisfied (x : Nat) (shift : Nat) (h_precond : circularShift_precond x shift) :
    circularShift_postcond x shift (circularShift x shift h_precond) h_precond := (circularShift_derived x shift h_precond).property

#print axioms circularShift_spec_satisfied


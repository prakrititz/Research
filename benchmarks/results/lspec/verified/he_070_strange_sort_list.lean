set_option maxHeartbeats 1000000 in
def strangeSortList_derived (lst : List Int) (h_precond : strangeSortList_precond lst) : { ρ : List Int // strangeSortList_postcond lst ρ h_precond } :=
  (match (⟨(lst.mergeSort (fun a b => a ≤ b)), by refine_auto⟩ : { s : List Int // s = (lst.mergeSort (fun a b => a ≤ b)) }) with | ⟨s, h1⟩ => ⟨((List.range lst.length).map (fun k => if (k % 2) = 0 then s[k / 2]! else s[(lst.length - 1) - (k / 2)]!)), by refine_auto⟩)

def strangeSortList (lst : List Int) (h_precond : strangeSortList_precond lst) : List Int := (strangeSortList_derived lst h_precond).val

theorem strangeSortList_spec_satisfied (lst : List Int) (h_precond : strangeSortList_precond lst) :
    strangeSortList_postcond lst (strangeSortList lst h_precond) h_precond := (strangeSortList_derived lst h_precond).property

#print axioms strangeSortList_spec_satisfied


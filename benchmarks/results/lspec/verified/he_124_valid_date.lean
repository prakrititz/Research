set_option maxHeartbeats 1000000 in
def validDate_derived (date : String) (h_precond : validDate_precond date) : { ρ : Bool // validDate_postcond date ρ h_precond } :=
  (match (⟨(date.toList), by refine_auto⟩ : { l : List Char // l = date.toList }) with | ⟨l, h1⟩ => ⟨(decide ((l.length = 10) ∧ ((l[2]! = '-') ∧ ((l[5]! = '-') ∧ ((((l.take 2).all Char.isDigit) = true) ∧ (((((l.drop 3).take 2).all Char.isDigit) = true) ∧ ((((l.drop 6).all Char.isDigit) = true) ∧ ((1 ≤ (natOf (l.take 2))) ∧ (((natOf (l.take 2)) ≤ 12) ∧ ((1 ≤ (natOf ((l.drop 3).take 2))) ∧ ((natOf ((l.drop 3).take 2)) ≤ (daysIn (natOf (l.take 2)))))))))))))), by refine_auto⟩)

def validDate (date : String) (h_precond : validDate_precond date) : Bool := (validDate_derived date h_precond).val

theorem validDate_spec_satisfied (date : String) (h_precond : validDate_precond date) :
    validDate_postcond date (validDate date h_precond) h_precond := (validDate_derived date h_precond).property

#print axioms validDate_spec_satisfied


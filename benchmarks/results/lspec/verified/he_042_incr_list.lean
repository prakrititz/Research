def loop1 (l : List Int) (h_precond : incrList_precond l) (i : Nat) (acc : List Int) (h1i : ((acc.length = i) ∧ ((i ≤ l.length) ∧ (∀ k, (k < i) → (acc[k]! = (l[k]! + 1)))))) : { ρ : List Int // incrList_postcond l ρ h_precond } :=
  if h1g : (i < l.length) then
    match (⟨((i + 1, acc ++ [l[i]! + 1])), by refine_auto⟩ : { ρ : Nat × (List Int) // (fun (i : Nat) (acc : List Int) => (acc.length = i) ∧ ((i ≤ l.length) ∧ (∀ k, (k < i) → (acc[k]! = (l[k]! + 1))))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : List Int) => l.length - i) (ρ).1 (ρ).2 < (l.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 l h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (l.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by l.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def incrList_derived (l : List Int) (h_precond : incrList_precond l) : { ρ : List Int // incrList_postcond l ρ h_precond } :=
  (loop1 l h_precond (0) ([]) (by refine_auto))

def incrList (l : List Int) (h_precond : incrList_precond l) : List Int := (incrList_derived l h_precond).val

theorem incrList_spec_satisfied (l : List Int) (h_precond : incrList_precond l) :
    incrList_postcond l (incrList l h_precond) h_precond := (incrList_derived l h_precond).property


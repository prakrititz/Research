def LongestIncreasingSubsequence_derived (a : Array Int) (h_precond : LongestIncreasingSubsequence_precond a) : { ρ : Int // LongestIncreasingSubsequence_postcond a ρ h_precond } :=
  ⟨(let allSubseq := ((a.foldl (fun acc x => acc ++ (acc.map (fun sub => x :: sub)))) [[]]).map List.reverse; let increasingSubseqLens := (allSubseq.filter (fun l => List.Pairwise (fun _c1 _c2 => _c1 < _c2) l)).map (fun _c1 => _c1.length); increasingSubseqLens.foldl max (increasingSubseqLens.headD 0)), by refine_auto⟩

def LongestIncreasingSubsequence (a : Array Int) (h_precond : LongestIncreasingSubsequence_precond a) : Int := (LongestIncreasingSubsequence_derived a h_precond).val

theorem LongestIncreasingSubsequence_spec_satisfied (a : Array Int) (h_precond : LongestIncreasingSubsequence_precond a) :
    LongestIncreasingSubsequence_postcond a (LongestIncreasingSubsequence a h_precond) h_precond := (LongestIncreasingSubsequence_derived a h_precond).property


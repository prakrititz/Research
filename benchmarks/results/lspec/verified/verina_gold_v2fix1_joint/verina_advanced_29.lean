def longestGoodSubarray_derived (nums : List Nat) (k : Nat) (h_precond : longestGoodSubarray_precond nums k) : { ρ : Nat // longestGoodSubarray_postcond nums k ρ h_precond } :=
  (if h1 : (nums = []) then ⟨(0), by refine_auto⟩ else ⟨(let subArrays := (List.range (nums.length + 1)).flatMap (fun start => (List.range ((nums.length - start) + 1)).map (fun len => (nums.drop start).take len)); let subArrayFreqs := subArrays.map (fun arr => arr.map (fun x => arr.count x)); let validSubArrays := subArrayFreqs.filter (fun arr => arr.all (fun x => x ≤ k)); (validSubArrays.map (fun _c1 => _c1.length)).foldl max 0), by refine_auto⟩)

def longestGoodSubarray (nums : List Nat) (k : Nat) (h_precond : longestGoodSubarray_precond nums k) : Nat := (longestGoodSubarray_derived nums k h_precond).val

theorem longestGoodSubarray_spec_satisfied (nums : List Nat) (k : Nat) (h_precond : longestGoodSubarray_precond nums k) :
    longestGoodSubarray_postcond nums k (longestGoodSubarray nums k h_precond) h_precond := (longestGoodSubarray_derived nums k h_precond).property

#print axioms longestGoodSubarray_spec_satisfied

set_option maxHeartbeats 2000000 in
#eval (((longestGoodSubarray ([1, 2, 3, 1, 2, 3, 1, 2]) (2) (by first | native_decide | trivial | (norm_num [longestGoodSubarray_precond]; done) | (simp [longestGoodSubarray_precond]; done) | decide | omega | (unfold longestGoodSubarray_precond; pre_wit_search)))) == (6))

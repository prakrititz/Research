set_option maxHeartbeats 1000000 in
def maxSubarraySum_derived (xs : List Int) (h_precond : maxSubarraySum_precond xs) : { ρ : Int // maxSubarraySum_postcond xs ρ h_precond } :=
  (if h1 : (xs = []) then ⟨(0), by refine_auto⟩ else ⟨(let subarray_sums := (List.range (xs.length + 1)).flatMap (fun start => (List.range' 1 (xs.length - start)).map (fun len => ((xs.drop start).take len).sum)); subarray_sums.foldl max (subarray_sums.headD 0)), by refine_auto⟩)

def maxSubarraySum (xs : List Int) (h_precond : maxSubarraySum_precond xs) : Int := (maxSubarraySum_derived xs h_precond).val

theorem maxSubarraySum_spec_satisfied (xs : List Int) (h_precond : maxSubarraySum_precond xs) :
    maxSubarraySum_postcond xs (maxSubarraySum xs h_precond) h_precond := (maxSubarraySum_derived xs h_precond).property

#print axioms maxSubarraySum_spec_satisfied

set_option maxHeartbeats 2000000 in
#eval (((maxSubarraySum ([1, -2, 3, 4, -1]) (by first | native_decide | trivial | (norm_num [maxSubarraySum_precond]; done) | (simp [maxSubarraySum_precond]; done) | decide | omega | (unfold maxSubarraySum_precond; pre_wit_search)))) == (7))
set_option maxHeartbeats 2000000 in
#eval (((maxSubarraySum ([-2, -3, -1, -5]) (by first | native_decide | trivial | (norm_num [maxSubarraySum_precond]; done) | (simp [maxSubarraySum_precond]; done) | decide | omega | (unfold maxSubarraySum_precond; pre_wit_search)))) == ((-1)))
set_option maxHeartbeats 2000000 in
#eval (((maxSubarraySum ([5, -1, 2, -1, 3]) (by first | native_decide | trivial | (norm_num [maxSubarraySum_precond]; done) | (simp [maxSubarraySum_precond]; done) | decide | omega | (unfold maxSubarraySum_precond; pre_wit_search)))) == (8))
set_option maxHeartbeats 2000000 in
#eval (((maxSubarraySum ([]) (by first | native_decide | trivial | (norm_num [maxSubarraySum_precond]; done) | (simp [maxSubarraySum_precond]; done) | decide | omega | (unfold maxSubarraySum_precond; pre_wit_search)))) == (0))
set_option maxHeartbeats 2000000 in
#eval (((maxSubarraySum ([4, -1, -2, 1, 5]) (by first | native_decide | trivial | (norm_num [maxSubarraySum_precond]; done) | (simp [maxSubarraySum_precond]; done) | decide | omega | (unfold maxSubarraySum_precond; pre_wit_search)))) == (7))

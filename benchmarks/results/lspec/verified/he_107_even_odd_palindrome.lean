    match (⟨((i + 1, if (1 ≤ i) ∧ ((isPal (toString i).toList) ∧ ((i % 2) = 0)) then e + 1 else e, if (1 ≤ i) ∧ ((isPal (toString i).toList) ∧ ((i % 2) = 1)) then o + 1 else o)), by refine_auto⟩ : { ρ : Nat × Nat × Nat // (fun (i : Nat) (e : Nat) (o : Nat) => (i ≤ (n + 1)) ∧ ((e = ((List.range i).filter (fun j => decide ((1 ≤ j) ∧ ((isPal (toString j).toList) ∧ ((j % 2) = 0))))).length) ∧ (o = ((List.range i).filter (fun j => decide ((1 ≤ j) ∧ ((isPal (toString j).toList) ∧ ((j % 2) = 1))))).length))) (ρ).1 (ρ).2.1 (ρ).2.2 ∧ (fun (i : Nat) (e : Nat) (o : Nat) => (n + 1) - i) (ρ).1 (ρ).2.1 (ρ).2.2 < ((n + 1) - i) }) with
    | ⟨(i', e', o'), h1b⟩ => loop1 n h_precond i' e' o' h1b.1
  else ⟨((e, o)), by first | (have hEq : i = ((n + 1)) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by (n + 1) - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def evenOddPalindrome_derived (n : Nat) (h_precond : evenOddPalindrome_precond n) : { ρ : Nat × Nat // evenOddPalindrome_postcond n ρ h_precond } :=
  (loop1 n h_precond (0) (0) (0) (by refine_auto))

def evenOddPalindrome (n : Nat) (h_precond : evenOddPalindrome_precond n) : Nat × Nat := (evenOddPalindrome_derived n h_precond).val

theorem evenOddPalindrome_spec_satisfied (n : Nat) (h_precond : evenOddPalindrome_precond n) :
    evenOddPalindrome_postcond n (evenOddPalindrome n h_precond) h_precond := (evenOddPalindrome_derived n h_precond).property


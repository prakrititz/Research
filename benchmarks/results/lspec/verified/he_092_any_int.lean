def anyInt_derived (x : PyVal) (y : PyVal) (z : PyVal) (h_precond : anyInt_precond x y z) : { ρ : Bool // anyInt_postcond x y z ρ h_precond } :=
  ⟨((fun (p : PyVal × (PyVal × PyVal)) => match p with | (PyVal.int a, PyVal.int b, PyVal.int c) => decide ((a = (b + c)) ∨ ((b = (a + c)) ∨ (c = (b + a)))) | _ => false) (x, y, z)), by refine_auto⟩

def anyInt (x : PyVal) (y : PyVal) (z : PyVal) (h_precond : anyInt_precond x y z) : Bool := (anyInt_derived x y z h_precond).val

theorem anyInt_spec_satisfied (x : PyVal) (y : PyVal) (z : PyVal) (h_precond : anyInt_precond x y z) :
    anyInt_postcond x y z (anyInt x y z h_precond) h_precond := (anyInt_derived x y z h_precond).property


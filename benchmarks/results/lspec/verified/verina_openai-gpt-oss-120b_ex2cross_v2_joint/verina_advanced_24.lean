def lengthOfLIS_derived (nums : List Int) (h_precond : lengthOfLIS_precond nums) : { ρ : Int // lengthOfLIS_postcond nums ρ h_precond } :=
  ⟨(let rec isStrictlyIncreasing (l : List Int) : Bool := match l with | [] => true | [_] => true | x :: (y :: rest) => (x < y) && (isStrictlyIncreasing (y :: rest)); let rec subsequences (xs : List Int) : List (List Int) := match xs with | [] => [[]] | x :: xs' => let rest := subsequences xs'; rest ++ (rest.map (fun r => x :: r)); ((subsequences nums).filter (fun l => isStrictlyIncreasing l)).foldl (fun acc l => if l.length > acc then l.length else acc) 0), by first | (exact auto_0_obl1_0_s7 nums h_precond) | refine_auto⟩

def lengthOfLIS (nums : List Int) (h_precond : lengthOfLIS_precond nums) : Int := (lengthOfLIS_derived nums h_precond).val

theorem lengthOfLIS_spec_satisfied (nums : List Int) (h_precond : lengthOfLIS_precond nums) :
    lengthOfLIS_postcond nums (lengthOfLIS nums h_precond) h_precond := (lengthOfLIS_derived nums h_precond).property


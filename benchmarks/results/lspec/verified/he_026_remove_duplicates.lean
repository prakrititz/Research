def loop1 (numbers : List Int) (h_precond : removeDuplicates_precond numbers) (i : Nat) (acc : List Int) (h1i : ((i ≤ numbers.length) ∧ (acc = ((numbers.take i).filter (fun x => (numbers.count x) = 1))))) : { ρ : List Int // removeDuplicates_postcond numbers ρ h_precond } :=
  if h1g : (i < numbers.length) then
    match (⟨((i + 1, if (numbers.count numbers[i]!) = 1 then acc ++ [numbers[i]!] else acc)), by refine_auto⟩ : { ρ : Nat × (List Int) // (fun (i : Nat) (acc : List Int) => (i ≤ numbers.length) ∧ (acc = ((numbers.take i).filter (fun x => (numbers.count x) = 1)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : List Int) => numbers.length - i) (ρ).1 (ρ).2 < (numbers.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 numbers h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (numbers.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by numbers.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def removeDuplicates_derived (numbers : List Int) (h_precond : removeDuplicates_precond numbers) : { ρ : List Int // removeDuplicates_postcond numbers ρ h_precond } :=
  (loop1 numbers h_precond (0) ([]) (by refine_auto))

def removeDuplicates (numbers : List Int) (h_precond : removeDuplicates_precond numbers) : List Int := (removeDuplicates_derived numbers h_precond).val

theorem removeDuplicates_spec_satisfied (numbers : List Int) (h_precond : removeDuplicates_precond numbers) :
    removeDuplicates_postcond numbers (removeDuplicates numbers h_precond) h_precond := (removeDuplicates_derived numbers h_precond).property

#print axioms removeDuplicates_spec_satisfied


def loop2 (numbers : List ℚ) (h_precond : rescaleToUnit_precond numbers) (i : Nat) (m : Rat) (h2i : ((i ≤ numbers.length) ∧ (m = ((numbers.take i).foldl min numbers[0]!)))) : { ρ : Rat // (fun (lo : Rat) => lo = (numbers.foldl min numbers[0]!)) ρ } :=
  if h2g : (i < numbers.length) then
    match (⟨((i + 1, min m numbers[i]!)), by refine_auto⟩ : { ρ : Nat × Rat // (fun (i : Nat) (m : Rat) => (i ≤ numbers.length) ∧ (m = ((numbers.take i).foldl min numbers[0]!))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (m : Rat) => numbers.length - i) (ρ).1 (ρ).2 < (numbers.length - i) }) with
    | ⟨(i', m'), h2b⟩ => loop2 numbers h_precond i' m' h2b.1
  else ⟨(m), by first | (have hEq : i = (numbers.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by numbers.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h2b.2 | omega)

def loop5 (numbers : List ℚ) (lo : Rat) (h_precond : rescaleToUnit_precond numbers) (h1 : (lo = (numbers.foldl min numbers[0]!))) (i : Nat) (m : Rat) (h5i : ((i ≤ numbers.length) ∧ (m = ((numbers.take i).foldl max numbers[0]!)))) : { ρ : Rat // (fun (hi : Rat) => hi = (numbers.foldl max numbers[0]!)) ρ } :=
  if h5g : (i < numbers.length) then
    match (⟨((i + 1, max m numbers[i]!)), by refine_auto⟩ : { ρ : Nat × Rat // (fun (i : Nat) (m : Rat) => (i ≤ numbers.length) ∧ (m = ((numbers.take i).foldl max numbers[0]!))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (m : Rat) => numbers.length - i) (ρ).1 (ρ).2 < (numbers.length - i) }) with
    | ⟨(i', m'), h5b⟩ => loop5 numbers lo h_precond h1 i' m' h5b.1
  else ⟨(m), by first | (have hEq : i = (numbers.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by numbers.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h5b.2 | omega)

def loop6 (numbers : List ℚ) (lo : Rat) (hi : Rat) (h_precond : rescaleToUnit_precond numbers) (h1 : (lo = (numbers.foldl min numbers[0]!))) (h3 : (hi = (numbers.foldl max numbers[0]!))) (i : Nat) (acc : List Rat) (h6i : ((i ≤ numbers.length) ∧ (acc = ((numbers.take i).map (fun x => (x - lo) / (hi - lo)))))) : { ρ : List ℚ // rescaleToUnit_postcond numbers ρ h_precond } :=
  if h6g : (i < numbers.length) then
    match (⟨((i + 1, acc ++ [(numbers[i]! - lo) / (hi - lo)])), by refine_auto⟩ : { ρ : Nat × (List Rat) // (fun (i : Nat) (acc : List Rat) => (i ≤ numbers.length) ∧ (acc = ((numbers.take i).map (fun x => (x - lo) / (hi - lo))))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : List Rat) => numbers.length - i) (ρ).1 (ρ).2 < (numbers.length - i) }) with
    | ⟨(i', acc'), h6b⟩ => loop6 numbers lo hi h_precond h1 h3 i' acc' h6b.1
  else ⟨(acc), by first | (have hEq : i = (numbers.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by numbers.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h6b.2 | omega)


set_option maxHeartbeats 1000000 in
def rescaleToUnit_derived (numbers : List ℚ) (h_precond : rescaleToUnit_precond numbers) : { ρ : List ℚ // rescaleToUnit_postcond numbers ρ h_precond } :=
  (match ((loop2 numbers h_precond (0) (numbers[0]!) (by refine_auto)) : { lo : Rat // lo = (numbers.foldl min numbers[0]!) }) with | ⟨lo, h1⟩ => (match ((loop5 numbers lo h_precond h1 (0) (numbers[0]!) (by refine_auto)) : { hi : Rat // hi = (numbers.foldl max numbers[0]!) }) with | ⟨hi, h3⟩ => (loop6 numbers lo hi h_precond h1 h3 (0) ([]) (by refine_auto))))

def rescaleToUnit (numbers : List ℚ) (h_precond : rescaleToUnit_precond numbers) : List ℚ := (rescaleToUnit_derived numbers h_precond).val

theorem rescaleToUnit_spec_satisfied (numbers : List ℚ) (h_precond : rescaleToUnit_precond numbers) :
    rescaleToUnit_postcond numbers (rescaleToUnit numbers h_precond) h_precond := (rescaleToUnit_derived numbers h_precond).property


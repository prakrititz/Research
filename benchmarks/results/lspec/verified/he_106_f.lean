def f106_derived (n : Nat) (h_precond : f106_precond n) : { ρ : List Nat // f106_postcond n ρ h_precond } :=
  (loop1 n h_precond (0) ([]) (by refine_auto))

def f106 (n : Nat) (h_precond : f106_precond n) : List Nat := (f106_derived n h_precond).val

theorem f106_spec_satisfied (n : Nat) (h_precond : f106_precond n) :
    f106_postcond n (f106 n h_precond) h_precond := (f106_derived n h_precond).property

#print axioms f106_spec_satisfied


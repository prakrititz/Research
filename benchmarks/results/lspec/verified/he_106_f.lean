def loop1 (n : Nat) (h_precond : f106_precond n) (i : Nat) (acc : List Nat) (h1i : ((i ≤ n) ∧ (acc = ((List.range i).map (fun k => if ((k + 1) % 2) = 0 then (k + 1).factorial else ((k + 1) * (k + 2)) / 2))))) : { ρ : List Nat // f106_postcond n ρ h_precond } :=
  if h1g : (i < n) then
    match (⟨((i + 1, acc ++ [if ((i + 1) % 2) = 0 then (i + 1).factorial else ((i + 1) * (i + 2)) / 2])), by refine_auto⟩ : { ρ : Nat × (List Nat) // (fun (i : Nat) (acc : List Nat) => (i ≤ n) ∧ (acc = ((List.range i).map (fun k => if ((k + 1) % 2) = 0 then (k + 1).factorial else ((k + 1) * (k + 2)) / 2)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : List Nat) => n - i) (ρ).1 (ρ).2 < (n - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 n h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (n) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by n - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)



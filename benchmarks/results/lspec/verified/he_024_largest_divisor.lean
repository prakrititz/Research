def loop1 (n : Nat) (h_precond : largestDivisor_precond n) (d : Nat) (h1i : ((1 ≤ d) ∧ ((d < n) ∧ (∀ k, (k < n) → ((d < k) → ((n % k) ≠ 0)))))) : { ρ : Nat // largestDivisor_postcond n ρ h_precond } :=
  if h1g : ((n % d) ≠ 0) then
    match (⟨(d - 1), by refine_auto⟩ : { ρ : Nat // (fun (d : Nat) => (1 ≤ d) ∧ ((d < n) ∧ (∀ k, (k < n) → ((d < k) → ((n % k) ≠ 0))))) (ρ) ∧ (fun (d : Nat) => d) (ρ) < (d) }) with
    | ⟨d', h1b⟩ => loop1 n h_precond d' h1b.1
  else ⟨(d), by refine_auto⟩
termination_by d
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def largestDivisor_derived (n : Nat) (h_precond : largestDivisor_precond n) : { ρ : Nat // largestDivisor_postcond n ρ h_precond } :=
  (loop1 n h_precond (n - 1) (by refine_auto))

def largestDivisor (n : Nat) (h_precond : largestDivisor_precond n) : Nat := (largestDivisor_derived n h_precond).val

theorem largestDivisor_spec_satisfied (n : Nat) (h_precond : largestDivisor_precond n) :
    largestDivisor_postcond n (largestDivisor n h_precond) h_precond := (largestDivisor_derived n h_precond).property

#print axioms largestDivisor_spec_satisfied


def loop3 (numbers : List ℚ) (threshold : ℚ) (j : Nat) (found : Bool) (h_precond : hasCloseElements_precond numbers threshold) (h1i : ((j ≤ numbers.length) ∧ ((found = true) ↔ (∃ b, (b < j) ∧ (∃ a, (a < b) ∧ (|numbers[a]! - numbers[b]!| < threshold)))))) (h1g : (j < numbers.length)) (i : Nat) (seen : Bool) (h3i : ((i ≤ j) ∧ ((seen = true) ↔ (∃ a, (a < i) ∧ (|numbers[a]! - numbers[j]!| < threshold))))) : { ρ : Bool // (fun (hit : Bool) => (hit = true) ↔ (∃ a, (a < j) ∧ (|numbers[a]! - numbers[j]!| < threshold))) ρ } :=
  if h3g : (i < j) then
    match (⟨((i + 1, seen || (decide (|numbers[i]! - numbers[j]!| < threshold)))), by refine_auto⟩ : { ρ : Nat × Bool // (fun (i : Nat) (seen : Bool) => (i ≤ j) ∧ ((seen = true) ↔ (∃ a, (a < i) ∧ (|numbers[a]! - numbers[j]!| < threshold)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (seen : Bool) => j - i) (ρ).1 (ρ).2 < (j - i) }) with
    | ⟨(i', seen'), h3b⟩ => loop3 numbers threshold j found h_precond h1i h1g i' seen' h3b.1
  else ⟨(seen), by first | (have hEq : i = (j) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by j - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h3b.2 | omega)

def loop1 (numbers : List ℚ) (threshold : ℚ) (h_precond : hasCloseElements_precond numbers threshold) (j : Nat) (found : Bool) (h1i : ((j ≤ numbers.length) ∧ ((found = true) ↔ (∃ b, (b < j) ∧ (∃ a, (a < b) ∧ (|numbers[a]! - numbers[b]!| < threshold)))))) : { ρ : Bool // hasCloseElements_postcond numbers threshold ρ h_precond } :=
  if h1g : (j < numbers.length) then
    match ((match ((loop3 numbers threshold j found h_precond h1i h1g (0) (false) (by refine_auto)) : { hit : Bool // (hit = true) ↔ (∃ a, (a < j) ∧ (|numbers[a]! - numbers[j]!| < threshold)) }) with | ⟨hit, h2⟩ => ⟨((j + 1, found || hit)), by refine_auto⟩) : { ρ : Nat × Bool // (fun (j : Nat) (found : Bool) => (j ≤ numbers.length) ∧ ((found = true) ↔ (∃ b, (b < j) ∧ (∃ a, (a < b) ∧ (|numbers[a]! - numbers[b]!| < threshold))))) (ρ).1 (ρ).2 ∧ (fun (j : Nat) (found : Bool) => numbers.length - j) (ρ).1 (ρ).2 < (numbers.length - j) }) with
    | ⟨(j', found'), h1b⟩ => loop1 numbers threshold h_precond j' found' h1b.1
  else ⟨(found), by first | (have hEq : j = (numbers.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by numbers.length - j
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def hasCloseElements_derived (numbers : List ℚ) (threshold : ℚ) (h_precond : hasCloseElements_precond numbers threshold) : { ρ : Bool // hasCloseElements_postcond numbers threshold ρ h_precond } :=
  (loop1 numbers threshold h_precond (0) (false) (by refine_auto))

def hasCloseElements (numbers : List ℚ) (threshold : ℚ) (h_precond : hasCloseElements_precond numbers threshold) : Bool := (hasCloseElements_derived numbers threshold h_precond).val

theorem hasCloseElements_spec_satisfied (numbers : List ℚ) (threshold : ℚ) (h_precond : hasCloseElements_precond numbers threshold) :
    hasCloseElements_postcond numbers threshold (hasCloseElements numbers threshold h_precond) h_precond := (hasCloseElements_derived numbers threshold h_precond).property


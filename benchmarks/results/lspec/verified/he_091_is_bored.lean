set_option maxHeartbeats 1000000 in
def isBored_derived (S : String) (h_precond : isBored_precond S) : { ρ : Nat // isBored_postcond S ρ h_precond } :=
  ⟨((((((S.replace "?" ".").replace "!" ".").splitOn ".").map String.trim).filter (fun t => t.startsWith "I ")).length), by refine_auto⟩

def isBored (S : String) (h_precond : isBored_precond S) : Nat := (isBored_derived S h_precond).val

theorem isBored_spec_satisfied (S : String) (h_precond : isBored_precond S) :
    isBored_postcond S (isBored S h_precond) h_precond := (isBored_derived S h_precond).property

#print axioms isBored_spec_satisfied


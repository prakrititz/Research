def splitWords_derived (txt : String) (h_precond : splitWords_precond txt) : { ρ : List String ⊕ Nat // splitWords_postcond txt ρ h_precond } :=
  (match (⟨(txt.toList.any (fun c => (((c == ' ') || (c == '\n')) || (c == '\r')) || (c == '\t'))), by refine_auto⟩ : { hasWhite : Bool // hasWhite = (txt.toList.any (fun c => (((c == ' ') || (c == '\n')) || (c == '\r')) || (c == '\t'))) }) with | ⟨hasWhite, h1⟩ => ⟨(if hasWhite = true then Sum.inl (splitWhite txt) else if txt.toList.contains ',' then Sum.inl (txt.splitOn ",") else Sum.inr (txt.toList.filter (fun c => c.isLower && (((c.toNat - 97) % 2) = 1))).length), by refine_auto⟩)

def splitWords (txt : String) (h_precond : splitWords_precond txt) : List String ⊕ Nat := (splitWords_derived txt h_precond).val

theorem splitWords_spec_satisfied (txt : String) (h_precond : splitWords_precond txt) :
    splitWords_postcond txt (splitWords txt h_precond) h_precond := (splitWords_derived txt h_precond).property

#print axioms splitWords_spec_satisfied


def loop1 (grades : List ℚ) (h_precond : numericalLetterGrade_precond grades) (i : Nat) (acc : List String) (h1i : ((i ≤ grades.length) ∧ (acc = ((List.range i).map (fun k => letterGrade grades[k]!))))) : { ρ : List String // numericalLetterGrade_postcond grades ρ h_precond } :=
  if h1g : (i < grades.length) then
    match (⟨((i + 1, acc ++ [letterGrade grades[i]!])), by refine_auto⟩ : { ρ : Nat × (List String) // (fun (i : Nat) (acc : List String) => (i ≤ grades.length) ∧ (acc = ((List.range i).map (fun k => letterGrade grades[k]!)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : List String) => grades.length - i) (ρ).1 (ρ).2 < (grades.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 grades h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (grades.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by grades.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def numericalLetterGrade_derived (grades : List ℚ) (h_precond : numericalLetterGrade_precond grades) : { ρ : List String // numericalLetterGrade_postcond grades ρ h_precond } :=
  (loop1 grades h_precond (0) ([]) (by refine_auto))

def numericalLetterGrade (grades : List ℚ) (h_precond : numericalLetterGrade_precond grades) : List String := (numericalLetterGrade_derived grades h_precond).val

theorem numericalLetterGrade_spec_satisfied (grades : List ℚ) (h_precond : numericalLetterGrade_precond grades) :
    numericalLetterGrade_postcond grades (numericalLetterGrade grades h_precond) h_precond := (numericalLetterGrade_derived grades h_precond).property


def loop1 (arr : List Int) (h_precond : countNums_precond arr) (i : Nat) (acc : Nat) (h1i : ((i ≤ arr.length) ∧ (acc = ((arr.take i).filter (fun x => (signedDigitSum x) > 0)).length))) : { ρ : Nat // countNums_postcond arr ρ h_precond } :=
  if h1g : (i < arr.length) then
    match (⟨((i + 1, if (signedDigitSum arr[i]!) > 0 then acc + 1 else acc)), by refine_auto⟩ : { ρ : Nat × Nat // (fun (i : Nat) (acc : Nat) => (i ≤ arr.length) ∧ (acc = ((arr.take i).filter (fun x => (signedDigitSum x) > 0)).length)) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : Nat) => arr.length - i) (ρ).1 (ρ).2 < (arr.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 arr h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (arr.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by arr.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def countNums_derived (arr : List Int) (h_precond : countNums_precond arr) : { ρ : Nat // countNums_postcond arr ρ h_precond } :=
  (loop1 arr h_precond (0) (0) (by refine_auto))

def countNums (arr : List Int) (h_precond : countNums_precond arr) : Nat := (countNums_derived arr h_precond).val

theorem countNums_spec_satisfied (arr : List Int) (h_precond : countNums_precond arr) :
    countNums_postcond arr (countNums arr h_precond) h_precond := (countNums_derived arr h_precond).property


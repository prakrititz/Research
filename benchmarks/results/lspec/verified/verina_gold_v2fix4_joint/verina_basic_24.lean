def loop2 (a : Array Int) (h_precond : firstEvenOddDifference_precond a) (n : Nat) (h2i : ((n ≤ a.size) ∧ (∀ k, (k < n) → ((isOdd a[k]!) = true)))) : { ρ : Nat // (fun (ie : Nat) => (ie < a.size) ∧ (((isEven a[ie]!) = true) ∧ (∀ k, (k < ie) → ((isOdd a[k]!) = true)))) ρ } :=
  if h2g : ((n < a.size) ∧ ((isOdd a[n]!) = true)) then
    match (⟨(n + 1), by refine_auto⟩ : { ρ : Nat // (fun (n : Nat) => (n ≤ a.size) ∧ (∀ k, (k < n) → ((isOdd a[k]!) = true))) (ρ) ∧ (fun (n : Nat) => a.size - n) (ρ) < (a.size - n) }) with
    | ⟨n', h2b⟩ => loop2 a h_precond n' h2b.1
  else ⟨(n), by refine_auto⟩
termination_by a.size - n
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h2b.2 | omega)

def loop5 (a : Array Int) (ie : Nat) (h_precond : firstEvenOddDifference_precond a) (h1 : ((ie < a.size) ∧ (((isEven a[ie]!) = true) ∧ (∀ k, (k < ie) → ((isOdd a[k]!) = true))))) (n : Nat) (h5i : ((n ≤ a.size) ∧ (∀ k, (k < n) → ((isEven a[k]!) = true)))) : { ρ : Nat // (fun (jo : Nat) => (jo < a.size) ∧ (((isOdd a[jo]!) = true) ∧ (∀ k, (k < jo) → ((isEven a[k]!) = true)))) ρ } :=

set_option maxHeartbeats 1000000 in
def mostFrequent_derived (xs : List Int) (h_precond : mostFrequent_precond xs) : { ρ : Int // mostFrequent_postcond xs ρ h_precond } :=
  ⟨((xs.find? (fun x => decide ((xs.countP (fun y => y = x)) = ((xs.map (fun x => xs.countP (fun y => y = x))).foldl max 0)))).getD 0), by refine_auto⟩

def mostFrequent (xs : List Int) (h_precond : mostFrequent_precond xs) : Int := (mostFrequent_derived xs h_precond).val

theorem mostFrequent_spec_satisfied (xs : List Int) (h_precond : mostFrequent_precond xs) :
    mostFrequent_postcond xs (mostFrequent xs h_precond) h_precond := (mostFrequent_derived xs h_precond).property

#print axioms mostFrequent_spec_satisfied


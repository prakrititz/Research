def sortThird_derived (l : List Int) (h_precond : sortThird_precond l) : { ρ : List Int // sortThird_postcond l ρ h_precond } :=
  ⟨((List.range l.length).map (fun i => if (i % 3) = 0 then ((atMod 3 l).mergeSort (fun a b => decide (a ≤ b)))[i / 3]! else l[i]!)), by refine_auto⟩

def sortThird (l : List Int) (h_precond : sortThird_precond l) : List Int := (sortThird_derived l h_precond).val

theorem sortThird_spec_satisfied (l : List Int) (h_precond : sortThird_precond l) :
    sortThird_postcond l (sortThird l h_precond) h_precond := (sortThird_derived l h_precond).property

#print axioms sortThird_spec_satisfied


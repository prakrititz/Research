def loop1 (lst : List String) (h_precond : oddCount_precond lst) (i : Nat) (acc : List String) (h1i : ((i ≤ lst.length) ∧ (acc = ((List.range i).map (fun k => oddMsg (oddDigits lst[k]!)))))) : { ρ : List String // oddCount_postcond lst ρ h_precond } :=
  if h1g : (i < lst.length) then
    match (⟨((i + 1, acc ++ [oddMsg (oddDigits lst[i]!)])), by refine_auto⟩ : { ρ : Nat × (List String) // (fun (i : Nat) (acc : List String) => (i ≤ lst.length) ∧ (acc = ((List.range i).map (fun k => oddMsg (oddDigits lst[k]!))))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : List String) => lst.length - i) (ρ).1 (ρ).2 < (lst.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 lst h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (lst.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by lst.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def oddCount_derived (lst : List String) (h_precond : oddCount_precond lst) : { ρ : List String // oddCount_postcond lst ρ h_precond } :=
  (loop1 lst h_precond (0) ([]) (by refine_auto))

def oddCount (lst : List String) (h_precond : oddCount_precond lst) : List String := (oddCount_derived lst h_precond).val

theorem oddCount_spec_satisfied (lst : List String) (h_precond : oddCount_precond lst) :
    oddCount_postcond lst (oddCount lst h_precond) h_precond := (oddCount_derived lst h_precond).property

#print axioms oddCount_spec_satisfied


def loop1 (s : String) (h_precond : countUpper_precond s) (i : Nat) (acc : Nat) (h1i : ((i ≤ s.length) ∧ (acc = ((List.range i).filter (fun j => ((j % 2) = 0) ∧ (s.toList[j]! ∈ ['A', 'E', 'I', 'O', 'U']))).length))) : { ρ : Nat // countUpper_postcond s ρ h_precond } :=
  if h1g : (i < s.length) then
    match (⟨((i + 1, if ((i % 2) = 0) ∧ (s.toList[i]! ∈ ['A', 'E', 'I', 'O', 'U']) then acc + 1 else acc)), by refine_auto⟩ : { ρ : Nat × Nat // (fun (i : Nat) (acc : Nat) => (i ≤ s.length) ∧ (acc = ((List.range i).filter (fun j => ((j % 2) = 0) ∧ (s.toList[j]! ∈ ['A', 'E', 'I', 'O', 'U']))).length)) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : Nat) => s.length - i) (ρ).1 (ρ).2 < (s.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 s h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (s.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by s.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def countUpper_derived (s : String) (h_precond : countUpper_precond s) : { ρ : Nat // countUpper_postcond s ρ h_precond } :=
  (loop1 s h_precond (0) (0) (by refine_auto))

def countUpper (s : String) (h_precond : countUpper_precond s) : Nat := (countUpper_derived s h_precond).val

theorem countUpper_spec_satisfied (s : String) (h_precond : countUpper_precond s) :
    countUpper_postcond s (countUpper s h_precond) h_precond := (countUpper_derived s h_precond).property

#print axioms countUpper_spec_satisfied


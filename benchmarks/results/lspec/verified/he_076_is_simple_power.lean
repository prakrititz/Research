def loop1 (x : Int) (n : Int) (h_precond : isSimplePower_precond x n) (i : Nat) (f : Bool) (h1i : ((i ≤ (x.natAbs + 3)) ∧ ((f = true) ↔ (∃ k, (k < i) ∧ ((1 ≤ k) ∧ ((n ^ k) = x)))))) : { ρ : Bool // isSimplePower_postcond x n ρ h_precond } :=
  if h1g : (i < (x.natAbs + 3)) then
    match (⟨((i + 1, f || (decide ((1 ≤ i) ∧ ((n ^ i) = x))))), by refine_auto⟩ : { ρ : Nat × Bool // (fun (i : Nat) (f : Bool) => (i ≤ (x.natAbs + 3)) ∧ ((f = true) ↔ (∃ k, (k < i) ∧ ((1 ≤ k) ∧ ((n ^ k) = x))))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (f : Bool) => (x.natAbs + 3) - i) (ρ).1 (ρ).2 < ((x.natAbs + 3) - i) }) with
    | ⟨(i', f'), h1b⟩ => loop1 x n h_precond i' f' h1b.1
  else ⟨((decide (x = 1)) || f), by first | (have hEq : i = ((x.natAbs + 3)) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by (x.natAbs + 3) - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def isSimplePower_derived (x : Int) (n : Int) (h_precond : isSimplePower_precond x n) : { ρ : Bool // isSimplePower_postcond x n ρ h_precond } :=
  (loop1 x n h_precond (0) (false) (by refine_auto))

def isSimplePower (x : Int) (n : Int) (h_precond : isSimplePower_precond x n) : Bool := (isSimplePower_derived x n h_precond).val

theorem isSimplePower_spec_satisfied (x : Int) (n : Int) (h_precond : isSimplePower_precond x n) :
    isSimplePower_postcond x n (isSimplePower x n h_precond) h_precond := (isSimplePower_derived x n h_precond).property

#print axioms isSimplePower_spec_satisfied


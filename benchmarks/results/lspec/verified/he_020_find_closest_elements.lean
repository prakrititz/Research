theorem closest_no : ∀ (numbers : List Rat) (i : Nat) (j : Nat) (lo : Rat) (hi : Rat), (i < j) → ((j < numbers.length) → ((((lo ≤ hi) ∧ ((∃ b, (b < (j + 1)) ∧ (∃ a, (a < b) ∧ (((lo = numbers[a]!) ∧ (hi = numbers[b]!)) ∨ ((lo = numbers[b]!) ∧ (hi = numbers[a]!))))) ∧ ((∀ b, (b < j) → (∀ a, (a < b) → ((hi - lo) ≤ |numbers[a]! - numbers[b]!|))) ∧ (∀ a, (a < i) → ((hi - lo) ≤ |numbers[a]! - numbers[j]!|))))) ∧ (i ≤ j)) → ((¬ (|numbers[i]! - numbers[j]!| < (hi - lo))) → (((lo ≤ hi) ∧ ((∃ b, (b < (j + 1)) ∧ (∃ a, (a < b) ∧ (((lo = numbers[a]!) ∧ (hi = numbers[b]!)) ∨ ((lo = numbers[b]!) ∧ (hi = numbers[a]!))))) ∧ ((∀ b, (b < j) → (∀ a, (a < b) → ((hi - lo) ≤ |numbers[a]! - numbers[b]!|))) ∧ (∀ a, (a < (i + 1)) → ((hi - lo) ≤ |numbers[a]! - numbers[j]!|))))) ∧ ((i + 1) ≤ j))))) := by
  intro numbers i j lo hi hij hj ⟨⟨hle, hex, hbest, hall⟩, hi'⟩ hc

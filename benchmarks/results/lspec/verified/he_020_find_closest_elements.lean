theorem closest_inner_init : ∀ (numbers : List Rat) (j : Nat) (lo : Rat) (hi : Rat), (((lo ≤ hi) ∧ ((∃ b, (b < j) ∧ (∃ a, (a < b) ∧ (((lo = numbers[a]!) ∧ (hi = numbers[b]!)) ∨ ((lo = numbers[b]!) ∧ (hi = numbers[a]!))))) ∧ (∀ b, (b < j) → (∀ a, (a < b) → ((hi - lo) ≤ |numbers[a]! - numbers[b]!|))))) ∧ ((2 ≤ j) ∧ (j ≤ numbers.length))) → (((lo ≤ hi) ∧ ((∃ b, (b < (j + 1)) ∧ (∃ a, (a < b) ∧ (((lo = numbers[a]!) ∧ (hi = numbers[b]!)) ∨ ((lo = numbers[b]!) ∧ (hi = numbers[a]!))))) ∧ ((∀ b, (b < j) → (∀ a, (a < b) → ((hi - lo) ≤ |numbers[a]! - numbers[b]!|))) ∧ (∀ a, (a < 0) → ((hi - lo) ≤ |numbers[a]! - numbers[j]!|))))) ∧ (0 ≤ j)) := by
  intro numbers j lo hi ⟨⟨hle, hex, hbest⟩, _, _⟩

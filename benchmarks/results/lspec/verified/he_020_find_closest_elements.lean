theorem closest_yes : ∀ (numbers : List Rat) (i : Nat) (j : Nat) (lo : Rat) (hi : Rat), (i < j) → ((j < numbers.length) → ((((lo ≤ hi) ∧ ((∃ b, (b < (j + 1)) ∧ (∃ a, (a < b) ∧ (((lo = numbers[a]!) ∧ (hi = numbers[b]!)) ∨ ((lo = numbers[b]!) ∧ (hi = numbers[a]!))))) ∧ ((∀ b, (b < j) → (∀ a, (a < b) → ((hi - lo) ≤ |numbers[a]! - numbers[b]!|))) ∧ (∀ a, (a < i) → ((hi - lo) ≤ |numbers[a]! - numbers[j]!|))))) ∧ (i ≤ j)) → ((|numbers[i]! - numbers[j]!| < (hi - lo)) → ((((min numbers[i]! numbers[j]!) ≤ (max numbers[i]! numbers[j]!)) ∧ ((∃ b, (b < (j + 1)) ∧ (∃ a, (a < b) ∧ ((((min numbers[i]! numbers[j]!) = numbers[a]!) ∧ ((max numbers[i]! numbers[j]!) = numbers[b]!)) ∨ (((min numbers[i]! numbers[j]!) = numbers[b]!) ∧ ((max numbers[i]! numbers[j]!) = numbers[a]!))))) ∧ ((∀ b, (b < j) → (∀ a, (a < b) → (((max numbers[i]! numbers[j]!) - (min numbers[i]! numbers[j]!)) ≤ |numbers[a]! - numbers[b]!|))) ∧ (∀ a, (a < (i + 1)) → (((max numbers[i]! numbers[j]!) - (min numbers[i]! numbers[j]!)) ≤ |numbers[a]! - numbers[j]!|))))) ∧ ((i + 1) ≤ j))))) := by
  intro numbers i j lo hi hij hj ⟨⟨hle, hex, hbest, hall⟩, hi'⟩ hc
  have hm := maxmin_abs numbers[i]! numbers[j]!
  have hmle : min numbers[i]! numbers[j]! ≤ max numbers[i]! numbers[j]! := le_trans (min_le_left _ _) (le_max_left _ _)
  refine ⟨⟨hmle, ?_, ?_, ?_⟩, by omega⟩
  · refine ⟨j, by omega, i, hij, ?_⟩
    rcases le_total numbers[i]! numbers[j]! with h | h
    · left; exact ⟨min_eq_left h, max_eq_right h⟩
    · right; exact ⟨min_eq_right h, max_eq_left h⟩
  · intro b hb a ha
    have := hbest b hb a ha
    linarith
  · intro a ha
    by_cases hai : a < i
    · have := hall a hai
      linarith
    · have : a = i := by omega
      subst this
      linarith


theorem closest_outer : ∀ (numbers : List Rat) (j : Nat) (lo : Rat) (hi : Rat), (j < numbers.length) → ((((lo ≤ hi) ∧ ((∃ b, (b < (j + 1)) ∧ (∃ a, (a < b) ∧ (((lo = numbers[a]!) ∧ (hi = numbers[b]!)) ∨ ((lo = numbers[b]!) ∧ (hi = numbers[a]!))))) ∧ ((∀ b, (b < j) → (∀ a, (a < b) → ((hi - lo) ≤ |numbers[a]! - numbers[b]!|))) ∧ (∀ a, (a < j) → ((hi - lo) ≤ |numbers[a]! - numbers[j]!|))))) ∧ (j ≤ j)) → ((2 ≤ j) → (((lo ≤ hi) ∧ ((∃ b, (b < (j + 1)) ∧ (∃ a, (a < b) ∧ (((lo = numbers[a]!) ∧ (hi = numbers[b]!)) ∨ ((lo = numbers[b]!) ∧ (hi = numbers[a]!))))) ∧ (∀ b, (b < (j + 1)) → (∀ a, (a < b) → ((hi - lo) ≤ |numbers[a]! - numbers[b]!|))))) ∧ ((2 ≤ (j + 1)) ∧ ((j + 1) ≤ numbers.length))))) := by
  intro numbers j lo hi hj ⟨⟨hle, hex, hbest, hall⟩, _⟩ h2
  refine ⟨⟨hle, hex, ?_⟩, by omega, by omega⟩

theorem closest_init : ∀ (numbers : List Rat), (numbers.length ≥ 2) → ((((min numbers[0]! numbers[1]!) ≤ (max numbers[0]! numbers[1]!)) ∧ ((∃ b, (b < 2) ∧ (∃ a, (a < b) ∧ ((((min numbers[0]! numbers[1]!) = numbers[a]!) ∧ ((max numbers[0]! numbers[1]!) = numbers[b]!)) ∨ (((min numbers[0]! numbers[1]!) = numbers[b]!) ∧ ((max numbers[0]! numbers[1]!) = numbers[a]!))))) ∧ (∀ b, (b < 2) → (∀ a, (a < b) → (((max numbers[0]! numbers[1]!) - (min numbers[0]! numbers[1]!)) ≤ |numbers[a]! - numbers[b]!|))))) ∧ ((2 ≤ 2) ∧ (2 ≤ numbers.length))) := by
  intro numbers hl
  have hm := maxmin_abs numbers[0]! numbers[1]!
  have hmle : min numbers[0]! numbers[1]! ≤ max numbers[0]! numbers[1]! := le_trans (min_le_left _ _) (le_max_left _ _)
  refine ⟨⟨hmle, ?_, ?_⟩, by omega, by omega⟩
  · refine ⟨1, by omega, 0, by omega, ?_⟩
    rcases le_total numbers[0]! numbers[1]! with h | h
    · left; exact ⟨min_eq_left h, max_eq_right h⟩
    · right; exact ⟨min_eq_right h, max_eq_left h⟩
  · intro b hb a ha
    have : b = 1 := by omega
    subst this
    have : a = 0 := by omega
    subst this
    linarith


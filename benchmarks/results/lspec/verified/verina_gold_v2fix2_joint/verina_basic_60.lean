def FindEvenNumbers_derived (arr : Array Int) (h_precond : FindEvenNumbers_precond arr) : { ρ : Array Int // FindEvenNumbers_postcond arr ρ h_precond } :=
  (loop1 arr h_precond (0) (#[]) (by refine_auto))

def FindEvenNumbers (arr : Array Int) (h_precond : FindEvenNumbers_precond arr) : Array Int := (FindEvenNumbers_derived arr h_precond).val

theorem FindEvenNumbers_spec_satisfied (arr : Array Int) (h_precond : FindEvenNumbers_precond arr) :
    FindEvenNumbers_postcond arr (FindEvenNumbers arr h_precond) h_precond := (FindEvenNumbers_derived arr h_precond).property

#print axioms FindEvenNumbers_spec_satisfied

set_option maxHeartbeats 2000000 in
#eval (((FindEvenNumbers (#[1, 2, 3, 4, 5, 6]) (by first | native_decide | trivial | (norm_num [FindEvenNumbers_precond]; done) | (simp [FindEvenNumbers_precond]; done) | decide | omega | (unfold FindEvenNumbers_precond; pre_wit_search)))) == (#[2, 4, 6]))
set_option maxHeartbeats 2000000 in
#eval (((FindEvenNumbers (#[0, -2, 3, -4, 7]) (by first | native_decide | trivial | (norm_num [FindEvenNumbers_precond]; done) | (simp [FindEvenNumbers_precond]; done) | decide | omega | (unfold FindEvenNumbers_precond; pre_wit_search)))) == (#[0, -2, -4]))
set_option maxHeartbeats 2000000 in
#eval (((FindEvenNumbers (#[1, 3, 5, 7]) (by first | native_decide | trivial | (norm_num [FindEvenNumbers_precond]; done) | (simp [FindEvenNumbers_precond]; done) | decide | omega | (unfold FindEvenNumbers_precond; pre_wit_search)))) == (#[]))
set_option maxHeartbeats 2000000 in
#eval (((FindEvenNumbers (#[2, 4, 8, 10]) (by first | native_decide | trivial | (norm_num [FindEvenNumbers_precond]; done) | (simp [FindEvenNumbers_precond]; done) | decide | omega | (unfold FindEvenNumbers_precond; pre_wit_search)))) == (#[2, 4, 8, 10]))
set_option maxHeartbeats 2000000 in
#eval (((FindEvenNumbers (#[]) (by first | native_decide | trivial | (norm_num [FindEvenNumbers_precond]; done) | (simp [FindEvenNumbers_precond]; done) | decide | omega | (unfold FindEvenNumbers_precond; pre_wit_search)))) == (#[]))
set_option maxHeartbeats 2000000 in
#eval (((FindEvenNumbers (#[2, 4, 2, 6]) (by first | native_decide | trivial | (norm_num [FindEvenNumbers_precond]; done) | (simp [FindEvenNumbers_precond]; done) | decide | omega | (unfold FindEvenNumbers_precond; pre_wit_search)))) == (#[2, 4, 2, 6]))
set_option maxHeartbeats 2000000 in
#eval (((FindEvenNumbers (#[1, 2, 8, 2, 5]) (by first | native_decide | trivial | (norm_num [FindEvenNumbers_precond]; done) | (simp [FindEvenNumbers_precond]; done) | decide | omega | (unfold FindEvenNumbers_precond; pre_wit_search)))) == (#[2, 8, 2]))

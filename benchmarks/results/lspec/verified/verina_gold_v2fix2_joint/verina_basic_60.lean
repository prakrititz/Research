  if h1g : (i < arr.size) then
    match (⟨((i + 1, if isEven arr[i]! then acc.push arr[i]! else acc)), by refine_auto⟩ : { ρ : Nat × (Array Int) // (fun (i : Nat) (acc : Array Int) => (i ≤ arr.size) ∧ (acc.toList = ((arr.toList.take i).filter isEven))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : Array Int) => arr.size - i) (ρ).1 (ρ).2 < (arr.size - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 arr h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (arr.size) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by arr.size - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)



def loop1 (arr : Array Int) (elem : Int) (h_precond : lastPosition_precond arr elem) (i : Nat) (pos : Int) (h1i : ((i ≤ arr.size) ∧ (((pos = (-1)) ∨ ((0 ≤ pos) ∧ ((pos.toNat < i) ∧ (arr[pos.toNat]! = elem)))) ∧ (((pos = (-1)) → (∀ k, (k < i) → (arr[k]! ≠ elem))) ∧ ((0 ≤ pos) → (∀ k, (pos.toNat < k) → ((k < i) → (arr[k]! ≠ elem)))))))) : { ρ : Int // lastPosition_postcond arr elem ρ h_precond } :=
  if h1g : (i < arr.size) then
    match (⟨((i + 1, if arr[i]! = elem then (i : Int) else pos)), by refine_auto⟩ : { ρ : Nat × Int // (fun (i : Nat) (pos : Int) => (i ≤ arr.size) ∧ (((pos = (-1)) ∨ ((0 ≤ pos) ∧ ((pos.toNat < i) ∧ (arr[pos.toNat]! = elem)))) ∧ (((pos = (-1)) → (∀ k, (k < i) → (arr[k]! ≠ elem))) ∧ ((0 ≤ pos) → (∀ k, (pos.toNat < k) → ((k < i) → (arr[k]! ≠ elem))))))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (pos : Int) => arr.size - i) (ρ).1 (ρ).2 < (arr.size - i) }) with
    | ⟨(i', pos'), h1b⟩ => loop1 arr elem h_precond i' pos' h1b.1
  else ⟨(pos), by first | (have hEq : i = (arr.size) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by arr.size - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)



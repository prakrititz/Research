def lastPosition_derived (arr : Array Int) (elem : Int) (h_precond : lastPosition_precond arr elem) : { ρ : Int // lastPosition_postcond arr elem ρ h_precond } :=
  (loop1 arr elem h_precond (0) (-1) (by refine_auto))

def lastPosition (arr : Array Int) (elem : Int) (h_precond : lastPosition_precond arr elem) : Int := (lastPosition_derived arr elem h_precond).val

theorem lastPosition_spec_satisfied (arr : Array Int) (elem : Int) (h_precond : lastPosition_precond arr elem) :
    lastPosition_postcond arr elem (lastPosition arr elem h_precond) h_precond := (lastPosition_derived arr elem h_precond).property


def loop2 (n : Nat) (r : Nat) (h2i : ((r * r) ≤ n)) : { ρ : Nat // (fun (r : Nat) => ((r * r) ≤ n) ∧ (n < ((r + 1) * (r + 1)))) ρ } :=
  if h2g : (((r + 1) * (r + 1)) ≤ n) then
    match (⟨(r + 1), by refine_auto⟩ : { ρ : Nat // (fun (r : Nat) => (r * r) ≤ n) (ρ) ∧ (fun (r : Nat) => n - r) (ρ) < (n - r) }) with
    | ⟨r', h2b⟩ => loop2 n r' h2b.1
  else ⟨(r), by refine_auto⟩
termination_by n - r
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h2b.2 | omega)


set_option maxHeartbeats 1000000 in
def isPerfectSquare_derived (n : Nat) : { ρ : Bool // isPerfectSquare_postcond n ρ } :=
  (match ((loop2 n (0) (by refine_auto)) : { r : Nat // ((r * r) ≤ n) ∧ (n < ((r + 1) * (r + 1))) }) with | ⟨r, h1⟩ => ⟨(decide ((r * r) = n)), by refine_auto⟩)

def isPerfectSquare (n : Nat) : Bool := (isPerfectSquare_derived n).val

theorem isPerfectSquare_spec_satisfied (n : Nat) :
    isPerfectSquare_postcond n (isPerfectSquare n) := (isPerfectSquare_derived n).property

#print axioms isPerfectSquare_spec_satisfied


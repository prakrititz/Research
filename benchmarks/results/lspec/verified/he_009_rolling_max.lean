set_option maxHeartbeats 1000000 in
def rollingMax_derived (numbers : List Int) (h_precond : rollingMax_precond numbers) : { ρ : List Int // rollingMax_postcond numbers ρ h_precond } :=
  ⟨((List.range numbers.length).map (fun i => (numbers.take (i + 1)).foldl max numbers[0]!)), by refine_auto⟩

def rollingMax (numbers : List Int) (h_precond : rollingMax_precond numbers) : List Int := (rollingMax_derived numbers h_precond).val

theorem rollingMax_spec_satisfied (numbers : List Int) (h_precond : rollingMax_precond numbers) :
    rollingMax_postcond numbers (rollingMax numbers h_precond) h_precond := (rollingMax_derived numbers h_precond).property

#print axioms rollingMax_spec_satisfied


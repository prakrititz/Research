def loop1 (text : String) (h_precond : removeVowels_precond text) (i : Nat) (acc : List Char) (h1i : ((i ≤ text.length) ∧ (acc = ((text.toList.take i).filter (fun c => !(['a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'].contains c)))))) : { ρ : String // removeVowels_postcond text ρ h_precond } :=
  if h1g : (i < text.length) then
    match (⟨((i + 1, if ['a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'].contains text.toList[i]! then acc else acc ++ [text.toList[i]!])), by refine_auto⟩ : { ρ : Nat × (List Char) // (fun (i : Nat) (acc : List Char) => (i ≤ text.length) ∧ (acc = ((text.toList.take i).filter (fun c => !(['a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'].contains c))))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : List Char) => text.length - i) (ρ).1 (ρ).2 < (text.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 text h_precond i' acc' h1b.1
  else ⟨(String.mk acc), by first | (have hEq : i = (text.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by text.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def removeVowels_derived (text : String) (h_precond : removeVowels_precond text) : { ρ : String // removeVowels_postcond text ρ h_precond } :=
  (loop1 text h_precond (0) ([]) (by refine_auto))

def removeVowels (text : String) (h_precond : removeVowels_precond text) : String := (removeVowels_derived text h_precond).val

theorem removeVowels_spec_satisfied (text : String) (h_precond : removeVowels_precond text) :
    removeVowels_postcond text (removeVowels text h_precond) h_precond := (removeVowels_derived text h_precond).property


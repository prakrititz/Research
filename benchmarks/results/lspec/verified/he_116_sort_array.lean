def sortArray116_derived (arr : List Int) (h_precond : sortArray116_precond arr) : { ρ : List Int // sortArray116_postcond arr ρ h_precond } :=
  ⟨(arr.mergeSort (fun a b => (decide ((ones a) < (ones b))) || (((ones a) == (ones b)) && (decide (a ≤ b))))), by refine_auto⟩

def sortArray116 (arr : List Int) (h_precond : sortArray116_precond arr) : List Int := (sortArray116_derived arr h_precond).val

theorem sortArray116_spec_satisfied (arr : List Int) (h_precond : sortArray116_precond arr) :
    sortArray116_postcond arr (sortArray116 arr h_precond) h_precond := (sortArray116_derived arr h_precond).property


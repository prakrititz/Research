def intersection_derived (interval1 : Int × Int) (interval2 : Int × Int) (h_precond : intersection_precond interval1 interval2) : { ρ : String // intersection_postcond interval1 interval2 ρ h_precond } :=
  (if h1 : ((((min interval1.2 interval2.2) - (max interval1.1 interval2.1)) ≥ 2) ∧ (Nat.Prime ((min interval1.2 interval2.2) - (max interval1.1 interval2.1)).toNat)) then ⟨("YES"), by refine_auto⟩ else ⟨("NO"), by refine_auto⟩)

def intersection (interval1 : Int × Int) (interval2 : Int × Int) (h_precond : intersection_precond interval1 interval2) : String := (intersection_derived interval1 interval2 h_precond).val

theorem intersection_spec_satisfied (interval1 : Int × Int) (interval2 : Int × Int) (h_precond : intersection_precond interval1 interval2) :
    intersection_postcond interval1 interval2 (intersection interval1 interval2 h_precond) h_precond := (intersection_derived interval1 interval2 h_precond).property

#print axioms intersection_spec_satisfied


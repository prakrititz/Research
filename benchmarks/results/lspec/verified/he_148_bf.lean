set_option maxHeartbeats 1000000 in
def bf_derived (planet1 : String) (planet2 : String) (h_precond : bf_precond planet1 planet2) : { ρ : List String // bf_postcond planet1 planet2 ρ h_precond } :=
  (if h1 : ((planet1 ∈ solarPlanets) ∧ (planet2 ∈ solarPlanets)) then ⟨((solarPlanets.drop ((min (solarPlanets.idxOf planet1) (solarPlanets.idxOf planet2)) + 1)).take (((max (solarPlanets.idxOf planet1) (solarPlanets.idxOf planet2)) - (min (solarPlanets.idxOf planet1) (solarPlanets.idxOf planet2))) - 1)), by refine_auto⟩ else ⟨([]), by refine_auto⟩)

def bf (planet1 : String) (planet2 : String) (h_precond : bf_precond planet1 planet2) : List String := (bf_derived planet1 planet2 h_precond).val

theorem bf_spec_satisfied (planet1 : String) (planet2 : String) (h_precond : bf_precond planet1 planet2) :
    bf_postcond planet1 planet2 (bf planet1 planet2 h_precond) h_precond := (bf_derived planet1 planet2 h_precond).property

#print axioms bf_spec_satisfied


def loop2 (l : List Int) (h_precond : monotonic_precond l) (i : Nat) (ok : Bool) (h2i : ((i ≤ (l.length - 1)) ∧ ((ok = true) ↔ (∀ k, (k < i) → (l[k]! ≤ l[k + 1]!))))) : { ρ : Bool // (fun (up : Bool) => (up = true) ↔ (∀ i, (i < (l.length - 1)) → (l[i]! ≤ l[i + 1]!))) ρ } :=
  if h2g : (i < (l.length - 1)) then
    match (⟨((i + 1, ok && (decide (l[i]! ≤ l[i + 1]!)))), by refine_auto⟩ : { ρ : Nat × Bool // (fun (i : Nat) (ok : Bool) => (i ≤ (l.length - 1)) ∧ ((ok = true) ↔ (∀ k, (k < i) → (l[k]! ≤ l[k + 1]!)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (ok : Bool) => (l.length - 1) - i) (ρ).1 (ρ).2 < ((l.length - 1) - i) }) with
    | ⟨(i', ok'), h2b⟩ => loop2 l h_precond i' ok' h2b.1
  else ⟨(ok), by first | (have hEq : i = ((l.length - 1)) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by (l.length - 1) - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h2b.2 | omega)

def loop5 (l : List Int) (up : Bool) (h_precond : monotonic_precond l) (h1 : ((up = true) ↔ (∀ i, (i < (l.length - 1)) → (l[i]! ≤ l[i + 1]!)))) (i : Nat) (ok : Bool) (h5i : ((i ≤ (l.length - 1)) ∧ ((ok = true) ↔ (∀ k, (k < i) → (l[k]! ≥ l[k + 1]!))))) : { ρ : Bool // (fun (down : Bool) => (down = true) ↔ (∀ i, (i < (l.length - 1)) → (l[i]! ≥ l[i + 1]!))) ρ } :=
  if h5g : (i < (l.length - 1)) then
    match (⟨((i + 1, ok && (decide (l[i]! ≥ l[i + 1]!)))), by refine_auto⟩ : { ρ : Nat × Bool // (fun (i : Nat) (ok : Bool) => (i ≤ (l.length - 1)) ∧ ((ok = true) ↔ (∀ k, (k < i) → (l[k]! ≥ l[k + 1]!)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (ok : Bool) => (l.length - 1) - i) (ρ).1 (ρ).2 < ((l.length - 1) - i) }) with
    | ⟨(i', ok'), h5b⟩ => loop5 l up h_precond h1 i' ok' h5b.1
  else ⟨(ok), by first | (have hEq : i = ((l.length - 1)) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by (l.length - 1) - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h5b.2 | omega)


set_option maxHeartbeats 1000000 in
def monotonic_derived (l : List Int) (h_precond : monotonic_precond l) : { ρ : Bool // monotonic_postcond l ρ h_precond } :=
  (match ((loop2 l h_precond (0) (true) (by refine_auto)) : { up : Bool // (up = true) ↔ (∀ i, (i < (l.length - 1)) → (l[i]! ≤ l[i + 1]!)) }) with | ⟨up, h1⟩ => (match ((loop5 l up h_precond h1 (0) (true) (by refine_auto)) : { down : Bool // (down = true) ↔ (∀ i, (i < (l.length - 1)) → (l[i]! ≥ l[i + 1]!)) }) with | ⟨down, h3⟩ => ⟨(up || down), by refine_auto⟩))

def monotonic (l : List Int) (h_precond : monotonic_precond l) : Bool := (monotonic_derived l h_precond).val

theorem monotonic_spec_satisfied (l : List Int) (h_precond : monotonic_precond l) :
    monotonic_postcond l (monotonic l h_precond) h_precond := (monotonic_derived l h_precond).property


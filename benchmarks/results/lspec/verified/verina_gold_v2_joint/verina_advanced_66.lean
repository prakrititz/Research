set_option maxHeartbeats 1000000 in
def reverseWords_derived (words_str : String) (h_precond : reverseWords_precond words_str) : { ρ : String // reverseWords_postcond words_str ρ h_precond } :=
  ⟨(String.intercalate " " ((words_str.splitOn " ").filter (fun w => w ≠ "")).reverse), by refine_auto⟩

def reverseWords (words_str : String) (h_precond : reverseWords_precond words_str) : String := (reverseWords_derived words_str h_precond).val

theorem reverseWords_spec_satisfied (words_str : String) (h_precond : reverseWords_precond words_str) :
    reverseWords_postcond words_str (reverseWords words_str h_precond) h_precond := (reverseWords_derived words_str h_precond).property

#print axioms reverseWords_spec_satisfied


set_option maxHeartbeats 1000000 in
def semiOrderedPermutation_derived (nums : List Int) (h_precond : semiOrderedPermutation_precond nums) : { ρ : Int // semiOrderedPermutation_postcond nums ρ h_precond } :=
  (if h1 : ((nums.idxOf 1) > (nums.idxOf (Int.ofNat nums.length))) then ⟨(((((nums.idxOf 1 : Int)) + ((nums.length : Int))) - 2) - ((nums.idxOf (Int.ofNat nums.length) : Int))), by refine_auto⟩ else ⟨(((((nums.idxOf 1 : Int)) + ((nums.length : Int))) - 1) - ((nums.idxOf (Int.ofNat nums.length) : Int))), by refine_auto⟩)

def semiOrderedPermutation (nums : List Int) (h_precond : semiOrderedPermutation_precond nums) : Int := (semiOrderedPermutation_derived nums h_precond).val

theorem semiOrderedPermutation_spec_satisfied (nums : List Int) (h_precond : semiOrderedPermutation_precond nums) :
    semiOrderedPermutation_postcond nums (semiOrderedPermutation nums h_precond) h_precond := (semiOrderedPermutation_derived nums h_precond).property

#print axioms semiOrderedPermutation_spec_satisfied


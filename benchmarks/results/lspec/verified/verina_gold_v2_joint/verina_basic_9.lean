def loop3 (a : Array Int) (b : Array Int) (i : Nat) (f : Bool) (h_precond : hasCommonElement_precond a b) (h1i : ((i ≤ a.size) ∧ ((f = true) ↔ (∃ k, (k < i) ∧ (∃ j, (j < b.size) ∧ (a[k]! = b[j]!)))))) (h1g : (i < a.size)) (j : Nat) (g : Bool) (h3i : ((j ≤ b.size) ∧ ((g = true) ↔ (∃ m, (m < j) ∧ (a[i]! = b[m]!))))) : { ρ : Bool // (fun (hit : Bool) => (hit = true) ↔ (∃ j, (j < b.size) ∧ (a[i]! = b[j]!))) ρ } :=
  if h3g : (j < b.size) then
    match (⟨((j + 1, g || (decide (a[i]! = b[j]!)))), by refine_auto⟩ : { ρ : Nat × Bool // (fun (j : Nat) (g : Bool) => (j ≤ b.size) ∧ ((g = true) ↔ (∃ m, (m < j) ∧ (a[i]! = b[m]!)))) (ρ).1 (ρ).2 ∧ (fun (j : Nat) (g : Bool) => b.size - j) (ρ).1 (ρ).2 < (b.size - j) }) with
    | ⟨(j', g'), h3b⟩ => loop3 a b i f h_precond h1i h1g j' g' h3b.1
  else ⟨(g), by first | (have hEq : j = (b.size) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by b.size - j
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h3b.2 | omega)

def loop1 (a : Array Int) (b : Array Int) (h_precond : hasCommonElement_precond a b) (i : Nat) (f : Bool) (h1i : ((i ≤ a.size) ∧ ((f = true) ↔ (∃ k, (k < i) ∧ (∃ j, (j < b.size) ∧ (a[k]! = b[j]!)))))) : { ρ : Bool // hasCommonElement_postcond a b ρ h_precond } :=
  if h1g : (i < a.size) then
    match ((match ((loop3 a b i f h_precond h1i h1g (0) (false) (by refine_auto)) : { hit : Bool // (hit = true) ↔ (∃ j, (j < b.size) ∧ (a[i]! = b[j]!)) }) with | ⟨hit, h2⟩ => ⟨((i + 1, f || hit)), by refine_auto⟩) : { ρ : Nat × Bool // (fun (i : Nat) (f : Bool) => (i ≤ a.size) ∧ ((f = true) ↔ (∃ k, (k < i) ∧ (∃ j, (j < b.size) ∧ (a[k]! = b[j]!))))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (f : Bool) => a.size - i) (ρ).1 (ρ).2 < (a.size - i) }) with
    | ⟨(i', f'), h1b⟩ => loop1 a b h_precond i' f' h1b.1
  else ⟨(f), by first | (have hEq : i = (a.size) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by a.size - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)



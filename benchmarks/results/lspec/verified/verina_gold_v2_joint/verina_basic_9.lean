def hasCommonElement_derived (a : Array Int) (b : Array Int) (h_precond : hasCommonElement_precond a b) : { ρ : Bool // hasCommonElement_postcond a b ρ h_precond } :=
  (loop1 a b h_precond (0) (false) (by refine_auto))

def hasCommonElement (a : Array Int) (b : Array Int) (h_precond : hasCommonElement_precond a b) : Bool := (hasCommonElement_derived a b h_precond).val

theorem hasCommonElement_spec_satisfied (a : Array Int) (b : Array Int) (h_precond : hasCommonElement_precond a b) :
    hasCommonElement_postcond a b (hasCommonElement a b h_precond) h_precond := (hasCommonElement_derived a b h_precond).property


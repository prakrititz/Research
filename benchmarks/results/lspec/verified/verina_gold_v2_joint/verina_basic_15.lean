def loop1 (a : Array Int) (h_precond : containsConsecutiveNumbers_precond a) (i : Nat) (f : Bool) (h1i : ((i ≤ (a.size - 1)) ∧ ((f = true) ↔ (∃ k, (k < i) ∧ ((a[k]! + 1) = a[k + 1]!))))) : { ρ : Bool // containsConsecutiveNumbers_postcond a ρ h_precond } :=
  if h1g : (i < (a.size - 1)) then
    match (⟨((i + 1, f || (decide ((a[i]! + 1) = a[i + 1]!)))), by refine_auto⟩ : { ρ : Nat × Bool // (fun (i : Nat) (f : Bool) => (i ≤ (a.size - 1)) ∧ ((f = true) ↔ (∃ k, (k < i) ∧ ((a[k]! + 1) = a[k + 1]!)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (f : Bool) => (a.size - 1) - i) (ρ).1 (ρ).2 < ((a.size - 1) - i) }) with
    | ⟨(i', f'), h1b⟩ => loop1 a h_precond i' f' h1b.1
  else ⟨(f), by first | (have hEq : i = ((a.size - 1)) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by (a.size - 1) - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def containsConsecutiveNumbers_derived (a : Array Int) (h_precond : containsConsecutiveNumbers_precond a) : { ρ : Bool // containsConsecutiveNumbers_postcond a ρ h_precond } :=
  (loop1 a h_precond (0) (false) (by refine_auto))

def containsConsecutiveNumbers (a : Array Int) (h_precond : containsConsecutiveNumbers_precond a) : Bool := (containsConsecutiveNumbers_derived a h_precond).val

theorem containsConsecutiveNumbers_spec_satisfied (a : Array Int) (h_precond : containsConsecutiveNumbers_precond a) :
    containsConsecutiveNumbers_postcond a (containsConsecutiveNumbers a h_precond) h_precond := (containsConsecutiveNumbers_derived a h_precond).property

#print axioms containsConsecutiveNumbers_spec_satisfied


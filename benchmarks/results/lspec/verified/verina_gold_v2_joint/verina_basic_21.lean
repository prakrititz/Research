def loop1 (sub : List Int) (main : List Int) (h_precond : isSublist_precond sub main) (i : Nat) (f : Bool) (h1i : ((i ≤ (main.length + 1)) ∧ ((f = true) ↔ (∃ k, (k < i) ∧ (((k + sub.length) ≤ main.length) ∧ (sub = ((main.drop k).take sub.length))))))) : { ρ : Bool // isSublist_postcond sub main ρ h_precond } :=
  if h1g : (i < (main.length + 1)) then
    match (⟨((i + 1, f || (decide (((i + sub.length) ≤ main.length) ∧ (sub = ((main.drop i).take sub.length)))))), by refine_auto⟩ : { ρ : Nat × Bool // (fun (i : Nat) (f : Bool) => (i ≤ (main.length + 1)) ∧ ((f = true) ↔ (∃ k, (k < i) ∧ (((k + sub.length) ≤ main.length) ∧ (sub = ((main.drop k).take sub.length)))))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (f : Bool) => (main.length + 1) - i) (ρ).1 (ρ).2 < ((main.length + 1) - i) }) with
    | ⟨(i', f'), h1b⟩ => loop1 sub main h_precond i' f' h1b.1
  else ⟨(f), by first | (have hEq : i = ((main.length + 1)) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by (main.length + 1) - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def isSublist_derived (sub : List Int) (main : List Int) (h_precond : isSublist_precond sub main) : { ρ : Bool // isSublist_postcond sub main ρ h_precond } :=
  (loop1 sub main h_precond (0) (false) (by refine_auto))

def isSublist (sub : List Int) (main : List Int) (h_precond : isSublist_precond sub main) : Bool := (isSublist_derived sub main h_precond).val

theorem isSublist_spec_satisfied (sub : List Int) (main : List Int) (h_precond : isSublist_precond sub main) :
    isSublist_postcond sub main (isSublist sub main h_precond) h_precond := (isSublist_derived sub main h_precond).property

#print axioms isSublist_spec_satisfied


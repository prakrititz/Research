def loop1 (s : List Nat) (h_precond : smallestMissingNumber_precond s) (v : Nat) (h1i : (∀ k, (k < v) → ((List.elem k s) = true))) : { ρ : Nat // smallestMissingNumber_postcond s ρ h_precond } :=
  if h1g : ((List.elem v s) = true) then
    match (⟨(v + 1), by refine_auto⟩ : { ρ : Nat // (fun (v : Nat) => ∀ k, (k < v) → ((List.elem k s) = true)) (ρ) ∧ (fun (v : Nat) => ((s.foldl max 0) + 1) - v) (ρ) < (((s.foldl max 0) + 1) - v) }) with
    | ⟨v', h1b⟩ => loop1 s h_precond v' h1b.1
  else ⟨(v), by refine_auto⟩
termination_by ((s.foldl max 0) + 1) - v
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def smallestMissingNumber_derived (s : List Nat) (h_precond : smallestMissingNumber_precond s) : { ρ : Nat // smallestMissingNumber_postcond s ρ h_precond } :=
  (loop1 s h_precond (0) (by refine_auto))

def smallestMissingNumber (s : List Nat) (h_precond : smallestMissingNumber_precond s) : Nat := (smallestMissingNumber_derived s h_precond).val

theorem smallestMissingNumber_spec_satisfied (s : List Nat) (h_precond : smallestMissingNumber_precond s) :
    smallestMissingNumber_postcond s (smallestMissingNumber s h_precond) h_precond := (smallestMissingNumber_derived s h_precond).property


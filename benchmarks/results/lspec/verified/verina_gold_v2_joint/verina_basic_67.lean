def loop1 (x : List Char) (h_precond : IsPalindrome_precond x) (i : Nat) (ok : Bool) (h1i : ((i ≤ x.length) ∧ ((ok = true) ↔ (∀ k, (k < i) → (x[k]! = x[(x.length - k) - 1]!))))) : { ρ : Bool // IsPalindrome_postcond x ρ h_precond } :=
  if h1g : (i < x.length) then
    match (⟨((i + 1, ok && (decide (x[i]! = x[(x.length - i) - 1]!)))), by refine_auto⟩ : { ρ : Nat × Bool // (fun (i : Nat) (ok : Bool) => (i ≤ x.length) ∧ ((ok = true) ↔ (∀ k, (k < i) → (x[k]! = x[(x.length - k) - 1]!)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (ok : Bool) => x.length - i) (ρ).1 (ρ).2 < (x.length - i) }) with
    | ⟨(i', ok'), h1b⟩ => loop1 x h_precond i' ok' h1b.1
  else ⟨(ok), by first | (have hEq : i = (x.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by x.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def IsPalindrome_derived (x : List Char) (h_precond : IsPalindrome_precond x) : { ρ : Bool // IsPalindrome_postcond x ρ h_precond } :=
  (loop1 x h_precond (0) (true) (by refine_auto))

def IsPalindrome (x : List Char) (h_precond : IsPalindrome_precond x) : Bool := (IsPalindrome_derived x h_precond).val

theorem IsPalindrome_spec_satisfied (x : List Char) (h_precond : IsPalindrome_precond x) :
    IsPalindrome_postcond x (IsPalindrome x h_precond) h_precond := (IsPalindrome_derived x h_precond).property

#print axioms IsPalindrome_spec_satisfied


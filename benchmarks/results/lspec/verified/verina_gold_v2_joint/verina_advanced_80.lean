def twoSum_derived (nums : Array Int) (target : Int) (h_precond : twoSum_precond nums target) : { ρ : Array Nat // twoSum_postcond nums target ρ h_precond } :=
  (loop1 nums target h_precond (0) (0) (0) (false) (by refine_auto))

def twoSum (nums : Array Int) (target : Int) (h_precond : twoSum_precond nums target) : Array Nat := (twoSum_derived nums target h_precond).val

theorem twoSum_spec_satisfied (nums : Array Int) (target : Int) (h_precond : twoSum_precond nums target) :
    twoSum_postcond nums target (twoSum nums target h_precond) h_precond := (twoSum_derived nums target h_precond).property


def loop2 (a : Array Int) (h_precond : findFirstOdd_precond a) (n : Nat) (h2i : ((n ≤ a.size) ∧ (∀ j, (j < n) → (¬ ((isOdd a[j]!) = true))))) : { ρ : Nat // (fun (p : Nat) => (p ≤ a.size) ∧ ((∀ j, (j < p) → (¬ ((isOdd a[j]!) = true))) ∧ ((p < a.size) → ((isOdd a[p]!) = true)))) ρ } :=
  if h2g : ((n < a.size) ∧ (¬ ((isOdd a[n]!) = true))) then
    match (⟨(n + 1), by refine_auto⟩ : { ρ : Nat // (fun (n : Nat) => (n ≤ a.size) ∧ (∀ j, (j < n) → (¬ ((isOdd a[j]!) = true)))) (ρ) ∧ (fun (n : Nat) => a.size - n) (ρ) < (a.size - n) }) with
    | ⟨n', h2b⟩ => loop2 a h_precond n' h2b.1
  else ⟨(n), by refine_auto⟩
termination_by a.size - n
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h2b.2 | omega)


set_option maxHeartbeats 1000000 in
def findFirstOdd_derived (a : Array Int) (h_precond : findFirstOdd_precond a) : { ρ : Option Nat // findFirstOdd_postcond a ρ h_precond } :=
  (match ((loop2 a h_precond (0) (by refine_auto)) : { p : Nat // (p ≤ a.size) ∧ ((∀ j, (j < p) → (¬ ((isOdd a[j]!) = true))) ∧ ((p < a.size) → ((isOdd a[p]!) = true))) }) with | ⟨p, h1⟩ => (if h3 : (p < a.size) then ⟨(some p), by refine_auto⟩ else ⟨(none), by refine_auto⟩))

def findFirstOdd (a : Array Int) (h_precond : findFirstOdd_precond a) : Option Nat := (findFirstOdd_derived a h_precond).val

theorem findFirstOdd_spec_satisfied (a : Array Int) (h_precond : findFirstOdd_precond a) :
    findFirstOdd_postcond a (findFirstOdd a h_precond) h_precond := (findFirstOdd_derived a h_precond).property


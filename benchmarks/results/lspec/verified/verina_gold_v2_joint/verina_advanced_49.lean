def mergeSortedLists_derived (arr1 : List Int) (arr2 : List Int) (h_precond : mergeSortedLists_precond arr1 arr2) : { ρ : List Int // mergeSortedLists_postcond arr1 arr2 ρ h_precond } :=
  ⟨((arr1 ++ arr2).mergeSort (fun a b => decide (a ≤ b))), by refine_auto⟩

def mergeSortedLists (arr1 : List Int) (arr2 : List Int) (h_precond : mergeSortedLists_precond arr1 arr2) : List Int := (mergeSortedLists_derived arr1 arr2 h_precond).val

theorem mergeSortedLists_spec_satisfied (arr1 : List Int) (arr2 : List Int) (h_precond : mergeSortedLists_precond arr1 arr2) :
    mergeSortedLists_postcond arr1 arr2 (mergeSortedLists arr1 arr2 h_precond) h_precond := (mergeSortedLists_derived arr1 arr2 h_precond).property

#print axioms mergeSortedLists_spec_satisfied


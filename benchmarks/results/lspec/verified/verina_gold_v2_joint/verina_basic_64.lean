def insert_derived (oline : Array Char) (l : Nat) (nl : Array Char) (p : Nat) (atPos : Nat) (h_precond : insert_precond oline l nl p atPos) : { ρ : Array Char // insert_postcond oline l nl p atPos ρ h_precond } :=
  (loop1 oline l nl p atPos h_precond (0) (#[]) (by refine_auto))

def insert (oline : Array Char) (l : Nat) (nl : Array Char) (p : Nat) (atPos : Nat) (h_precond : insert_precond oline l nl p atPos) : Array Char := (insert_derived oline l nl p atPos h_precond).val

theorem insert_spec_satisfied (oline : Array Char) (l : Nat) (nl : Array Char) (p : Nat) (atPos : Nat) (h_precond : insert_precond oline l nl p atPos) :
    insert_postcond oline l nl p atPos (insert oline l nl p atPos h_precond) h_precond := (insert_derived oline l nl p atPos h_precond).property

#print axioms insert_spec_satisfied


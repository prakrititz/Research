def loop1 (oline : Array Char) (l : Nat) (nl : Array Char) (p : Nat) (atPos : Nat) (h_precond : insert_precond oline l nl p atPos) (i : Nat) (acc : Array Char) (h1i : ((i ≤ (l + p)) ∧ ((acc.size = i) ∧ (∀ jj, (jj < i) → (acc[jj]! = (if jj < atPos then oline[jj]! else if jj < (atPos + p) then nl[jj - atPos]! else oline[jj - p]!)))))) : { ρ : Array Char // insert_postcond oline l nl p atPos ρ h_precond } :=
  if h1g : (i < (l + p)) then
    match (⟨((i + 1, acc.push (if i < atPos then oline[i]! else if i < (atPos + p) then nl[i - atPos]! else oline[i - p]!))), by refine_auto⟩ : { ρ : Nat × (Array Char) // (fun (i : Nat) (acc : Array Char) => (i ≤ (l + p)) ∧ ((acc.size = i) ∧ (∀ jj, (jj < i) → (acc[jj]! = (if jj < atPos then oline[jj]! else if jj < (atPos + p) then nl[jj - atPos]! else oline[jj - p]!))))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : Array Char) => (l + p) - i) (ρ).1 (ρ).2 < ((l + p) - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 oline l nl p atPos h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = ((l + p)) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by (l + p) - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)



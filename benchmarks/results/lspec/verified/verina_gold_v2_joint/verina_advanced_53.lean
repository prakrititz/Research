def loop3 (nums : List Int) (h_precond : minimumRightShifts_precond nums) (h1 : ¬ (nums.length ≤ 1)) (j : Nat) (h3i : ((j ≤ nums.length) ∧ (∀ k, (k < j) → (¬ (List.Pairwise (fun _c1 _c2 => _c1 ≤ _c2) (nums.rotateRight k)))))) : { ρ : Int // minimumRightShifts_postcond nums ρ h_precond } :=
  if h3g : ((j < nums.length) ∧ (¬ (List.Pairwise (fun _c1 _c2 => _c1 ≤ _c2) (nums.rotateRight j)))) then
    match (⟨(j + 1), by refine_auto⟩ : { ρ : Nat // (fun (j : Nat) => (j ≤ nums.length) ∧ (∀ k, (k < j) → (¬ (List.Pairwise (fun _c1 _c2 => _c1 ≤ _c2) (nums.rotateRight k))))) (ρ) ∧ (fun (j : Nat) => nums.length - j) (ρ) < (nums.length - j) }) with
    | ⟨j', h3b⟩ => loop3 nums h_precond h1 j' h3b.1
  else ⟨(if j < nums.length then (j : Int) else -1), by refine_auto⟩
termination_by nums.length - j
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h3b.2 | omega)


set_option maxHeartbeats 1000000 in
def minimumRightShifts_derived (nums : List Int) (h_precond : minimumRightShifts_precond nums) : { ρ : Int // minimumRightShifts_postcond nums ρ h_precond } :=
  (if h1 : (nums.length ≤ 1) then ⟨(0), by refine_auto⟩ else (loop3 nums h_precond h1 (0) (by refine_auto)))

def minimumRightShifts (nums : List Int) (h_precond : minimumRightShifts_precond nums) : Int := (minimumRightShifts_derived nums h_precond).val

theorem minimumRightShifts_spec_satisfied (nums : List Int) (h_precond : minimumRightShifts_precond nums) :
    minimumRightShifts_postcond nums (minimumRightShifts nums h_precond) h_precond := (minimumRightShifts_derived nums h_precond).property


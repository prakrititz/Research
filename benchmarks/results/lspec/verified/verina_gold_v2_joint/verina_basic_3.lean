def isDivisibleBy11_derived (n : Int) (h_precond : isDivisibleBy11_precond n) : { ρ : Bool // isDivisibleBy11_postcond n ρ h_precond } :=
  ⟨(decide ((n % 11) = 0)), by refine_auto⟩

def isDivisibleBy11 (n : Int) (h_precond : isDivisibleBy11_precond n) : Bool := (isDivisibleBy11_derived n h_precond).val

theorem isDivisibleBy11_spec_satisfied (n : Int) (h_precond : isDivisibleBy11_precond n) :
    isDivisibleBy11_postcond n (isDivisibleBy11 n h_precond) h_precond := (isDivisibleBy11_derived n h_precond).property

#print axioms isDivisibleBy11_spec_satisfied


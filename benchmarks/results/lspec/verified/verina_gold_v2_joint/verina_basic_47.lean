def loop1 (a : Array Int) (h_precond : arraySum_precond a) (i : Nat) (acc : Int) (h1i : ((i ≤ a.size) ∧ (acc = (sumTo a i)))) : { ρ : Int // arraySum_postcond a ρ h_precond } :=
  if h1g : (i < a.size) then
    match (⟨((i + 1, acc + a[i]!)), by refine_auto⟩ : { ρ : Nat × Int // (fun (i : Nat) (acc : Int) => (i ≤ a.size) ∧ (acc = (sumTo a i))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : Int) => a.size - i) (ρ).1 (ρ).2 < (a.size - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 a h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (a.size) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by a.size - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)



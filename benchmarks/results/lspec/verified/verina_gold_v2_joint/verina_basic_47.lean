def arraySum_derived (a : Array Int) (h_precond : arraySum_precond a) : { ρ : Int // arraySum_postcond a ρ h_precond } :=
  (loop1 a h_precond (0) (0) (by refine_auto))

def arraySum (a : Array Int) (h_precond : arraySum_precond a) : Int := (arraySum_derived a h_precond).val

theorem arraySum_spec_satisfied (a : Array Int) (h_precond : arraySum_precond a) :
    arraySum_postcond a (arraySum a h_precond) h_precond := (arraySum_derived a h_precond).property


def loop1 (a : Array Int) (h_precond : hasOnlyOneDistinctElement_precond a) (i : Nat) (ok : Bool) (h1i : ((i ≤ a.size) ∧ ((ok = true) ↔ (∀ k, (k < i) → (a[k]! = a[0]!))))) : { ρ : Bool // hasOnlyOneDistinctElement_postcond a ρ h_precond } :=
  if h1g : (i < a.size) then
    match (⟨((i + 1, ok && (decide (a[i]! = a[0]!)))), by refine_auto⟩ : { ρ : Nat × Bool // (fun (i : Nat) (ok : Bool) => (i ≤ a.size) ∧ ((ok = true) ↔ (∀ k, (k < i) → (a[k]! = a[0]!)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (ok : Bool) => a.size - i) (ρ).1 (ρ).2 < (a.size - i) }) with
    | ⟨(i', ok'), h1b⟩ => loop1 a h_precond i' ok' h1b.1
  else ⟨(ok), by first | (have hEq : i = (a.size) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by a.size - i
decreasing_by
  all_goals (try simp_wf)

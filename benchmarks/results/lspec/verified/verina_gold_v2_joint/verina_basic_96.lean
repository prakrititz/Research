def SwapSimultaneous_derived (X : Int) (Y : Int) (h_precond : SwapSimultaneous_precond X Y) : { ρ : Int × Int // SwapSimultaneous_postcond X Y ρ h_precond } :=
  ⟨((Y, X)), by refine_auto⟩

def SwapSimultaneous (X : Int) (Y : Int) (h_precond : SwapSimultaneous_precond X Y) : Int × Int := (SwapSimultaneous_derived X Y h_precond).val

theorem SwapSimultaneous_spec_satisfied (X : Int) (Y : Int) (h_precond : SwapSimultaneous_precond X Y) :
    SwapSimultaneous_postcond X Y (SwapSimultaneous X Y h_precond) h_precond := (SwapSimultaneous_derived X Y h_precond).property


def only_once_derived (a : Array Int) (key : Int) (h_precond : only_once_precond a key) : { ρ : Bool // only_once_postcond a key ρ h_precond } :=
  ⟨(decide ((count_occurrences a key) = 1)), by refine_auto⟩

def only_once (a : Array Int) (key : Int) (h_precond : only_once_precond a key) : Bool := (only_once_derived a key h_precond).val

theorem only_once_spec_satisfied (a : Array Int) (key : Int) (h_precond : only_once_precond a key) :
    only_once_postcond a key (only_once a key h_precond) h_precond := (only_once_derived a key h_precond).property

#print axioms only_once_spec_satisfied


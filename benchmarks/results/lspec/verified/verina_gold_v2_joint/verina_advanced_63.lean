set_option maxHeartbeats 1000000 in
def removeDuplicates_derived (nums : List Int) (h_precond : removeDuplicates_precond nums) : { ρ : Nat // removeDuplicates_postcond nums ρ h_precond } :=
  ⟨(nums.eraseDups.length), by refine_auto⟩

def removeDuplicates (nums : List Int) (h_precond : removeDuplicates_precond nums) : Nat := (removeDuplicates_derived nums h_precond).val

theorem removeDuplicates_spec_satisfied (nums : List Int) (h_precond : removeDuplicates_precond nums) :
    removeDuplicates_postcond nums (removeDuplicates nums h_precond) h_precond := (removeDuplicates_derived nums h_precond).property

#print axioms removeDuplicates_spec_satisfied


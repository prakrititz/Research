set_option maxHeartbeats 1000000 in
def TestArrayElements_derived (a : Array Int) (j : Nat) (h_precond : TestArrayElements_precond a j) : { ρ : Array Int // TestArrayElements_postcond a j ρ h_precond } :=
  ⟨(a.set! j 60), by refine_auto⟩

def TestArrayElements (a : Array Int) (j : Nat) (h_precond : TestArrayElements_precond a j) : Array Int := (TestArrayElements_derived a j h_precond).val

theorem TestArrayElements_spec_satisfied (a : Array Int) (j : Nat) (h_precond : TestArrayElements_precond a j) :
    TestArrayElements_postcond a j (TestArrayElements a j h_precond) h_precond := (TestArrayElements_derived a j h_precond).property

#print axioms TestArrayElements_spec_satisfied


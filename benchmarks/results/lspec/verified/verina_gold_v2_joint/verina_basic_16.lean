syntax "pre_wit_search" : tactic
macro_rules
  | `(tactic| pre_wit_search) => `(tactic| first
      | decide
      | (refine ⟨?_, ?_⟩ <;> pre_wit_search)
      | (refine ⟨0, ?_⟩; pre_wit_search) | (refine ⟨1, ?_⟩; pre_wit_search) | (refine ⟨2, ?_⟩; pre_wit_search)
      | (refine ⟨3, ?_⟩; pre_wit_search) | (refine ⟨4, ?_⟩; pre_wit_search) | (refine ⟨5, ?_⟩; pre_wit_search))
@[reducible, simp]
def replaceChars_precond (s : String) (oldChar : Char) (newChar : Char) : Prop :=
  True

@[reducible, simp]
def replaceChars_postcond (s : String) (oldChar : Char) (newChar : Char) (result: String) (h_precond : replaceChars_precond (s) (oldChar) (newChar)) :=
  let cs := s.toList
  let cs' := result.toList
  result.length = s.length ∧
  (∀ i, i < cs.length →
    (cs[i]! = oldChar → cs'[i]! = newChar) ∧
    (cs[i]! ≠ oldChar → cs'[i]! = cs[i]!))




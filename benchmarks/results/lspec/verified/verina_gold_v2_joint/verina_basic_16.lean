def loop1 (s : String) (oldChar : Char) (newChar : Char) (h_precond : replaceChars_precond s oldChar newChar) (i : Nat) (acc : List Char) (h1i : ((i ≤ s.length) ∧ (acc = ((List.range i).map (fun j => if s.toList[j]! = oldChar then newChar else s.toList[j]!))))) : { ρ : String // replaceChars_postcond s oldChar newChar ρ h_precond } :=
  if h1g : (i < s.length) then
    match (⟨((i + 1, acc ++ [if s.toList[i]! = oldChar then newChar else s.toList[i]!])), by refine_auto⟩ : { ρ : Nat × (List Char) // (fun (i : Nat) (acc : List Char) => (i ≤ s.length) ∧ (acc = ((List.range i).map (fun j => if s.toList[j]! = oldChar then newChar else s.toList[j]!)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : List Char) => s.length - i) (ρ).1 (ρ).2 < (s.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 s oldChar newChar h_precond i' acc' h1b.1
  else ⟨(String.mk acc), by first | (have hEq : i = (s.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by s.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def replaceChars_derived (s : String) (oldChar : Char) (newChar : Char) (h_precond : replaceChars_precond s oldChar newChar) : { ρ : String // replaceChars_postcond s oldChar newChar ρ h_precond } :=
  (loop1 s oldChar newChar h_precond (0) ([]) (by refine_auto))

def replaceChars (s : String) (oldChar : Char) (newChar : Char) (h_precond : replaceChars_precond s oldChar newChar) : String := (replaceChars_derived s oldChar newChar h_precond).val

theorem replaceChars_spec_satisfied (s : String) (oldChar : Char) (newChar : Char) (h_precond : replaceChars_precond s oldChar newChar) :
    replaceChars_postcond s oldChar newChar (replaceChars s oldChar newChar h_precond) h_precond := (replaceChars_derived s oldChar newChar h_precond).property

#print axioms replaceChars_spec_satisfied


set_option maxHeartbeats 1000000 in
def productExceptSelf_derived (nums : List Int) (h_precond : productExceptSelf_precond nums) : { ρ : List Int // productExceptSelf_postcond nums ρ h_precond } :=
  ⟨((List.range nums.length).map (fun i => (nums.take i).myprod * (nums.drop (i + 1)).myprod)), by refine_auto⟩

def productExceptSelf (nums : List Int) (h_precond : productExceptSelf_precond nums) : List Int := (productExceptSelf_derived nums h_precond).val

theorem productExceptSelf_spec_satisfied (nums : List Int) (h_precond : productExceptSelf_precond nums) :
    productExceptSelf_postcond nums (productExceptSelf nums h_precond) h_precond := (productExceptSelf_derived nums h_precond).property


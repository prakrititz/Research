def loop1 (a : Array Int) (P : Int -> Bool) (h_precond : LinearSearch3_precond a P) (n : Nat) (h1i : ((n ≤ a.size) ∧ (∀ k, (k < n) → (¬ (P a[k]!))))) : { ρ : Nat // LinearSearch3_postcond a P ρ h_precond } :=
  if h1g : ((n < a.size) ∧ (¬ (P a[n]!))) then
    match (⟨(n + 1), by refine_auto⟩ : { ρ : Nat // (fun (n : Nat) => (n ≤ a.size) ∧ (∀ k, (k < n) → (¬ (P a[k]!)))) (ρ) ∧ (fun (n : Nat) => a.size - n) (ρ) < (a.size - n) }) with
    | ⟨n', h1b⟩ => loop1 a P h_precond n' h1b.1
  else ⟨(n), by refine_auto⟩
termination_by a.size - n
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def LinearSearch3_derived (a : Array Int) (P : Int -> Bool) (h_precond : LinearSearch3_precond a P) : { ρ : Nat // LinearSearch3_postcond a P ρ h_precond } :=
  (loop1 a P h_precond (0) (by refine_auto))

def LinearSearch3 (a : Array Int) (P : Int -> Bool) (h_precond : LinearSearch3_precond a P) : Nat := (LinearSearch3_derived a P h_precond).val

theorem LinearSearch3_spec_satisfied (a : Array Int) (P : Int -> Bool) (h_precond : LinearSearch3_precond a P) :
    LinearSearch3_postcond a P (LinearSearch3 a P h_precond) h_precond := (LinearSearch3_derived a P h_precond).property

#print axioms LinearSearch3_spec_satisfied


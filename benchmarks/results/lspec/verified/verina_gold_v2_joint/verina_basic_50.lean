def Abs_derived (x : Int) (h_precond : Abs_precond x) : { ρ : Int // Abs_postcond x ρ h_precond } :=
  (if h1 : (x ≥ 0) then ⟨(x), by refine_auto⟩ else ⟨(-x), by refine_auto⟩)

def Abs (x : Int) (h_precond : Abs_precond x) : Int := (Abs_derived x h_precond).val

theorem Abs_spec_satisfied (x : Int) (h_precond : Abs_precond x) :
    Abs_postcond x (Abs x h_precond) h_precond := (Abs_derived x h_precond).property

#print axioms Abs_spec_satisfied


set_option maxHeartbeats 1000000 in
def partitionEvensOdds_derived (nums : List Nat) (h_precond : partitionEvensOdds_precond nums) : { ρ : (List Nat × List Nat) // partitionEvensOdds_postcond nums ρ h_precond } :=
  ⟨((nums.filter (fun n => (n % 2) == 0), nums.filter (fun n => (n % 2) == 1))), by refine_auto⟩

def partitionEvensOdds (nums : List Nat) (h_precond : partitionEvensOdds_precond nums) : (List Nat × List Nat) := (partitionEvensOdds_derived nums h_precond).val

theorem partitionEvensOdds_spec_satisfied (nums : List Nat) (h_precond : partitionEvensOdds_precond nums) :
    partitionEvensOdds_postcond nums (partitionEvensOdds nums h_precond) h_precond := (partitionEvensOdds_derived nums h_precond).property

#print axioms partitionEvensOdds_spec_satisfied


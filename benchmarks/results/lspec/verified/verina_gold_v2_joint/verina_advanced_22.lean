syntax "pre_wit_search" : tactic
macro_rules
  | `(tactic| pre_wit_search) => `(tactic| first
      | decide
      | (refine ⟨?_, ?_⟩ <;> pre_wit_search)
      | (refine ⟨0, ?_⟩; pre_wit_search) | (refine ⟨1, ?_⟩; pre_wit_search) | (refine ⟨2, ?_⟩; pre_wit_search)
      | (refine ⟨3, ?_⟩; pre_wit_search) | (refine ⟨4, ?_⟩; pre_wit_search) | (refine ⟨5, ?_⟩; pre_wit_search))
@[reducible, simp]
def isPeakValley_precond (lst : List Int) : Prop :=
  True

@[reducible, simp]
def isPeakValley_postcond (lst : List Int) (result: Bool) (h_precond : isPeakValley_precond (lst)) : Prop :=
  let len := lst.length
  let validPeaks :=
    List.range len |>.filter (fun p =>
      1 ≤ p ∧ p < len - 1 ∧

      -- check strictly increasing before peak
      (List.range p).all (fun i =>
        lst[i]! < lst[i + 1]!
      ) ∧

      -- check strictly decreasing after peak
      (List.range (len - 1 - p)).all (fun i =>
        lst[p + i]! > lst[p + i + 1]!
      )
    )
  (validPeaks != [] → result) ∧
  (validPeaks.length = 0 → ¬ result)




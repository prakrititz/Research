def loop1 (src : Array Int) (sStart : Nat) (dest : Array Int) (dStart : Nat) (len : Nat) (h_precond : copy_precond src sStart dest dStart len) (i : Nat) (r : Array Int) (h1i : ((i ≤ len) ∧ ((r.size = dest.size) ∧ ((∀ k, (k < dStart) → (r[k]! = dest[k]!)) ∧ ((∀ k, ((dStart + i) ≤ k) → ((k < r.size) → (r[k]! = dest[k]!))) ∧ (∀ k, (k < i) → (r[dStart + k]! = src[sStart + k]!))))))) : { ρ : Array Int // copy_postcond src sStart dest dStart len ρ h_precond } :=
  if h1g : (i < len) then
    match (⟨((i + 1, r.set! (dStart + i) src[sStart + i]!)), by refine_auto⟩ : { ρ : Nat × (Array Int) // (fun (i : Nat) (r : Array Int) => (i ≤ len) ∧ ((r.size = dest.size) ∧ ((∀ k, (k < dStart) → (r[k]! = dest[k]!)) ∧ ((∀ k, ((dStart + i) ≤ k) → ((k < r.size) → (r[k]! = dest[k]!))) ∧ (∀ k, (k < i) → (r[dStart + k]! = src[sStart + k]!)))))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (r : Array Int) => len - i) (ρ).1 (ρ).2 < (len - i) }) with
    | ⟨(i', r'), h1b⟩ => loop1 src sStart dest dStart len h_precond i' r' h1b.1
  else ⟨(r), by first | (have hEq : i = (len) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by len - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def copy_derived (src : Array Int) (sStart : Nat) (dest : Array Int) (dStart : Nat) (len : Nat) (h_precond : copy_precond src sStart dest dStart len) : { ρ : Array Int // copy_postcond src sStart dest dStart len ρ h_precond } :=
  (loop1 src sStart dest dStart len h_precond (0) (dest) (by refine_auto))

def copy (src : Array Int) (sStart : Nat) (dest : Array Int) (dStart : Nat) (len : Nat) (h_precond : copy_precond src sStart dest dStart len) : Array Int := (copy_derived src sStart dest dStart len h_precond).val

theorem copy_spec_satisfied (src : Array Int) (sStart : Nat) (dest : Array Int) (dStart : Nat) (len : Nat) (h_precond : copy_precond src sStart dest dStart len) :
    copy_postcond src sStart dest dStart len (copy src sStart dest dStart len h_precond) h_precond := (copy_derived src sStart dest dStart len h_precond).property


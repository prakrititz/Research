def loop1 (a : Array Int) (key : Int) (h_precond : BinarySearch_precond a key) (i : Nat) (h1i : ((i ≤ a.size) ∧ (∀ k, (k < i) → (a[k]! < key)))) : { ρ : Nat // BinarySearch_postcond a key ρ h_precond } :=
  if h1g : ((i < a.size) ∧ (a[i]! < key)) then
    match (⟨(i + 1), by refine_auto⟩ : { ρ : Nat // (fun (i : Nat) => (i ≤ a.size) ∧ (∀ k, (k < i) → (a[k]! < key))) (ρ) ∧ (fun (i : Nat) => a.size - i) (ρ) < (a.size - i) }) with
    | ⟨i', h1b⟩ => loop1 a key h_precond i' h1b.1
  else ⟨(i), by refine_auto⟩
termination_by a.size - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def BinarySearch_derived (a : Array Int) (key : Int) (h_precond : BinarySearch_precond a key) : { ρ : Nat // BinarySearch_postcond a key ρ h_precond } :=
  (loop1 a key h_precond (0) (by refine_auto))

def BinarySearch (a : Array Int) (key : Int) (h_precond : BinarySearch_precond a key) : Nat := (BinarySearch_derived a key h_precond).val

theorem BinarySearch_spec_satisfied (a : Array Int) (key : Int) (h_precond : BinarySearch_precond a key) :
    BinarySearch_postcond a key (BinarySearch a key h_precond) h_precond := (BinarySearch_derived a key h_precond).property


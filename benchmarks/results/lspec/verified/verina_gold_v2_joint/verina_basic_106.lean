def loop1 (a : Array Int) (b : Array Int) (h_precond : arraySum_precond a b) (i : Nat) (acc : Array Int) (h1i : ((i ≤ a.size) ∧ ((acc.size = i) ∧ (∀ k, (k < i) → ((a[k]! + b[k]!) = acc[k]!))))) : { ρ : Array Int // arraySum_postcond a b ρ h_precond } :=
  if h1g : (i < a.size) then
    match (⟨((i + 1, acc.push (a[i]! + b[i]!))), by refine_auto⟩ : { ρ : Nat × (Array Int) // (fun (i : Nat) (acc : Array Int) => (i ≤ a.size) ∧ ((acc.size = i) ∧ (∀ k, (k < i) → ((a[k]! + b[k]!) = acc[k]!)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : Array Int) => a.size - i) (ρ).1 (ρ).2 < (a.size - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 a b h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (a.size) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by a.size - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def arraySum_derived (a : Array Int) (b : Array Int) (h_precond : arraySum_precond a b) : { ρ : Array Int // arraySum_postcond a b ρ h_precond } :=
  (loop1 a b h_precond (0) (#[]) (by refine_auto))

def arraySum (a : Array Int) (b : Array Int) (h_precond : arraySum_precond a b) : Array Int := (arraySum_derived a b h_precond).val

theorem arraySum_spec_satisfied (a : Array Int) (b : Array Int) (h_precond : arraySum_precond a b) :
    arraySum_postcond a b (arraySum a b h_precond) h_precond := (arraySum_derived a b h_precond).property

#print axioms arraySum_spec_satisfied


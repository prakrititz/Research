syntax "pre_wit_search" : tactic
macro_rules
  | `(tactic| pre_wit_search) => `(tactic| first
      | decide
      | (refine ⟨?_, ?_⟩ <;> pre_wit_search)
      | (refine ⟨0, ?_⟩; pre_wit_search) | (refine ⟨1, ?_⟩; pre_wit_search) | (refine ⟨2, ?_⟩; pre_wit_search)
      | (refine ⟨3, ?_⟩; pre_wit_search) | (refine ⟨4, ?_⟩; pre_wit_search) | (refine ⟨5, ?_⟩; pre_wit_search))
@[reducible, simp]
def arraySum_precond (a : Array Int) (b : Array Int) : Prop :=
  a.size = b.size

@[reducible, simp]
def arraySum_postcond (a : Array Int) (b : Array Int) (result: Array Int) (h_precond : arraySum_precond (a) (b)) :=
  (result.size = a.size) ∧ (∀ i : Nat, i < a.size → a[i]! + b[i]! = result[i]!)




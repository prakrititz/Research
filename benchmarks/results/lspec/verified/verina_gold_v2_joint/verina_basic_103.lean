def UpdateElements_derived (a : Array Int) (h_precond : UpdateElements_precond a) : { ρ : Array Int // UpdateElements_postcond a ρ h_precond } :=
  ⟨((a.set! 4 (a[4]! + 3)).set! 7 516), by refine_auto⟩

def UpdateElements (a : Array Int) (h_precond : UpdateElements_precond a) : Array Int := (UpdateElements_derived a h_precond).val

theorem UpdateElements_spec_satisfied (a : Array Int) (h_precond : UpdateElements_precond a) :
    UpdateElements_postcond a (UpdateElements a h_precond) h_precond := (UpdateElements_derived a h_precond).property

#print axioms UpdateElements_spec_satisfied


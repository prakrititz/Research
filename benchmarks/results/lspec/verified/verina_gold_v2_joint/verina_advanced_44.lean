def maxSubarraySumDivisibleByK_derived (arr : Array Int) (k : Int) : { ρ : Int // maxSubarraySumDivisibleByK_postcond arr k ρ } :=
  (if h1 : (let subarrays := (List.range arr.size).flatMap (fun start => (List.range ((arr.size - start) + 1)).map (fun len => arr.extract start (start + len))); let divisibleSubarrays := subarrays.filter (fun subarray => ((subarray.size % k.toNat) = 0) && (subarray.size > 0)); let subarraySums := divisibleSubarrays.map (fun subarray => subarray.toList.sum); subarraySums.length = 0) then ⟨(0), by refine_auto⟩ else ⟨(let subarrays := (List.range arr.size).flatMap (fun start => (List.range ((arr.size - start) + 1)).map (fun len => arr.extract start (start + len))); let divisibleSubarrays := subarrays.filter (fun subarray => ((subarray.size % k.toNat) = 0) && (subarray.size > 0)); let subarraySums := divisibleSubarrays.map (fun subarray => subarray.toList.sum); subarraySums.foldl max (subarraySums.headD 0)), by refine_auto⟩)

def maxSubarraySumDivisibleByK (arr : Array Int) (k : Int) : Int := (maxSubarraySumDivisibleByK_derived arr k).val


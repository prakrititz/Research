def loop1 (s : String) (h_precond : allCharactersSame_precond s) (i : Nat) (ok : Bool) (h1i : ((i ≤ s.toList.length) ∧ ((ok = true) ↔ (∀ k, (k < i) → (s.toList[k]! = s.toList[0]!))))) : { ρ : Bool // allCharactersSame_postcond s ρ h_precond } :=
  if h1g : (i < s.toList.length) then
    match (⟨((i + 1, ok && (decide (s.toList[i]! = s.toList[0]!)))), by refine_auto⟩ : { ρ : Nat × Bool // (fun (i : Nat) (ok : Bool) => (i ≤ s.toList.length) ∧ ((ok = true) ↔ (∀ k, (k < i) → (s.toList[k]! = s.toList[0]!)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (ok : Bool) => s.toList.length - i) (ρ).1 (ρ).2 < (s.toList.length - i) }) with
    | ⟨(i', ok'), h1b⟩ => loop1 s h_precond i' ok' h1b.1
  else ⟨(ok), by first | (have hEq : i = (s.toList.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by s.toList.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)



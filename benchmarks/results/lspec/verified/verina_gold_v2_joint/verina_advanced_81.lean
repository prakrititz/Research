set_option maxHeartbeats 1000000 in
def uniqueSorted_derived (arr : List Int) (h_precond : uniqueSorted_precond arr) : { ρ : List Int // uniqueSorted_postcond arr ρ h_precond } :=
  ⟨(arr.eraseDups.mergeSort (fun a b => decide (a ≤ b))), by refine_auto⟩

def uniqueSorted (arr : List Int) (h_precond : uniqueSorted_precond arr) : List Int := (uniqueSorted_derived arr h_precond).val

theorem uniqueSorted_spec_satisfied (arr : List Int) (h_precond : uniqueSorted_precond arr) :
    uniqueSorted_postcond arr (uniqueSorted arr h_precond) h_precond := (uniqueSorted_derived arr h_precond).property

#print axioms uniqueSorted_spec_satisfied


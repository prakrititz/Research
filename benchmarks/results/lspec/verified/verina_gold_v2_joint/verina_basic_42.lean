set_option maxHeartbeats 1000000 in
def countDigits_derived (s : String) (h_precond : countDigits_precond s) : { ρ : Nat // countDigits_postcond s ρ h_precond } :=
  ⟨(List.length (List.filter isDigit s.toList)), by refine_auto⟩

def countDigits (s : String) (h_precond : countDigits_precond s) : Nat := (countDigits_derived s h_precond).val

theorem countDigits_spec_satisfied (s : String) (h_precond : countDigits_precond s) :
    countDigits_postcond s (countDigits s h_precond) h_precond := (countDigits_derived s h_precond).property

#print axioms countDigits_spec_satisfied


def loop3 (a : Array Int) (b : Array Int) (i : Nat) (best : Nat) (h_precond : CanyonSearch_precond a b) (h1i : ((i ≤ a.size) ∧ ((∃ ii, (ii < a.size) ∧ (∃ jj, (jj < b.size) ∧ (best = (a[ii]! - b[jj]!).natAbs))) ∧ (∀ k, (k < i) → (∀ j, (j < b.size) → (best ≤ (a[k]! - b[j]!).natAbs)))))) (h1g : (i < a.size)) (j : Nat) (row : Nat) (h3i : ((1 ≤ j) ∧ ((j ≤ b.size) ∧ ((∃ jj, (jj < j) ∧ (row = (a[i]! - b[jj]!).natAbs)) ∧ (∀ jj, (jj < j) → (row ≤ (a[i]! - b[jj]!).natAbs)))))) : { ρ : Nat // (fun (row : Nat) => (∃ jj, (jj < b.size) ∧ (row = (a[i]! - b[jj]!).natAbs)) ∧ (∀ jj, (jj < b.size) → (row ≤ (a[i]! - b[jj]!).natAbs))) ρ } :=
  if h3g : (j < b.size) then
    match (⟨((j + 1, min row (a[i]! - b[j]!).natAbs)), by refine_auto⟩ : { ρ : Nat × Nat // (fun (j : Nat) (row : Nat) => (1 ≤ j) ∧ ((j ≤ b.size) ∧ ((∃ jj, (jj < j) ∧ (row = (a[i]! - b[jj]!).natAbs)) ∧ (∀ jj, (jj < j) → (row ≤ (a[i]! - b[jj]!).natAbs))))) (ρ).1 (ρ).2 ∧ (fun (j : Nat) (row : Nat) => b.size - j) (ρ).1 (ρ).2 < (b.size - j) }) with
    | ⟨(j', row'), h3b⟩ => loop3 a b i best h_precond h1i h1g j' row' h3b.1
  else ⟨(row), by first | (have hEq : j = (b.size) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by b.size - j
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h3b.2 | omega)

def loop1 (a : Array Int) (b : Array Int) (h_precond : CanyonSearch_precond a b) (i : Nat) (best : Nat) (h1i : ((i ≤ a.size) ∧ ((∃ ii, (ii < a.size) ∧ (∃ jj, (jj < b.size) ∧ (best = (a[ii]! - b[jj]!).natAbs))) ∧ (∀ k, (k < i) → (∀ j, (j < b.size) → (best ≤ (a[k]! - b[j]!).natAbs)))))) : { ρ : Nat // CanyonSearch_postcond a b ρ h_precond } :=
  if h1g : (i < a.size) then
    match ((match ((loop3 a b i best h_precond h1i h1g (1) ((a[i]! - b[0]!).natAbs) (by refine_auto)) : { row : Nat // (∃ jj, (jj < b.size) ∧ (row = (a[i]! - b[jj]!).natAbs)) ∧ (∀ jj, (jj < b.size) → (row ≤ (a[i]! - b[jj]!).natAbs)) }) with | ⟨row, h2⟩ => ⟨((i + 1, min best row)), by refine_auto⟩) : { ρ : Nat × Nat // (fun (i : Nat) (best : Nat) => (i ≤ a.size) ∧ ((∃ ii, (ii < a.size) ∧ (∃ jj, (jj < b.size) ∧ (best = (a[ii]! - b[jj]!).natAbs))) ∧ (∀ k, (k < i) → (∀ j, (j < b.size) → (best ≤ (a[k]! - b[j]!).natAbs))))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (best : Nat) => a.size - i) (ρ).1 (ρ).2 < (a.size - i) }) with
    | ⟨(i', best'), h1b⟩ => loop1 a b h_precond i' best' h1b.1
  else ⟨(best), by first | (have hEq : i = (a.size) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by a.size - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def CanyonSearch_derived (a : Array Int) (b : Array Int) (h_precond : CanyonSearch_precond a b) : { ρ : Nat // CanyonSearch_postcond a b ρ h_precond } :=
  (loop1 a b h_precond (0) ((a[0]! - b[0]!).natAbs) (by refine_auto))

def CanyonSearch (a : Array Int) (b : Array Int) (h_precond : CanyonSearch_precond a b) : Nat := (CanyonSearch_derived a b h_precond).val

theorem CanyonSearch_spec_satisfied (a : Array Int) (b : Array Int) (h_precond : CanyonSearch_precond a b) :
    CanyonSearch_postcond a b (CanyonSearch a b h_precond) h_precond := (CanyonSearch_derived a b h_precond).property


def loop1 (a : Array Int) (e : Int) (h_precond : LinearSearch_precond a e) (n : Nat) (h1i : ((n ≤ a.size) ∧ (∀ i, (i < n) → (a[i]! ≠ e)))) : { ρ : Nat // LinearSearch_postcond a e ρ h_precond } :=
  if h1g : ((n < a.size) ∧ (a[n]! ≠ e)) then
    match (⟨(n + 1), by refine_auto⟩ : { ρ : Nat // (fun (n : Nat) => (n ≤ a.size) ∧ (∀ i, (i < n) → (a[i]! ≠ e))) (ρ) ∧ (fun (n : Nat) => a.size - n) (ρ) < (a.size - n) }) with
    | ⟨n', h1b⟩ => loop1 a e h_precond n' h1b.1
  else ⟨(n), by refine_auto⟩
termination_by a.size - n
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def LinearSearch_derived (a : Array Int) (e : Int) (h_precond : LinearSearch_precond a e) : { ρ : Nat // LinearSearch_postcond a e ρ h_precond } :=
  (loop1 a e h_precond (0) (by refine_auto))

def LinearSearch (a : Array Int) (e : Int) (h_precond : LinearSearch_precond a e) : Nat := (LinearSearch_derived a e h_precond).val

theorem LinearSearch_spec_satisfied (a : Array Int) (e : Int) (h_precond : LinearSearch_precond a e) :
    LinearSearch_postcond a e (LinearSearch a e h_precond) h_precond := (LinearSearch_derived a e h_precond).property

#print axioms LinearSearch_spec_satisfied


set_option maxHeartbeats 1000000 in
def allVowels_derived (s : String) (h_precond : allVowels_precond s) : { ρ : Bool // allVowels_postcond s ρ h_precond } :=
  ⟨(['a', 'e', 'i', 'o', 'u'].all (fun v => (normalize_str s).contains v)), by refine_auto⟩

def allVowels (s : String) (h_precond : allVowels_precond s) : Bool := (allVowels_derived s h_precond).val

theorem allVowels_spec_satisfied (s : String) (h_precond : allVowels_precond s) :
    allVowels_postcond s (allVowels s h_precond) h_precond := (allVowels_derived s h_precond).property

#print axioms allVowels_spec_satisfied


def loop1 (a : Array Int) (h_precond : cubeElements_precond a) (i : Nat) (acc : Array Int) (h1i : ((i ≤ a.size) ∧ ((acc.size = i) ∧ (∀ k, (k < i) → (acc[k]! = ((a[k]! * a[k]!) * a[k]!)))))) : { ρ : Array Int // cubeElements_postcond a ρ h_precond } :=
  if h1g : (i < a.size) then
    match (⟨((i + 1, acc.push ((a[i]! * a[i]!) * a[i]!))), by refine_auto⟩ : { ρ : Nat × (Array Int) // (fun (i : Nat) (acc : Array Int) => (i ≤ a.size) ∧ ((acc.size = i) ∧ (∀ k, (k < i) → (acc[k]! = ((a[k]! * a[k]!) * a[k]!))))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : Array Int) => a.size - i) (ρ).1 (ρ).2 < (a.size - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 a h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (a.size) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by a.size - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def cubeElements_derived (a : Array Int) (h_precond : cubeElements_precond a) : { ρ : Array Int // cubeElements_postcond a ρ h_precond } :=
  (loop1 a h_precond (0) (#[]) (by refine_auto))

def cubeElements (a : Array Int) (h_precond : cubeElements_precond a) : Array Int := (cubeElements_derived a h_precond).val

theorem cubeElements_spec_satisfied (a : Array Int) (h_precond : cubeElements_precond a) :
    cubeElements_postcond a (cubeElements a h_precond) h_precond := (cubeElements_derived a h_precond).property

#print axioms cubeElements_spec_satisfied


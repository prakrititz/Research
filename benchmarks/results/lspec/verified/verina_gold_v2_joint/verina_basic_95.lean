def swap_derived (arr : Array Int) (i : Int) (j : Int) (h_precond : swap_precond arr i j) : { ρ : Array Int // swap_postcond arr i j ρ h_precond } :=
  ⟨((arr.set! (Int.toNat i) arr[Int.toNat j]!).set! (Int.toNat j) arr[Int.toNat i]!), by refine_auto⟩

def swap (arr : Array Int) (i : Int) (j : Int) (h_precond : swap_precond arr i j) : Array Int := (swap_derived arr i j h_precond).val

theorem swap_spec_satisfied (arr : Array Int) (i : Int) (j : Int) (h_precond : swap_precond arr i j) :
    swap_postcond arr i j (swap arr i j h_precond) h_precond := (swap_derived arr i j h_precond).property

#print axioms swap_spec_satisfied


set_option maxHeartbeats 1000000 in
def isMultiplyPrime_derived (a : Nat) (h_precond : isMultiplyPrime_precond a) : { ρ : Bool // isMultiplyPrime_postcond a ρ h_precond } :=
  ⟨(decide (∃ p, (p < (a + 1)) ∧ (∃ q, (q < (a + 1)) ∧ (∃ r, (r < (a + 1)) ∧ ((((p * q) * r) = a) ∧ ((Nat.Prime p) ∧ ((Nat.Prime q) ∧ (Nat.Prime r)))))))), by refine_auto⟩

def isMultiplyPrime (a : Nat) (h_precond : isMultiplyPrime_precond a) : Bool := (isMultiplyPrime_derived a h_precond).val

theorem isMultiplyPrime_spec_satisfied (a : Nat) (h_precond : isMultiplyPrime_precond a) :
    isMultiplyPrime_postcond a (isMultiplyPrime a h_precond) h_precond := (isMultiplyPrime_derived a h_precond).property

#print axioms isMultiplyPrime_spec_satisfied


def getMaxTriples_derived (n : Nat) (h_precond : getMaxTriples_precond n) : { ρ : Nat // getMaxTriples_postcond n ρ h_precond } :=
  ⟨(((List.range n).map (fun i => ((List.range n).map (fun j => ((List.range n).filter (fun k => (i < j) ∧ ((j < k) ∧ (((((seqA (i + 1)) + (seqA (j + 1))) + (seqA (k + 1))) % 3) = 0)))).length)).sum)).sum), by refine_auto⟩

def getMaxTriples (n : Nat) (h_precond : getMaxTriples_precond n) : Nat := (getMaxTriples_derived n h_precond).val

theorem getMaxTriples_spec_satisfied (n : Nat) (h_precond : getMaxTriples_precond n) :
    getMaxTriples_postcond n (getMaxTriples n h_precond) h_precond := (getMaxTriples_derived n h_precond).property


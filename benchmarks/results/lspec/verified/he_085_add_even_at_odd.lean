def loop1 (lst : List Int) (h_precond : addEvenAtOdd_precond lst) (i : Nat) (s : Int) (h1i : ((i ≤ lst.length) ∧ (s = (((List.range i).filter (fun j => ((j % 2) = 1) ∧ ((lst[j]! % 2) = 0))).map (fun j => lst[j]!)).sum))) : { ρ : Int // addEvenAtOdd_postcond lst ρ h_precond } :=
  if h1g : (i < lst.length) then
    match (⟨((i + 1, if ((i % 2) = 1) ∧ ((lst[i]! % 2) = 0) then s + lst[i]! else s)), by refine_auto⟩ : { ρ : Nat × Int // (fun (i : Nat) (s : Int) => (i ≤ lst.length) ∧ (s = (((List.range i).filter (fun j => ((j % 2) = 1) ∧ ((lst[j]! % 2) = 0))).map (fun j => lst[j]!)).sum)) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (s : Int) => lst.length - i) (ρ).1 (ρ).2 < (lst.length - i) }) with
    | ⟨(i', s'), h1b⟩ => loop1 lst h_precond i' s' h1b.1
  else ⟨(s), by first | (have hEq : i = (lst.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by lst.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def addEvenAtOdd_derived (lst : List Int) (h_precond : addEvenAtOdd_precond lst) : { ρ : Int // addEvenAtOdd_postcond lst ρ h_precond } :=
  (loop1 lst h_precond (0) (0) (by refine_auto))

def addEvenAtOdd (lst : List Int) (h_precond : addEvenAtOdd_precond lst) : Int := (addEvenAtOdd_derived lst h_precond).val

theorem addEvenAtOdd_spec_satisfied (lst : List Int) (h_precond : addEvenAtOdd_precond lst) :
    addEvenAtOdd_postcond lst (addEvenAtOdd lst h_precond) h_precond := (addEvenAtOdd_derived lst h_precond).property


set_option maxHeartbeats 1000000 in
def wordsInSentence_derived (sentence : String) (h_precond : wordsInSentence_precond sentence) : { ρ : String // wordsInSentence_postcond sentence ρ h_precond } :=
  ⟨(" ".intercalate ((sentence.splitOn " ").filter (fun w => decide (Nat.Prime w.length)))), by refine_auto⟩

def wordsInSentence (sentence : String) (h_precond : wordsInSentence_precond sentence) : String := (wordsInSentence_derived sentence h_precond).val

theorem wordsInSentence_spec_satisfied (sentence : String) (h_precond : wordsInSentence_precond sentence) :
    wordsInSentence_postcond sentence (wordsInSentence sentence h_precond) h_precond := (wordsInSentence_derived sentence h_precond).property

#print axioms wordsInSentence_spec_satisfied


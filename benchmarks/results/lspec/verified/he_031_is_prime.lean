def loop3 (n : Nat) (h_precond : isPrime_precond n) (h1 : ¬ (n < 2)) (d : Nat) (ok : Bool) (h3i : ((2 ≤ d) ∧ ((d ≤ n) ∧ ((ok = true) ↔ (∀ k, (k < d) → ((k ≥ 2) → ((n % k) ≠ 0))))))) : { ρ : Bool // isPrime_postcond n ρ h_precond } :=
  if h3g : (d < n) then
    match (⟨((d + 1, ok && (decide ((n % d) ≠ 0)))), by refine_auto⟩ : { ρ : Nat × Bool // (fun (d : Nat) (ok : Bool) => (2 ≤ d) ∧ ((d ≤ n) ∧ ((ok = true) ↔ (∀ k, (k < d) → ((k ≥ 2) → ((n % k) ≠ 0)))))) (ρ).1 (ρ).2 ∧ (fun (d : Nat) (ok : Bool) => n - d) (ρ).1 (ρ).2 < (n - d) }) with
    | ⟨(d', ok'), h3b⟩ => loop3 n h_precond h1 d' ok' h3b.1
  else ⟨(ok), by first | (have hEq : d = (n) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by n - d
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h3b.2 | omega)


set_option maxHeartbeats 1000000 in
def isPrime_derived (n : Nat) (h_precond : isPrime_precond n) : { ρ : Bool // isPrime_postcond n ρ h_precond } :=
  (if h1 : (n < 2) then ⟨(false), by refine_auto⟩ else (loop3 n h_precond h1 (2) (true) (by refine_auto)))

def isPrime (n : Nat) (h_precond : isPrime_precond n) : Bool := (isPrime_derived n h_precond).val

theorem isPrime_spec_satisfied (n : Nat) (h_precond : isPrime_precond n) :
    isPrime_postcond n (isPrime n h_precond) h_precond := (isPrime_derived n h_precond).property

#print axioms isPrime_spec_satisfied


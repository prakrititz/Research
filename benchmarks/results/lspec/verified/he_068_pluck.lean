def pluck_derived (arr : List Nat) (h_precond : pluck_precond arr) : { ρ : List Nat // pluck_postcond arr ρ h_precond } :=
  (loop1 arr h_precond (0) (false) (0) (0) (by refine_auto))

def pluck (arr : List Nat) (h_precond : pluck_precond arr) : List Nat := (pluck_derived arr h_precond).val

theorem pluck_spec_satisfied (arr : List Nat) (h_precond : pluck_precond arr) :
    pluck_postcond arr (pluck arr h_precond) h_precond := (pluck_derived arr h_precond).property


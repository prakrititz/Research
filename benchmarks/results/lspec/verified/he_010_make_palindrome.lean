def loop1 (string : String) (h_precond : makePalindrome_precond string) (i : Nat) (h1i : ((i ≤ string.length) ∧ (∀ j, (j < i) → (¬ (isPal (string.toList.drop j)))))) : { ρ : String // makePalindrome_postcond string ρ h_precond } :=
  if h1g : ((i < string.length) ∧ (¬ (isPal (string.toList.drop i)))) then
    match (⟨(i + 1), by refine_auto⟩ : { ρ : Nat // (fun (i : Nat) => (i ≤ string.length) ∧ (∀ j, (j < i) → (¬ (isPal (string.toList.drop j))))) (ρ) ∧ (fun (i : Nat) => string.length - i) (ρ) < (string.length - i) }) with
    | ⟨i', h1b⟩ => loop1 string h_precond i' h1b.1
  else ⟨(String.mk (string.toList ++ (string.toList.take i).reverse)), by refine_auto⟩
termination_by string.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def makePalindrome_derived (string : String) (h_precond : makePalindrome_precond string) : { ρ : String // makePalindrome_postcond string ρ h_precond } :=
  (loop1 string h_precond (0) (by refine_auto))

def makePalindrome (string : String) (h_precond : makePalindrome_precond string) : String := (makePalindrome_derived string h_precond).val

theorem makePalindrome_spec_satisfied (string : String) (h_precond : makePalindrome_precond string) :
    makePalindrome_postcond string (makePalindrome string h_precond) h_precond := (makePalindrome_derived string h_precond).property


def longest_derived (strings : List String) (h_precond : longest_precond strings) : { ρ : Option String // longest_postcond strings ρ h_precond } :=
  (if h1 : (strings = []) then ⟨(none), by refine_auto⟩ else (match ((loop4 strings h_precond h1 (1) (0) (by refine_auto)) : { b : Nat // (b < strings.length) ∧ ((∀ j, (j < strings.length) → (strings[j]!.length ≤ strings[b]!.length)) ∧ (∀ j, (j < b) → (strings[j]!.length < strings[b]!.length))) }) with | ⟨b, h3⟩ => ⟨(some strings[b]!), by refine_auto⟩))

def longest (strings : List String) (h_precond : longest_precond strings) : Option String := (longest_derived strings h_precond).val

theorem longest_spec_satisfied (strings : List String) (h_precond : longest_precond strings) :
    longest_postcond strings (longest strings h_precond) h_precond := (longest_derived strings h_precond).property


def findMajorityElement_derived (lst : List Int) (h_precond : findMajorityElement_precond lst) : { ρ : Int // findMajorityElement_postcond lst ρ h_precond } :=
  ⟨((lst.find? (fun x => decide ((lst.filter (fun y => y = x)).length > (lst.length / 2)))).getD (-1)), by refine_auto⟩

def findMajorityElement (lst : List Int) (h_precond : findMajorityElement_precond lst) : Int := (findMajorityElement_derived lst h_precond).val

theorem findMajorityElement_spec_satisfied (lst : List Int) (h_precond : findMajorityElement_precond lst) :
    findMajorityElement_postcond lst (findMajorityElement lst h_precond) h_precond := (findMajorityElement_derived lst h_precond).property


def greatestCommonDivisor_derived (a : Nat) (b : Nat) (h_precond : greatestCommonDivisor_precond a b) : { ρ : Nat // greatestCommonDivisor_postcond a b ρ h_precond } :=
  ⟨(Nat.gcd a b), by refine_auto⟩

def greatestCommonDivisor (a : Nat) (b : Nat) (h_precond : greatestCommonDivisor_precond a b) : Nat := (greatestCommonDivisor_derived a b h_precond).val

theorem greatestCommonDivisor_spec_satisfied (a : Nat) (b : Nat) (h_precond : greatestCommonDivisor_precond a b) :
    greatestCommonDivisor_postcond a b (greatestCommonDivisor a b h_precond) h_precond := (greatestCommonDivisor_derived a b h_precond).property

#print axioms greatestCommonDivisor_spec_satisfied


def loop1 (numbers : List Int) (delimeter : Int) (h_precond : intersperse_precond numbers delimeter) (i : Nat) (acc : List Int) (h1i : ((i ≤ numbers.length) ∧ ((acc.length = (if i = 0 then 0 else (2 * i) - 1)) ∧ ((∀ k, (k < i) → (acc[2 * k]! = numbers[k]!)) ∧ (∀ k, ((k + 1) < i) → (acc[(2 * k) + 1]! = delimeter)))))) : { ρ : List Int // intersperse_postcond numbers delimeter ρ h_precond } :=
  if h1g : (i < numbers.length) then
    match (⟨((i + 1, if i = 0 then [numbers[0]!] else acc ++ [delimeter, numbers[i]!])), by refine_auto⟩ : { ρ : Nat × (List Int) // (fun (i : Nat) (acc : List Int) => (i ≤ numbers.length) ∧ ((acc.length = (if i = 0 then 0 else (2 * i) - 1)) ∧ ((∀ k, (k < i) → (acc[2 * k]! = numbers[k]!)) ∧ (∀ k, ((k + 1) < i) → (acc[(2 * k) + 1]! = delimeter))))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : List Int) => numbers.length - i) (ρ).1 (ρ).2 < (numbers.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 numbers delimeter h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (numbers.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by numbers.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def intersperse_derived (numbers : List Int) (delimeter : Int) (h_precond : intersperse_precond numbers delimeter) : { ρ : List Int // intersperse_postcond numbers delimeter ρ h_precond } :=
  (loop1 numbers delimeter h_precond (0) ([]) (by refine_auto))

def intersperse (numbers : List Int) (delimeter : Int) (h_precond : intersperse_precond numbers delimeter) : List Int := (intersperse_derived numbers delimeter h_precond).val

theorem intersperse_spec_satisfied (numbers : List Int) (delimeter : Int) (h_precond : intersperse_precond numbers delimeter) :
    intersperse_postcond numbers delimeter (intersperse numbers delimeter h_precond) h_precond := (intersperse_derived numbers delimeter h_precond).property

#print axioms intersperse_spec_satisfied


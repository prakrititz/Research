def loop1 (strings : List String) (h_precond : concatenate_precond strings) (i : Nat) (acc : String) (h1i : ((i ≤ strings.length) ∧ (acc = (String.join (strings.take i))))) : { ρ : String // concatenate_postcond strings ρ h_precond } :=
  if h1g : (i < strings.length) then
    match (⟨((i + 1, acc ++ strings[i]!)), by refine_auto⟩ : { ρ : Nat × String // (fun (i : Nat) (acc : String) => (i ≤ strings.length) ∧ (acc = (String.join (strings.take i)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : String) => strings.length - i) (ρ).1 (ρ).2 < (strings.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 strings h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (strings.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by strings.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def concatenate_derived (strings : List String) (h_precond : concatenate_precond strings) : { ρ : String // concatenate_postcond strings ρ h_precond } :=
  (loop1 strings h_precond (0) ("") (by refine_auto))

def concatenate (strings : List String) (h_precond : concatenate_precond strings) : String := (concatenate_derived strings h_precond).val

theorem concatenate_spec_satisfied (strings : List String) (h_precond : concatenate_precond strings) :
    concatenate_postcond strings (concatenate strings h_precond) h_precond := (concatenate_derived strings h_precond).property

#print axioms concatenate_spec_satisfied


def matchParens_derived (lst : List String) (h_precond : matchParens_precond lst) : { ρ : String // matchParens_postcond lst ρ h_precond } :=
  (if h1 : ((isBalanced (lst[0]!.toList ++ lst[1]!.toList)) ∨ (isBalanced (lst[1]!.toList ++ lst[0]!.toList))) then ⟨("Yes"), by refine_auto⟩ else ⟨("No"), by refine_auto⟩)

def matchParens (lst : List String) (h_precond : matchParens_precond lst) : String := (matchParens_derived lst h_precond).val

theorem matchParens_spec_satisfied (lst : List String) (h_precond : matchParens_precond lst) :
    matchParens_postcond lst (matchParens lst h_precond) h_precond := (matchParens_derived lst h_precond).property

#print axioms matchParens_spec_satisfied


set_option maxHeartbeats 1000000 in
def increasingTriplet_derived (nums : List Int) (h_precond : increasingTriplet_precond nums) : { ρ : Bool // increasingTriplet_postcond nums ρ h_precond } :=
  ⟨(let nums' := nums.zipIdx; nums'.any (fun (x, i) => nums'.any (fun (y, j) => nums'.any (fun (z, k) => decide ((i < j) ∧ ((j < k) ∧ ((x < y) ∧ (y < z)))))))), by refine_auto⟩

def increasingTriplet (nums : List Int) (h_precond : increasingTriplet_precond nums) : Bool := (increasingTriplet_derived nums h_precond).val

theorem increasingTriplet_spec_satisfied (nums : List Int) (h_precond : increasingTriplet_precond nums) :
    increasingTriplet_postcond nums (increasingTriplet nums h_precond) h_precond := (increasingTriplet_derived nums h_precond).property

#print axioms increasingTriplet_spec_satisfied


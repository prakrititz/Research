set_option maxHeartbeats 1000000 in
def letterCombinations_derived (digits : String) (h_precond : letterCombinations_precond digits) : { ρ : List String // letterCombinations_postcond digits ρ h_precond } :=
  ⟨(if digits.isEmpty then [] else if digits.toList.any (fun c => ¬ (c ∈ ['2', '3', '4', '5', '6', '7', '8', '9'])) then [] else (digits.toList.map digitToLetters).foldl (fun acc ls => acc.flatMap (fun s => ls.map (fun c => s ++ (String.singleton c)))) [""]), by refine_auto⟩

def letterCombinations (digits : String) (h_precond : letterCombinations_precond digits) : List String := (letterCombinations_derived digits h_precond).val

theorem letterCombinations_spec_satisfied (digits : String) (h_precond : letterCombinations_precond digits) :
    letterCombinations_postcond digits (letterCombinations digits h_precond) h_precond := (letterCombinations_derived digits h_precond).property


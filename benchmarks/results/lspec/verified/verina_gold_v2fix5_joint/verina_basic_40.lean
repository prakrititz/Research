    | ⟨(i', m'), h2b⟩ => loop2 s h_precond i' m' h2b.1
  else ⟨(m), by first | (have hEq : i = (s.size) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by s.size - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h2b.2 | omega)

def loop3 (s : Array Int) (m : Int) (h_precond : secondSmallest_precond s) (h1 : ((∃ idx, (idx < s.size) ∧ (s[idx]! = m)) ∧ (∀ k, (k < s.size) → (m ≤ s[k]!)))) (i : Nat) (r : Int) (found : Bool) (h3i : ((i ≤ s.size) ∧ (((found = true) → ((∃ idx, (idx < i) ∧ (s[idx]! = r)) ∧ ((m < r) ∧ (∀ k, (k < i) → ((m < s[k]!) → (r ≤ s[k]!)))))) ∧ ((found = false) → (∀ k, (k < i) → (s[k]! = m)))))) : { ρ : Int // secondSmallest_postcond s ρ h_precond } :=
  if h3g : (i < s.size) then
    match (⟨((i + 1, if (m < s[i]!) ∧ ((found = false) ∨ (s[i]! < r)) then s[i]! else r, if (m < s[i]!) ∧ ((found = false) ∨ (s[i]! < r)) then true else found)), by refine_auto⟩ : { ρ : Nat × Int × Bool // (fun (i : Nat) (r : Int) (found : Bool) => (i ≤ s.size) ∧ (((found = true) → ((∃ idx, (idx < i) ∧ (s[idx]! = r)) ∧ ((m < r) ∧ (∀ k, (k < i) → ((m < s[k]!) → (r ≤ s[k]!)))))) ∧ ((found = false) → (∀ k, (k < i) → (s[k]! = m))))) (ρ).1 (ρ).2.1 (ρ).2.2 ∧ (fun (i : Nat) (r : Int) (found : Bool) => s.size - i) (ρ).1 (ρ).2.1 (ρ).2.2 < (s.size - i) }) with
    | ⟨(i', r', found'), h3b⟩ => loop3 s m h_precond h1 i' r' found' h3b.1
  else ⟨(r), by first | (have hEq : i = (s.size) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by s.size - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h3b.2 | omega)


set_option maxHeartbeats 1000000 in
def secondSmallest_derived (s : Array Int) (h_precond : secondSmallest_precond s) : { ρ : Int // secondSmallest_postcond s ρ h_precond } :=
  (match ((loop2 s h_precond (1) (s[0]!) (by refine_auto)) : { m : Int // (∃ idx, (idx < s.size) ∧ (s[idx]! = m)) ∧ (∀ k, (k < s.size) → (m ≤ s[k]!)) }) with | ⟨m, h1⟩ => (loop3 s m h_precond h1 (0) (0) (false) (by refine_auto)))

def secondSmallest (s : Array Int) (h_precond : secondSmallest_precond s) : Int := (secondSmallest_derived s h_precond).val

theorem secondSmallest_spec_satisfied (s : Array Int) (h_precond : secondSmallest_precond s) :
    secondSmallest_postcond s (secondSmallest s h_precond) h_precond := (secondSmallest_derived s h_precond).property


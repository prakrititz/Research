def dissimilarElements_derived (a : Array Int) (b : Array Int) (h_precond : dissimilarElements_precond a b) : { ρ : Array Int // dissimilarElements_postcond a b ρ h_precond } :=
  ⟨((((a.toList.filter (fun x => !(inArray b x))) ++ (b.toList.filter (fun x => !(inArray a x)))).dedup.mergeSort (fun x y => decide (x ≤ y))).toArray), by refine_auto⟩

def dissimilarElements (a : Array Int) (b : Array Int) (h_precond : dissimilarElements_precond a b) : Array Int := (dissimilarElements_derived a b h_precond).val

theorem dissimilarElements_spec_satisfied (a : Array Int) (b : Array Int) (h_precond : dissimilarElements_precond a b) :
    dissimilarElements_postcond a b (dissimilarElements a b h_precond) h_precond := (dissimilarElements_derived a b h_precond).property

#print axioms dissimilarElements_spec_satisfied


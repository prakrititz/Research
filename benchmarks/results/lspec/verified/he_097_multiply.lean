def multiply_derived (a : Int) (b : Int) (h_precond : multiply_precond a b) : { ρ : Int // multiply_postcond a b ρ h_precond } :=
  ⟨((((a.natAbs % 10 : Nat) : Int)) * (((b.natAbs % 10 : Nat) : Int))), by refine_auto⟩

def multiply (a : Int) (b : Int) (h_precond : multiply_precond a b) : Int := (multiply_derived a b h_precond).val

theorem multiply_spec_satisfied (a : Int) (b : Int) (h_precond : multiply_precond a b) :
    multiply_postcond a b (multiply a b h_precond) h_precond := (multiply_derived a b h_precond).property

#print axioms multiply_spec_satisfied


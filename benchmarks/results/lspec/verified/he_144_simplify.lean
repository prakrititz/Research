set_option maxHeartbeats 1000000 in
def simplify_derived (x : String) (n : String) (h_precond : simplify_precond x n) : { ρ : Bool // simplify_postcond x n ρ h_precond } :=
  ⟨(decide ((((numOf x) * (numOf n)) % ((denOf x) * (denOf n))) = 0)), by refine_auto⟩

def simplify (x : String) (n : String) (h_precond : simplify_precond x n) : Bool := (simplify_derived x n h_precond).val

theorem simplify_spec_satisfied (x : String) (n : String) (h_precond : simplify_precond x n) :
    simplify_postcond x n (simplify x n h_precond) h_precond := (simplify_derived x n h_precond).property

#print axioms simplify_spec_satisfied


set_option maxHeartbeats 1000000 in
def checkDictCase_derived (keys : List PyVal) (h_precond : checkDictCase_precond keys) : { ρ : Bool // checkDictCase_postcond keys ρ h_precond } :=
  ⟨((decide (keys ≠ [])) && ((keys.all lowerKey) || (keys.all upperKey))), by refine_auto⟩

def checkDictCase (keys : List PyVal) (h_precond : checkDictCase_precond keys) : Bool := (checkDictCase_derived keys h_precond).val

theorem checkDictCase_spec_satisfied (keys : List PyVal) (h_precond : checkDictCase_precond keys) :
    checkDictCase_postcond keys (checkDictCase keys h_precond) h_precond := (checkDictCase_derived keys h_precond).property


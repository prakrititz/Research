def loop1 (lst : List (Int ⊕ ℚ)) (h_precond : doubleTheDifference_precond lst) (i : Nat) (acc : Int) (h1i : ((i ≤ lst.length) ∧ (acc = ((lst.take i).map (Sum.elim (fun (x : Int) => if (x > 0) ∧ ((x % 2) = 1) then x * x else 0) (fun (_ : Rat) => 0))).sum))) : { ρ : Int // doubleTheDifference_postcond lst ρ h_precond } :=
  if h1g : (i < lst.length) then
    match (⟨((i + 1, acc + (Sum.elim (fun (x : Int) => if (x > 0) ∧ ((x % 2) = 1) then x * x else 0) (fun (_ : Rat) => 0) lst[i]!))), by refine_auto⟩ : { ρ : Nat × Int // (fun (i : Nat) (acc : Int) => (i ≤ lst.length) ∧ (acc = ((lst.take i).map (Sum.elim (fun (x : Int) => if (x > 0) ∧ ((x % 2) = 1) then x * x else 0) (fun (_ : Rat) => 0))).sum)) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : Int) => lst.length - i) (ρ).1 (ρ).2 < (lst.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 lst h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = (lst.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by lst.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)



def doubleTheDifference_derived (lst : List (Int ⊕ ℚ)) (h_precond : doubleTheDifference_precond lst) : { ρ : Int // doubleTheDifference_postcond lst ρ h_precond } :=
  (loop1 lst h_precond (0) (0) (by refine_auto))

def doubleTheDifference (lst : List (Int ⊕ ℚ)) (h_precond : doubleTheDifference_precond lst) : Int := (doubleTheDifference_derived lst h_precond).val

theorem doubleTheDifference_spec_satisfied (lst : List (Int ⊕ ℚ)) (h_precond : doubleTheDifference_precond lst) :
    doubleTheDifference_postcond lst (doubleTheDifference lst h_precond) h_precond := (doubleTheDifference_derived lst h_precond).property


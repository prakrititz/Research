def nextSmallest_derived (lst : List Int) (h_precond : nextSmallest_precond lst) : { ρ : Option Int // nextSmallest_postcond lst ρ h_precond } :=
  (if h1 : (lst = []) then ⟨(none), by refine_auto⟩ else (match ((loop4 lst h_precond h1 (1) (lst[0]!) (by refine_auto)) : { m : Int // (∃ k, (k < lst.length) ∧ (lst[k]! = m)) ∧ (∀ k, (k < lst.length) → (m ≤ lst[k]!)) }) with | ⟨m, h3⟩ => (match ((loop7 lst m h_precond h1 h3 (0) (false) (0) (by refine_auto)) : { p : Bool × Int // ((p.1 = true) ↔ (∃ k, (k < lst.length) ∧ (m < lst[k]!))) ∧ ((p.1 = true) → ((∃ k, (k < lst.length) ∧ ((lst[k]! = p.2) ∧ (m < p.2))) ∧ (∀ k, (k < lst.length) → ((m < lst[k]!) → (p.2 ≤ lst[k]!))))) }) with | ⟨p, h5⟩ => (if h8 : (p.1 = true) then ⟨(some p.2), by refine_auto⟩ else ⟨(none), by refine_auto⟩))))

def nextSmallest (lst : List Int) (h_precond : nextSmallest_precond lst) : Option Int := (nextSmallest_derived lst h_precond).val

theorem nextSmallest_spec_satisfied (lst : List Int) (h_precond : nextSmallest_precond lst) :
    nextSmallest_postcond lst (nextSmallest lst h_precond) h_precond := (nextSmallest_derived lst h_precond).property

#print axioms nextSmallest_spec_satisfied


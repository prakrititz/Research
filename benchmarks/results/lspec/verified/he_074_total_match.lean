set_option maxHeartbeats 1000000 in
def totalMatch_derived (lst1 : List String) (lst2 : List String) (h_precond : totalMatch_precond lst1 lst2) : { ρ : List String // totalMatch_postcond lst1 lst2 ρ h_precond } :=
  (if h1 : ((lst1.map String.length).sum ≤ (lst2.map String.length).sum) then ⟨(lst1), by refine_auto⟩ else ⟨(lst2), by refine_auto⟩)

def totalMatch (lst1 : List String) (lst2 : List String) (h_precond : totalMatch_precond lst1 lst2) : List String := (totalMatch_derived lst1 lst2 h_precond).val

theorem totalMatch_spec_satisfied (lst1 : List String) (lst2 : List String) (h_precond : totalMatch_precond lst1 lst2) :
    totalMatch_postcond lst1 lst2 (totalMatch lst1 lst2 h_precond) h_precond := (totalMatch_derived lst1 lst2 h_precond).property

#print axioms totalMatch_spec_satisfied


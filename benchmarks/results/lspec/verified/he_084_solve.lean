set_option maxHeartbeats 1000000 in
def solve84_derived (N : Nat) (h_precond : solve84_precond N) : { ρ : String // solve84_postcond N ρ h_precond } :=
  ⟨(String.mk (Nat.toDigits 2 ((toString N).toList.map (fun c => c.toNat - '0'.toNat)).sum)), by refine_auto⟩

def solve84 (N : Nat) (h_precond : solve84_precond N) : String := (solve84_derived N h_precond).val

theorem solve84_spec_satisfied (N : Nat) (h_precond : solve84_precond N) :
    solve84_postcond N (solve84 N h_precond) h_precond := (solve84_derived N h_precond).property

#print axioms solve84_spec_satisfied


def loop3 (l : List Int) (j : Nat) (found : Bool) (h_precond : pairsSumToZero_precond l) (h1i : ((j ≤ l.length) ∧ ((found = true) ↔ (∃ b, (b < j) ∧ (∃ a, (a < b) ∧ ((l[a]! + l[b]!) = 0)))))) (h1g : (j < l.length)) (i : Nat) (seen : Bool) (h3i : ((i ≤ j) ∧ ((seen = true) ↔ (∃ a, (a < i) ∧ ((l[a]! + l[j]!) = 0))))) : { ρ : Bool // (fun (hit : Bool) => (hit = true) ↔ (∃ a, (a < j) ∧ ((l[a]! + l[j]!) = 0))) ρ } :=
  if h3g : (i < j) then
    match (⟨((i + 1, seen || (decide ((l[i]! + l[j]!) = 0)))), by refine_auto⟩ : { ρ : Nat × Bool // (fun (i : Nat) (seen : Bool) => (i ≤ j) ∧ ((seen = true) ↔ (∃ a, (a < i) ∧ ((l[a]! + l[j]!) = 0)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (seen : Bool) => j - i) (ρ).1 (ρ).2 < (j - i) }) with
    | ⟨(i', seen'), h3b⟩ => loop3 l j found h_precond h1i h1g i' seen' h3b.1
  else ⟨(seen), by first | (have hEq : i = (j) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by j - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h3b.2 | omega)

def loop1 (l : List Int) (h_precond : pairsSumToZero_precond l) (j : Nat) (found : Bool) (h1i : ((j ≤ l.length) ∧ ((found = true) ↔ (∃ b, (b < j) ∧ (∃ a, (a < b) ∧ ((l[a]! + l[b]!) = 0)))))) : { ρ : Bool // pairsSumToZero_postcond l ρ h_precond } :=
  if h1g : (j < l.length) then
    match ((match ((loop3 l j found h_precond h1i h1g (0) (false) (by refine_auto)) : { hit : Bool // (hit = true) ↔ (∃ a, (a < j) ∧ ((l[a]! + l[j]!) = 0)) }) with | ⟨hit, h2⟩ => ⟨((j + 1, found || hit)), by refine_auto⟩) : { ρ : Nat × Bool // (fun (j : Nat) (found : Bool) => (j ≤ l.length) ∧ ((found = true) ↔ (∃ b, (b < j) ∧ (∃ a, (a < b) ∧ ((l[a]! + l[b]!) = 0))))) (ρ).1 (ρ).2 ∧ (fun (j : Nat) (found : Bool) => l.length - j) (ρ).1 (ρ).2 < (l.length - j) }) with
    | ⟨(j', found'), h1b⟩ => loop1 l h_precond j' found' h1b.1
  else ⟨(found), by first | (have hEq : j = (l.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by l.length - j
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def pairsSumToZero_derived (l : List Int) (h_precond : pairsSumToZero_precond l) : { ρ : Bool // pairsSumToZero_postcond l ρ h_precond } :=
  (loop1 l h_precond (0) (false) (by refine_auto))

def pairsSumToZero (l : List Int) (h_precond : pairsSumToZero_precond l) : Bool := (pairsSumToZero_derived l h_precond).val

theorem pairsSumToZero_spec_satisfied (l : List Int) (h_precond : pairsSumToZero_precond l) :
    pairsSumToZero_postcond l (pairsSumToZero l h_precond) h_precond := (pairsSumToZero_derived l h_precond).property


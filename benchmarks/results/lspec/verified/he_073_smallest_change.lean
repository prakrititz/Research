def loop1 (arr : List Int) (h_precond : smallestChange_precond arr) (i : Nat) (acc : Nat) (h1i : ((i ≤ (arr.length / 2)) ∧ (acc = ((List.range i).filter (fun k => arr[k]! ≠ arr[(arr.length - 1) - k]!)).length))) : { ρ : Nat // smallestChange_postcond arr ρ h_precond } :=
  if h1g : (i < (arr.length / 2)) then
    match (⟨((i + 1, if arr[i]! ≠ arr[(arr.length - 1) - i]! then acc + 1 else acc)), by refine_auto⟩ : { ρ : Nat × Nat // (fun (i : Nat) (acc : Nat) => (i ≤ (arr.length / 2)) ∧ (acc = ((List.range i).filter (fun k => arr[k]! ≠ arr[(arr.length - 1) - k]!)).length)) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : Nat) => (arr.length / 2) - i) (ρ).1 (ρ).2 < ((arr.length / 2) - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 arr h_precond i' acc' h1b.1
  else ⟨(acc), by first | (have hEq : i = ((arr.length / 2)) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by (arr.length / 2) - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def smallestChange_derived (arr : List Int) (h_precond : smallestChange_precond arr) : { ρ : Nat // smallestChange_postcond arr ρ h_precond } :=
  (loop1 arr h_precond (0) (0) (by refine_auto))

def smallestChange (arr : List Int) (h_precond : smallestChange_precond arr) : Nat := (smallestChange_derived arr h_precond).val

theorem smallestChange_spec_satisfied (arr : List Int) (h_precond : smallestChange_precond arr) :
    smallestChange_postcond arr (smallestChange arr h_precond) h_precond := (smallestChange_derived arr h_precond).property

#print axioms smallestChange_spec_satisfied


def loop2 (s0 : String) (s1 : String) (h_precond : sameChars_precond s0 s1) (i : Nat) (ok : Bool) (h2i : ((i ≤ s0.length) ∧ ((ok = true) ↔ (∀ k, (k < i) → (s0.toList[k]! ∈ s1.toList))))) : { ρ : Bool // (fun (a : Bool) => (a = true) ↔ (∀ c ∈ s0.toList, c ∈ s1.toList)) ρ } :=
  if h2g : (i < s0.length) then
    match (⟨((i + 1, ok && (decide (s0.toList[i]! ∈ s1.toList)))), by refine_auto⟩ : { ρ : Nat × Bool // (fun (i : Nat) (ok : Bool) => (i ≤ s0.length) ∧ ((ok = true) ↔ (∀ k, (k < i) → (s0.toList[k]! ∈ s1.toList)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (ok : Bool) => s0.length - i) (ρ).1 (ρ).2 < (s0.length - i) }) with
    | ⟨(i', ok'), h2b⟩ => loop2 s0 s1 h_precond i' ok' h2b.1
  else ⟨(ok), by first | (have hEq : i = (s0.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by s0.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h2b.2 | omega)

def loop5 (s0 : String) (s1 : String) (a : Bool) (h_precond : sameChars_precond s0 s1) (h1 : ((a = true) ↔ (∀ c ∈ s0.toList, c ∈ s1.toList))) (i : Nat) (ok : Bool) (h5i : ((i ≤ s1.length) ∧ ((ok = true) ↔ (∀ k, (k < i) → (s1.toList[k]! ∈ s0.toList))))) : { ρ : Bool // (fun (b : Bool) => (b = true) ↔ (∀ c ∈ s1.toList, c ∈ s0.toList)) ρ } :=
  if h5g : (i < s1.length) then
    match (⟨((i + 1, ok && (decide (s1.toList[i]! ∈ s0.toList)))), by refine_auto⟩ : { ρ : Nat × Bool // (fun (i : Nat) (ok : Bool) => (i ≤ s1.length) ∧ ((ok = true) ↔ (∀ k, (k < i) → (s1.toList[k]! ∈ s0.toList)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (ok : Bool) => s1.length - i) (ρ).1 (ρ).2 < (s1.length - i) }) with
    | ⟨(i', ok'), h5b⟩ => loop5 s0 s1 a h_precond h1 i' ok' h5b.1
  else ⟨(ok), by first | (have hEq : i = (s1.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by s1.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h5b.2 | omega)


set_option maxHeartbeats 1000000 in
def sameChars_derived (s0 : String) (s1 : String) (h_precond : sameChars_precond s0 s1) : { ρ : Bool // sameChars_postcond s0 s1 ρ h_precond } :=
  (match ((loop2 s0 s1 h_precond (0) (true) (by refine_auto)) : { a : Bool // (a = true) ↔ (∀ c ∈ s0.toList, c ∈ s1.toList) }) with | ⟨a, h1⟩ => (match ((loop5 s0 s1 a h_precond h1 (0) (true) (by refine_auto)) : { b : Bool // (b = true) ↔ (∀ c ∈ s1.toList, c ∈ s0.toList) }) with | ⟨b, h3⟩ => ⟨(a && b), by refine_auto⟩))

def sameChars (s0 : String) (s1 : String) (h_precond : sameChars_precond s0 s1) : Bool := (sameChars_derived s0 s1 h_precond).val

theorem sameChars_spec_satisfied (s0 : String) (s1 : String) (h_precond : sameChars_precond s0 s1) :
    sameChars_postcond s0 s1 (sameChars s0 s1 h_precond) h_precond := (sameChars_derived s0 s1 h_precond).property


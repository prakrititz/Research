def loop1 (s : String) (h_precond : encrypt_precond s) (i : Nat) (acc : List Char) (h1i : ((i ≤ s.length) ∧ (acc = ((List.range i).map (fun k => rot4 s.toList[k]!))))) : { ρ : String // encrypt_postcond s ρ h_precond } :=
  if h1g : (i < s.length) then
    match (⟨((i + 1, acc ++ [rot4 s.toList[i]!])), by refine_auto⟩ : { ρ : Nat × (List Char) // (fun (i : Nat) (acc : List Char) => (i ≤ s.length) ∧ (acc = ((List.range i).map (fun k => rot4 s.toList[k]!)))) (ρ).1 (ρ).2 ∧ (fun (i : Nat) (acc : List Char) => s.length - i) (ρ).1 (ρ).2 < (s.length - i) }) with
    | ⟨(i', acc'), h1b⟩ => loop1 s h_precond i' acc' h1b.1
  else ⟨(String.mk acc), by first | (have hEq : i = (s.length) := (by omega); subst hEq; refine_auto) | (refine_auto)⟩
termination_by s.length - i
decreasing_by
  all_goals (try simp_wf)
  all_goals (first | exact h1b.2 | omega)


set_option maxHeartbeats 1000000 in
def encrypt_derived (s : String) (h_precond : encrypt_precond s) : { ρ : String // encrypt_postcond s ρ h_precond } :=
  (loop1 s h_precond (0) ([]) (by refine_auto))

def encrypt (s : String) (h_precond : encrypt_precond s) : String := (encrypt_derived s h_precond).val

theorem encrypt_spec_satisfied (s : String) (h_precond : encrypt_precond s) :
    encrypt_postcond s (encrypt s h_precond) h_precond := (encrypt_derived s h_precond).property

#print axioms encrypt_spec_satisfied


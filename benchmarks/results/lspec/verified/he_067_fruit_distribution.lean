set_option maxHeartbeats 1000000 in
def fruitDistribution_derived (s : String) (n : Nat) (h_precond : fruitDistribution_precond s n) : { ρ : Nat // fruitDistribution_postcond s n ρ h_precond } :=
  ⟨((n - (s.splitOn " ")[0]!.toNat!) - (s.splitOn " ")[3]!.toNat!), by refine_auto⟩

def fruitDistribution (s : String) (n : Nat) (h_precond : fruitDistribution_precond s n) : Nat := (fruitDistribution_derived s n h_precond).val

theorem fruitDistribution_spec_satisfied (s : String) (n : Nat) (h_precond : fruitDistribution_precond s n) :
    fruitDistribution_postcond s n (fruitDistribution s n h_precond) h_precond := (fruitDistribution_derived s n h_precond).property

#print axioms fruitDistribution_spec_satisfied


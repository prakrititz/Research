set_option maxHeartbeats 1000000 in
def intToMiniRoman_derived (number : Nat) (h_precond : intToMiniRoman_precond number) : { ρ : String // intToMiniRoman_postcond number ρ h_precond } :=
  ⟨(romanSpec number number), by refine_auto⟩

def intToMiniRoman (number : Nat) (h_precond : intToMiniRoman_precond number) : String := (intToMiniRoman_derived number h_precond).val

theorem intToMiniRoman_spec_satisfied (number : Nat) (h_precond : intToMiniRoman_precond number) :
    intToMiniRoman_postcond number (intToMiniRoman number h_precond) h_precond := (intToMiniRoman_derived number h_precond).property

#print axioms intToMiniRoman_spec_satisfied


{
    "id": "he_117_select_words",
    "signature": {
        "name": "selectWords",
        "parameters": [
            {
                "param_name": "s",
                "param_type": "String"
            },
            {
                "param_name": "n",
                "param_type": "Nat"
            }
        ],
        "return_type": "List String"
    },
    "description_file": "./description.txt",
    "lean_file": "./task.lean",
    "specification": {
        "preconditions": "True",
        "postconditions": "result = (s.splitOn \" \").filter (fun w => w != \"\" && (w.toList.filter (fun ch => !(['a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'].contains ch))).length == n)"
    },

        ],
        "return_type": "Nat"
    },
    "description_file": "./description.txt",
    "lean_file": "./task.lean",
    "specification": {
        "preconditions": "capacity ≥ 1",
        "postconditions": "result = (grid.map (fun row => (row.sum + capacity - 1) / capacity)).sum"
    },
